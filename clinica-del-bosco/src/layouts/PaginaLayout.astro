---
/**
 * Layout per pagine interne standard: intestazione con briciole, etichetta, H1 e sottotitolo.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Briciole from '@ui/Briciole.astro';
import Etichetta from '@ui/Etichetta.astro';
import type { Props as PropsSeo } from '@/components/seo/Seo.astro';
import type { Briciola } from '@lib/seo';
import type { JsonLd } from '@lib/schema';

interface Props extends PropsSeo {
  h1: string;
  sottotitolo?: string;
  etichetta?: string;
  briciole: Briciola[];
  jsonLd?: JsonLd[];
  tonoIntestazione?: 'base' | 'tinta' | 'inverso';
}
const {
  h1,
  sottotitolo,
  etichetta,
  briciole,
  jsonLd = [],
  tonoIntestazione = 'tinta',
  ...seo
} = Astro.props;
const inverso = tonoIntestazione === 'inverso';
---

<BaseLayout {...seo} jsonLd={jsonLd}>
  <header
    class:list={[
      'relative overflow-hidden py-12 md:py-20',
      tonoIntestazione === 'tinta' && 'trama-bosco bg-sfondo-tinta',
      inverso && 'zona-scura grana bg-sfondo',
    ]}
  >
    <svg
      class="pointer-events-none absolute -right-16 -top-10 hidden h-[130%] w-auto opacity-[0.07] md:block"
      viewBox="0 0 200 240"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
      aria-hidden="true"
    >
      <path d="M100 236V40" />
      {[0, 1, 2, 3, 4, 5, 6].map((k) => (
        <>
          <path d={`M100 ${60 + k * 26}c-26-4-52-20-66-46`} />
          <path d={`M100 ${60 + k * 26}c26-4 52-20 66-46`} />
        </>
      ))}
    </svg>
    <div class="contenitore relative">
      <Briciole briciole={briciole} class="entra mb-5" />
      {etichetta && (
        <Etichetta tono={inverso ? 'inverso' : 'primario'} class="mb-2">
          {etichetta}
        </Etichetta>
      )}
      <h1 class="entra max-w-4xl text-4xl tracking-tight md:text-6xl" style="--i:1">
        {h1}
      </h1>
      {sottotitolo && (
        <p
          style="--i:2"
          class:list={[
            'entra prosa mt-5 text-lg md:text-xl',
            inverso ? 'text-testo/85' : 'text-testo-secondario',
          ]}
        >
          {sottotitolo}
        </p>
      )}
      <slot name="intestazione" />
    </div>
  </header>
  <slot />
</BaseLayout>
