---
/**
 * Layout unico per tutte le pagine servizio, guidato dai dati della collection `servizi`.
 * Nessuna duplicazione di markup: la pagina [slug].astro passa solo l'entry.
 */
import type { CollectionEntry } from 'astro:content';
import { getEntries, getEntry, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Briciole from '@ui/Briciole.astro';
import Bottone from '@ui/Bottone.astro';
import CardServizio from '@ui/CardServizio.astro';
import CtaDoppia from '@ui/CtaDoppia.astro';
import Etichetta from '@ui/Etichetta.astro';
import Fonti from '@ui/Fonti.astro';
import Foto from '@ui/Foto.astro';
import Icona, { type NomeIcona } from '@ui/Icona.astro';
import Referenti from '@ui/Referenti.astro';
import SchedaAutore from '@ui/SchedaAutore.astro';
import Sezione from '@ui/Sezione.astro';
import { clinica, telHref } from '@lib/clinica';
import { medicalWebPage, servizioMedico } from '@lib/schema';

interface Props {
  servizio: CollectionEntry<'servizi'>;
}
const { servizio } = Astro.props;
const { Content } = await render(servizio);
const autore = await getEntry(servizio.data.autore);
if (!autore) throw new Error(`Autore ${servizio.data.autore.id} non trovato per ${servizio.id}`);

const referenti = (await getEntries(servizio.data.referenti)).filter(Boolean);

const correlati = (
  await getEntries(servizio.data.correlati.map((id) => ({ collection: 'servizi' as const, id })))
).filter(Boolean);

const url = `/servizi/${servizio.id}`;
const briciole = [
  { nome: 'Servizi', href: '/servizi' },
  { nome: servizio.data.titoloBreve, href: url },
];
const categorie: Record<string, string> = {
  urgenza: 'Degenza e pronto soccorso',
  diagnostica: 'Diagnostica',
  chirurgia: 'Chirurgia',
  specialistica: 'Medicina specialistica',
  prevenzione: 'Prevenzione',
  esotici: 'Animali esotici',
};
const specieEtichetta: Record<string, string> = {
  cane: 'Cani',
  gatto: 'Gatti',
  coniglio: 'Conigli',
  esotici: 'Esotici',
};
const iso = (d: Date) => d.toISOString().slice(0, 10);
const tipoSchema =
  servizio.data.categoria === 'diagnostica'
    ? servizio.id.includes('tc-') || servizio.id.includes('immagini')
      ? 'ImagingTest'
      : 'MedicalTest'
    : 'MedicalProcedure';
---

<BaseLayout
  titolo={servizio.data.titolo}
  descrizione={servizio.data.descrizioneMeta}
  percorso={url}
  dataPubblicazione={iso(servizio.data.dataPubblicazione)}
  dataModifica={iso(servizio.data.dataRevisione)}
  jsonLd={[
    medicalWebPage({
      url,
      titolo: servizio.data.titolo,
      descrizione: servizio.data.descrizioneMeta,
      briciole,
      specialita: servizio.data.medicalSpecialty,
      dataPubblicazione: iso(servizio.data.dataPubblicazione),
      dataModifica: iso(servizio.data.dataRevisione),
      autore: { nome: `${autore.data.titolo} ${autore.data.nome}`, url: `/equipe/${autore.id}` },
    }),
    servizioMedico({
      url,
      nome: servizio.data.titoloBreve,
      descrizione: servizio.data.risposta,
      tipo: tipoSchema,
      specialita: servizio.data.medicalSpecialty,
    }),
  ]}
>
  <header class="trama-bosco relative overflow-hidden bg-sfondo-tinta">
    <div class="contenitore grid gap-10 py-12 md:py-16 lg:grid-cols-12 lg:items-center lg:py-20">
      <div class="lg:col-span-6 xl:col-span-7">
        <Briciole briciole={briciole} class="entra mb-6" />
        <div class="entra mb-4 flex items-center gap-3" style="--i:1">
          <span class="badge-icona size-12 rounded-2xl">
            <Icona nome={servizio.data.icona as NomeIcona} duo class="size-7" />
          </span>
          <Etichetta>{categorie[servizio.data.categoria]}</Etichetta>
        </div>
        <h1 class="entra text-4xl tracking-tight md:text-6xl" style="--i:2">
          {servizio.data.titolo}
        </h1>
        <p class="entra prosa mt-5 text-lg text-testo-secondario md:text-xl" style="--i:3">
          {servizio.data.sottotitolo}
        </p>
        <ul class="entra mt-5 flex flex-wrap gap-2" style="--i:4" aria-label="Specie trattate">
          {servizio.data.specie.map((s) => (
            <li class="rounded-pill border border-bordo bg-sfondo-rialzato px-3.5 py-1 text-sm font-semibold">
              {specieEtichetta[s]}
            </li>
          ))}
        </ul>
        <div class="entra mt-8 flex flex-col gap-3 sm:flex-row" style="--i:5">
          <Bottone
            href={`/prenota?motivo=${servizio.id}`}
            variante="primario"
            dimensione="lg"
            icona="calendario"
          >
            Prenota una visita
          </Bottone>
          <Bottone
            href={telHref}
            variante="secondario"
            dimensione="lg"
            icona="telefono"
            evento="click_chiama"
            eventoPosizione="servizio-header"
          >
            Chiama · {clinica.contatti.telefono.visualizzato}
          </Bottone>
        </div>
      </div>
      <div class="relative lg:col-span-6 xl:col-span-5">
        <div
          class="absolute -bottom-4 -right-4 hidden size-full rounded-[2rem] border-2 border-oro/60 md:block"
          aria-hidden="true"
        ></div>
        <div class="hero-foto relative">
          <Foto
            ratio="4/5"
            scattoBrief={servizio.data.scattoBrief}
            descrizioneSegnaposto={`${servizio.data.titoloBreve}: fotografia del servizio`}
            larghezze={[480, 720, 960, 1200]}
            sizes="(min-width: 1024px) 40vw, 92vw"
            priorita
            class="rounded-[2rem] ombra-morbida"
          />
        </div>
      </div>
    </div>
  </header>

  <Sezione>
    <div class="grid gap-10 lg:grid-cols-12">
      <article class="lg:col-span-8">
        <div class="relative overflow-hidden rounded-[1.6rem] border border-bordo bg-sfondo-rialzato p-6 ombra-morbida md:p-8">
          <span
            class="absolute inset-y-0 left-0 w-1.5 bg-gradient-to-b from-primario to-oro"
            aria-hidden="true"
          ></span>
          <p class="font-display text-lg leading-relaxed md:text-xl">{servizio.data.risposta}</p>
        </div>
        <Referenti medici={referenti} class="mt-8" />
        <div class="prosa-md mt-8">
          <Content />
        </div>
        <SchedaAutore
          autore={autore}
          dataPubblicazione={servizio.data.dataPubblicazione}
          dataRevisione={servizio.data.dataRevisione}
          class="mt-10"
        />
        <Fonti fonti={servizio.data.fonti} class="mt-6" />
        <p class="mt-8 text-sm text-testo-secondario">
          Questa pagina ha finalità informative e non sostituisce la visita veterinaria.
        </p>
      </article>

      <aside class="space-y-6 lg:col-span-4">
        <div class="zona-scura grana overflow-hidden rounded-[1.6rem] bg-sfondo p-6 lg:sticky lg:top-32">
          <span class="badge-icona mb-4 size-12 rounded-2xl">
            <Icona nome="stetoscopio" duo class="size-7" />
          </span>
          <h2 class="font-display text-2xl">Sei un collega veterinario?</h2>
          <p class="mt-2 text-sm text-testo-secondario">
            TC, endoscopia, chirurgia e degenza in service. Il paziente torna sempre a te.
          </p>
          <a
            href="/per-i-colleghi"
            class="mt-3 inline-flex items-center gap-1 font-semibold text-primario-link"
          >
            Area colleghi <Icona nome="freccia-destra" class="size-4" />
          </a>
        </div>
      </aside>
    </div>
  </Sezione>

  {correlati.length > 0 && (
    <Sezione tono="tinta" class="trama-bosco">
      <h2 class="filetto text-3xl tracking-tight md:text-4xl">Servizi collegati</h2>
      <ul class="mt-10 grid gap-x-5 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
        {correlati.map((c, i) => (
          <li class="rivela" style={`--i:${i}`}>
            <CardServizio servizio={c} />
          </li>
        ))}
      </ul>
    </Sezione>
  )}

  <Sezione compatta>
    <CtaDoppia motivo={servizio.id} posizione="servizio-fondo" />
  </Sezione>
</BaseLayout>
