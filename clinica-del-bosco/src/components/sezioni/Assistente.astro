---
/**
 * Assistente del sito: accompagna nelle diverse aree, risponde con i contenuti
 * che la clinica ha già pubblicato e tiene sempre in vista il numero delle
 * urgenze, ricordando di usarlo per le vere emergenze.
 *
 * Due scelte da conoscere prima di metterci mano:
 *
 * 1. Cerca SOLO dentro /assistente.json, generato a build time da FAQ, servizi
 *    e pagine principali. Non interroga modelli linguistici e non chiama servizi
 *    esterni: su un sito sanitario una risposta inventata è un rischio, e la CSP
 *    del sito non consente comunque richieste fuori dal dominio.
 * 2. Non fa triage e non dà consigli clinici. Davanti a una domanda di salute
 *    non valuta la gravità: mostra il numero e invita a parlare con un medico.
 *
 * Senza JavaScript il pulsante resta un normale link alle domande frequenti.
 */
import Icona from '@ui/Icona.astro';
import { clinica, telHref } from '@lib/clinica';

const scorciatoie = [
  { testo: 'Ho un’urgenza', domanda: 'urgenza' },
  { testo: 'Prenotare una visita', domanda: 'prenotare una visita' },
  { testo: 'Dove siete e orari', domanda: 'dove siete orari' },
  { testo: 'Quanto costa', domanda: 'costi e preventivo' },
  { testo: 'Piani Salute', domanda: 'piani salute' },
  { testo: 'Conigli ed esotici', domanda: 'coniglio esotici' },
  { testo: 'Sono un veterinario', domanda: 'colleghi invio caso' },
];
---

<div class="assistente" data-assistente>
  <a
    href="/domande-frequenti"
    class="assistente-avvio"
    data-assistente-avvio
    aria-expanded="false"
    aria-controls="pannello-assistente"
  >
    <Icona nome="chat" class="size-5 shrink-0" />
    <span class="assistente-avvio-testo">Assistente</span>
  </a>

  <div
    id="pannello-assistente"
    class="assistente-pannello"
    role="dialog"
    aria-modal="true"
    aria-labelledby="assistente-titolo"
    hidden
    data-assistente-pannello
  >
    <div class="assistente-testa">
      <div>
        <p id="assistente-titolo" class="assistente-nome">
          Assistente del Bosco
        </p>
        <p class="assistente-sottotitolo">Ti accompagno tra le pagine del sito</p>
      </div>
      <button type="button" class="assistente-chiudi" data-assistente-chiudi>
        <Icona nome="chiudi" class="size-5" etichetta="Chiudi l’assistente" />
      </button>
    </div>

    <a
      href={telHref}
      class="assistente-urgenza"
      data-evento="click_chiama"
      data-evento-posizione="assistente"
    >
      <Icona nome="ambulanza" class="size-6 shrink-0" />
      <span>
        <strong>È un’emergenza? Chiama {clinica.contatti.telefono.visualizzato}</strong>
        <span class="assistente-urgenza-nota">
          Risponde un medico, 24 ore su 24. Usa questo numero solo per le vere urgenze: lasciarlo
          libero aiuta chi ne ha bisogno adesso.
        </span>
      </span>
    </a>

    <div class="assistente-corpo" data-assistente-corpo>
      <div class="assistente-campo">
        <Icona nome="cerca" class="assistente-lente size-4 shrink-0" />
        <label class="sr-only" for="assistente-domanda">
          Che cosa stai cercando?
        </label>
        <input
          id="assistente-domanda"
          type="search"
          class="assistente-input"
          placeholder="Scrivi qui: orari, TAC, coniglio…"
          autocomplete="off"
          data-assistente-input
        />
      </div>

      <div class="assistente-scorciatoie" data-assistente-scorciatoie>
        {scorciatoie.map((s) => (
          <button type="button" class="assistente-chip" data-domanda={s.domanda}>
            {s.testo}
          </button>
        ))}
      </div>

      <div class="assistente-risposte" aria-live="polite" data-assistente-risposte></div>
    </div>

    <p class="assistente-piede">
      Cerco tra le pagine e le domande frequenti del sito: non do consigli medici e non posso
      valutare le condizioni del tuo animale. Per quello serve un medico — in visita o al telefono.
    </p>
  </div>
</div>

<style>
  .assistente {
    position: fixed;
    right: var(--spacing-gutter);
    bottom: calc(var(--spacing-sticky) + 0.75rem);
    z-index: 45;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }
  @media (min-width: 1024px) {
    .assistente {
      bottom: 1.5rem;
    }
  }
  @media print {
    .assistente {
      display: none;
    }
  }

  .assistente-avvio {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding: 0 1.1rem;
    border-radius: var(--radius-pill);
    background: var(--istituzionale);
    color: var(--istituzionale-testo);
    font-weight: 650;
    font-size: var(--text-sm);
    text-decoration: none;
    box-shadow: var(--shadow-rialzo);
    transition: background 0.2s var(--ease-morbido);
  }
  .assistente-avvio:hover {
    background: var(--istituzionale-forte);
  }
  /* Su schermi stretti resta il solo simbolo: la barra sticky ha già tre voci. */
  @media (max-width: 400px) {
    .assistente-avvio-testo {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .assistente-avvio {
      padding: 0;
      width: 3rem;
      justify-content: center;
    }
  }

  .assistente-pannello {
    display: flex;
    flex-direction: column;
    width: min(23rem, calc(100vw - 2 * var(--spacing-gutter)));
    max-height: min(32rem, calc(100dvh - var(--spacing-sticky) - 5rem));
    overflow: hidden;
    border: 1px solid var(--bordo);
    border-radius: var(--radius-card);
    background: var(--sfondo-rialzato);
    box-shadow: var(--shadow-rialzo);
  }
  .assistente-testa {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1rem 0.75rem;
    border-bottom: 1px solid var(--bordo);
  }
  .assistente-nome {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 650;
    color: var(--testo);
  }
  .assistente-sottotitolo {
    font-size: var(--text-xs);
    color: var(--testo-secondario);
  }
  .assistente-chiudi {
    display: grid;
    place-items: center;
    min-height: 2.75rem;
    min-width: 2.75rem;
    margin: -0.5rem -0.35rem 0 0;
    border-radius: 0.75rem;
    color: var(--testo-secondario);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .assistente-chiudi:hover {
    color: var(--testo);
    background: var(--sfondo-tinta);
  }

  .assistente-urgenza {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    padding: 0.85rem 1rem;
    background: var(--urgenza-tenue);
    color: var(--urgenza-testo-su-chiaro);
    text-decoration: none;
    border-bottom: 1px solid var(--bordo);
    font-size: var(--text-sm);
    line-height: 1.45;
  }
  .assistente-urgenza:hover {
    background: var(--urgenza);
    color: var(--urgenza-testo);
  }
  .assistente-urgenza strong {
    display: block;
  }
  .assistente-urgenza-nota {
    display: block;
    margin-top: 0.2rem;
    font-size: var(--text-xs);
  }

  .assistente-corpo {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
  }
  .assistente-campo {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0 0.85rem;
    border: 2px solid var(--bordo-forte);
    border-radius: var(--radius-pill);
    background: var(--sfondo);
  }
  .assistente-campo:focus-within {
    border-color: var(--primario);
  }
  .assistente-lente {
    color: var(--testo-secondario);
  }
  .assistente-input {
    flex: 1;
    min-height: 2.75rem;
    border: 0;
    background: none;
    color: var(--testo);
    font: inherit;
    font-size: var(--text-sm);
  }
  .assistente-input:focus {
    outline: none;
  }
  .assistente-input::-webkit-search-cancel-button {
    appearance: none;
  }

  .assistente-scorciatoie[hidden] {
    display: none;
  }
  .assistente-scorciatoie {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.85rem;
  }
  .assistente-chip {
    min-height: 2.25rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--bordo);
    border-radius: var(--radius-pill);
    background: var(--sfondo);
    color: var(--primario-link);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
  }
  .assistente-chip:hover {
    background: var(--primario-tenue);
    border-color: var(--primario);
  }

  .assistente-risposte:not(:empty) {
    margin-top: 1rem;
    display: grid;
    gap: 0.5rem;
  }
  :global(.assistente-vuoto) {
    font-size: var(--text-sm);
    color: var(--testo-secondario);
  }
  :global(.assistente-risposta) {
    display: block;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--bordo);
    border-radius: 0.9rem;
    background: var(--sfondo);
    text-decoration: none;
    color: var(--testo);
  }
  :global(.assistente-risposta):hover {
    border-color: var(--primario);
    background: var(--primario-tenue);
  }
  :global(.assistente-etichetta) {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--testo-secondario);
  }
  :global(.assistente-titolo-risposta) {
    display: block;
    margin-top: 0.15rem;
    font-weight: 650;
    font-size: var(--text-sm);
  }
  :global(.assistente-estratto) {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--text-xs);
    color: var(--testo-secondario);
    line-height: 1.5;
  }

  .assistente-piede {
    padding: 0.7rem 1rem 0.85rem;
    border-top: 1px solid var(--bordo);
    background: var(--sfondo-tinta);
    font-size: var(--text-xs);
    color: var(--testo-secondario);
    line-height: 1.5;
  }
</style>

<script>
  import { traccia } from '@lib/analytics';

  interface Voce {
    t: string;
    u: string;
    e: string;
    k: string[];
    c: string;
  }

  /** Minuscolo, senza accenti: "però" e "pero" devono pesare uguale. */
  const normalizza = (s: string) =>
    s
      .toLowerCase()
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .replace(/[^a-z0-9\s]/g, ' ');

  const PAROLE_VUOTE = new Set([
    'il',
    'lo',
    'la',
    'i',
    'gli',
    'le',
    'un',
    'uno',
    'una',
    'di',
    'a',
    'da',
    'in',
    'con',
    'su',
    'per',
    'tra',
    'fra',
    'e',
    'o',
    'che',
    'chi',
    'come',
    'cosa',
    'quando',
    'dove',
    'quanto',
    'quale',
    'mi',
    'si',
    'ci',
    'non',
    'del',
    'della',
    'dei',
    'delle',
    'al',
    'allo',
    'alla',
    'ai',
    'agli',
    'alle',
    'dal',
    'nel',
    'nella',
    'sul',
    'il',
    'mio',
    'mia',
    'miei',
    'sono',
    'ho',
    'ha',
    'essere',
    'avere',
    'vorrei',
    'posso',
    'potete',
    'fare',
  ]);

  const parole = (s: string) =>
    normalizza(s)
      .split(/\s+/)
      .filter((p) => p.length > 2 && !PAROLE_VUOTE.has(p));

  /**
   * Parole che fanno pensare a una situazione urgente. Non servono a valutare la
   * gravità — non è compito nostro — ma solo a mettere il numero in cima.
   */
  const SEGNALI_URGENZA = [
    'urgenza',
    'urgente',
    'emergenza',
    'subito',
    'adesso',
    'muore',
    'morendo',
    'sangue',
    'sanguina',
    'respira',
    'respiro',
    'soffoca',
    'convulsioni',
    'crisi',
    'avvelenato',
    'veleno',
    'incidente',
    'investito',
    'trauma',
    'caduto',
    'non si muove',
    'svenuto',
    'collasso',
    'parto',
    'dolore',
    'grave',
  ];

  function inizializza() {
    const radice = document.querySelector<HTMLElement>('[data-assistente]');
    if (!radice || radice.dataset['pronto'] === 'si') return;
    radice.dataset['pronto'] = 'si';

    const avvio = radice.querySelector<HTMLAnchorElement>('[data-assistente-avvio]');
    const pannello = radice.querySelector<HTMLElement>('[data-assistente-pannello]');
    const chiudi = radice.querySelector<HTMLButtonElement>('[data-assistente-chiudi]');
    const input = radice.querySelector<HTMLInputElement>('[data-assistente-input]');
    const risposte = radice.querySelector<HTMLElement>('[data-assistente-risposte]');
    const chips = radice.querySelectorAll<HTMLButtonElement>('[data-domanda]');
    if (!avvio || !pannello || !chiudi || !input || !risposte) return;

    let voci: Voce[] | null = null;
    let caricamento: Promise<void> | null = null;
    let ultimoFocus: HTMLElement | null = null;

    const carica = () => {
      if (caricamento) return caricamento;
      caricamento = fetch('/assistente.json')
        .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
        .then((d: { voci: Voce[] }) => {
          voci = d.voci;
        })
        .catch(() => {
          voci = null;
        });
      return caricamento;
    };

    const scorciatoie = radice.querySelector<HTMLElement>('[data-assistente-scorciatoie]');

    /** Con una risposta a schermo le scorciatoie si tolgono di mezzo. */
    const scrivi = (html: string) => {
      risposte.innerHTML = html;
      if (scorciatoie) scorciatoie.hidden = html !== '';
    };

    const esc = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    const cerca = (domanda: string) => {
      const termini = parole(domanda);
      if (!termini.length) {
        scrivi('');
        return;
      }
      if (!voci) {
        scrivi(
          '<p class="assistente-vuoto">Non riesco a leggere le pagine del sito in questo momento. Puoi aprire le <a href="/domande-frequenti">domande frequenti</a> o chiamarci.</p>',
        );
        return;
      }

      const testoNormalizzato = normalizza(domanda);
      const sembraUrgente = SEGNALI_URGENZA.some((s) => testoNormalizzato.includes(normalizza(s)));

      const punteggiate = voci
        .map((v) => {
          const titolo = normalizza(v.t);
          const chiavi = normalizza(v.k.join(' '));
          const corpo = normalizza(v.e);
          let punti = 0;
          for (const termine of termini) {
            if (titolo.includes(termine)) punti += 6;
            if (chiavi.includes(termine)) punti += 4;
            if (corpo.includes(termine)) punti += 1;
          }
          return { v, punti };
        })
        .filter((x) => x.punti > 0)
        .sort((a, b) => b.punti - a.punti)
        .slice(0, 4);

      const pezzi: string[] = [];
      if (sembraUrgente) {
        pezzi.push(
          '<p class="assistente-vuoto">Se hai un dubbio sulle condizioni del tuo animale non aspettare e non cercare qui: <strong>chiama, risponde un medico a qualsiasi ora</strong>. Al pronto soccorso si arriva anche senza appuntamento.</p>',
        );
      }
      if (!punteggiate.length) {
        pezzi.push(
          '<p class="assistente-vuoto">Su questo non trovo una pagina. Prova con parole più semplici (“orari”, “TAC”, “coniglio”), apri le <a href="/domande-frequenti">domande frequenti</a> oppure chiamaci: al telefono rispondiamo sempre.</p>',
        );
      }
      for (const { v } of punteggiate) {
        pezzi.push(
          `<a class="assistente-risposta" href="${esc(v.u)}">` +
            `<span class="assistente-etichetta">${esc(v.c)}</span>` +
            `<span class="assistente-titolo-risposta">${esc(v.t)}</span>` +
            (v.e ? `<span class="assistente-estratto">${esc(v.e)}</span>` : '') +
            '</a>',
        );
      }
      scrivi(pezzi.join(''));
      traccia('assistente_domanda', { esiti: punteggiate.length });
    };

    const apri = () => {
      ultimoFocus = document.activeElement as HTMLElement;
      pannello.hidden = false;
      avvio.setAttribute('aria-expanded', 'true');
      void carica();
      input.focus();
      traccia('assistente_aperto');
    };

    const chiudiPannello = () => {
      pannello.hidden = true;
      avvio.setAttribute('aria-expanded', 'false');
      (ultimoFocus ?? avvio).focus();
    };

    avvio.addEventListener('click', (e) => {
      e.preventDefault();
      if (pannello.hidden) apri();
      else chiudiPannello();
    });
    chiudi.addEventListener('click', chiudiPannello);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !pannello.hidden) chiudiPannello();
    });
    document.addEventListener('click', (e) => {
      if (pannello.hidden) return;
      const bersaglio = e.target as Node;
      if (!radice.contains(bersaglio)) chiudiPannello();
    });

    let attesa: number | undefined;
    input.addEventListener('input', () => {
      window.clearTimeout(attesa);
      attesa = window.setTimeout(() => void carica().then(() => cerca(input.value)), 220);
    });

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const domanda = chip.dataset['domanda'] ?? chip.textContent ?? '';
        input.value = domanda;
        void carica().then(() => cerca(domanda));
      });
    }
  }

  inizializza();
  document.addEventListener('astro:page-load', inizializza);
</script>
