---
/** Barra di fiducia sotto l'hero: quattro fatti verificabili, nessun superlativo. */
import Icona, { type NomeIcona } from '@ui/Icona.astro';
import { clinica, daConfermare } from '@lib/clinica';
const voci: Array<{ icona: NomeIcona; testo: string }> = [
  { icona: 'coniglio', testo: 'Cani, gatti e animali esotici' },
  { icona: 'scansione', testo: 'TC ed endoscopia in sede' },
  { icona: 'bisturi', testo: 'Due sale chirurgiche e terapia intensiva' },
  { icona: 'provetta', testo: 'Laboratorio analisi interno' },
];
if (!daConfermare(clinica.annoFondazione))
  voci.push({ icona: 'foglia', testo: `A Portici dal ${clinica.annoFondazione}` });
---

<div class="relative z-10 -mt-px md:-mt-12">
  <div class="contenitore">
    <ul
      class="vetro-chiaro grid grid-cols-1 gap-x-6 gap-y-3 rounded-b-[1.75rem] px-5 py-5 text-sm font-semibold sm:grid-cols-2 md:rounded-[1.75rem] md:px-8 lg:flex lg:flex-wrap lg:justify-between"
      aria-label="In sintesi"
    >
      {voci.map((v) => (
        <li class="flex items-center gap-3">
          <span class="badge-icona size-10 shrink-0 rounded-xl">
            <Icona nome={v.icona} duo class="size-5" />
          </span>
          <span>{v.testo}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
