---
/**
 * Meta tag di pagina: title, description, canonical, Open Graph, Twitter Card, robots.
 * Ogni pagina passa titolo e descrizione scritti a mano (mai generati automaticamente).
 */
import { clinica, urlAssoluto } from '@lib/clinica';
import { descrizioneMeta, titoloCompleto } from '@lib/seo';

export interface Props {
  titolo: string;
  descrizione: string;
  /** Percorso della pagina, es. "/pronto-soccorso". Usato per canonical e og:url. */
  percorso: string;
  immagine?: string;
  immagineAlt?: string;
  tipo?: 'website' | 'article';
  noindex?: boolean;
  senzaBrand?: boolean;
  dataPubblicazione?: string;
  dataModifica?: string;
}
const {
  titolo,
  descrizione,
  percorso,
  immagine: immaginePassata,
  immagineAlt = `${clinica.nome} — ${clinica.slogan}`,
  tipo = 'website',
  noindex = false,
  senzaBrand = false,
  dataPubblicazione,
  dataModifica,
} = Astro.props;

/** Immagini di condivisione generate per pagina in src/pages/og/[...slug].png.ts. */
const pagineConScheda = new Set([
  'pronto-soccorso',
  'prenota',
  'per-i-colleghi',
  'la-struttura',
  'equipe',
  'servizi',
  'magazine',
  'contatti',
  'domande-frequenti',
]);
const slugPagina = percorso.replace(/^\/|\/$/g, '');
const haScheda =
  pagineConScheda.has(slugPagina) || /^(servizi|magazine|campagne)\/[^/]+$/.test(slugPagina);
const immagine = immaginePassata ?? (haScheda ? `/og/${slugPagina}.png` : '/og/default.png');

// Sul progetto di anteprima (ANTEPRIMA=1) nessuna pagina va indicizzata: il sito vero sarà sul dominio definitivo.
const anteprima = process.env.ANTEPRIMA === '1';
const titoloFinale = titoloCompleto(titolo, !senzaBrand);
const descrizioneFinale = descrizioneMeta(descrizione);
const canonical = urlAssoluto(percorso === '/' ? '/' : percorso.replace(/\/$/, ''));
// In anteprima le anteprime dei link (WhatsApp, Facebook, LinkedIn) devono leggere immagine e
// indirizzo dall'anteprima stessa: il dominio definitivo non serve ancora questo sito.
const baseAnteprima = 'https://anteprima-clinica-del-bosco.netlify.app';
const ogImage = immagine.startsWith('http')
  ? immagine
  : anteprima
    ? `${baseAnteprima}${immagine}`
    : urlAssoluto(immagine);
const ogUrl = anteprima ? `${baseAnteprima}${percorso === '/' ? '/' : percorso.replace(/\/$/, '')}` : canonical;
---

<title>{titoloFinale}</title>
<meta name="description" content={descrizioneFinale} />
<link rel="canonical" href={canonical} />
<meta
  name="robots"
  content={
    noindex || anteprima
      ? 'noindex, nofollow'
      : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
  }
/>

<meta property="og:type" content={tipo} />
<meta property="og:locale" content="it_IT" />
<meta property="og:site_name" content={clinica.nome} />
<meta property="og:title" content={titoloFinale} />
<meta property="og:description" content={descrizioneFinale} />
<meta property="og:url" content={ogUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={immagineAlt} />
{dataPubblicazione && <meta property="article:published_time" content={dataPubblicazione} />}
{dataModifica && <meta property="article:modified_time" content={dataModifica} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titoloFinale} />
<meta name="twitter:description" content={descrizioneFinale} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={immagineAlt} />

<meta name="geo.region" content="IT-NA" />
<meta name="geo.placename" content={clinica.indirizzo.comune} />
{clinica.misurazione.googleSiteVerification && (
  <meta name="google-site-verification" content={clinica.misurazione.googleSiteVerification} />
)}
{clinica.misurazione.bingSiteVerification && (
  <meta name="msvalidate.01" content={clinica.misurazione.bingSiteVerification} />
)}
