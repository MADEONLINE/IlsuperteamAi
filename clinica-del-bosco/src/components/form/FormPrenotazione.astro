---
/**
 * Form di prenotazione multi-step (4 passaggi, una domanda per schermata).
 * - Funziona SENZA JavaScript: è un unico <form> HTML con tutti i campi visibili; Netlify Forms
 *   riceve l'invio e reindirizza alla pagina di ringraziamento (attributo action).
 * - Con JavaScript: un passo alla volta, barra di avanzamento, validazione inline gentile,
 *   stato salvato in sessionStorage, deviazione "è un'urgenza" verso la chiamata,
 *   fallback WhatsApp precompilato, precompilazione da query string (?motivo=…&piano=…&specie=…).
 * - Anti-spam: honeypot Netlify ("indirizzo-web") + filtro Akismet lato Netlify + campo tempo.
 * - Privacy: informativa specifica e doppio consenso (gestione richiesta ≠ marketing, mai preselezionato).
 */
import Bottone from '@ui/Bottone.astro';
import Icona from '@ui/Icona.astro';
import Rassicurazioni from '@ui/Rassicurazioni.astro';
import { clinica, telHref, whatsappDisponibile, whatsappHref } from '@lib/clinica';

interface Props {
  nomeForm?: string;
}
const { nomeForm = 'prenotazione' } = Astro.props;

const specie = [
  { valore: 'cane', etichetta: 'Cane', icona: 'cane' },
  { valore: 'gatto', etichetta: 'Gatto', icona: 'gatto' },
  { valore: 'coniglio', etichetta: 'Coniglio', icona: 'coniglio' },
  { valore: 'esotico', etichetta: 'Altro animale esotico', icona: 'foglia' },
] as const;

const motivi = [
  { valore: 'visita', etichetta: 'Visita generale o controllo' },
  { valore: 'vaccino', etichetta: 'Vaccinazione o antiparassitari' },
  { valore: 'check-up', etichetta: 'Check-up con esami del sangue' },
  { valore: 'chirurgia', etichetta: 'Chirurgia o sterilizzazione' },
  { valore: 'tac-diagnostica', etichetta: 'TAC, ecografia o radiografia' },
  { valore: 'dermatologia', etichetta: 'Pelle, orecchie, prurito' },
  { valore: 'ortopedia', etichetta: 'Zoppia, articolazioni' },
  { valore: 'odontostomatologia', etichetta: 'Denti e bocca' },
  { valore: 'oncologia', etichetta: 'Oncologia' },
  { valore: 'esotici', etichetta: 'Coniglio o animale esotico' },
  { valore: 'piano-salute', etichetta: 'Attivare un Piano Salute' },
  { valore: 'altro', etichetta: 'Altro (lo scrivo nelle note)' },
  { valore: 'urgenza', etichetta: "È un'urgenza", urgenza: true },
] as const;

const oggi = new Date().toISOString().slice(0, 10);
const wa = whatsappHref('');
---

<form
  name={nomeForm}
  method="POST"
  action="/prenota/grazie"
  data-netlify="true"
  netlify-honeypot="indirizzo-web"
  class="form-prenotazione"
  novalidate
  data-passi="4"
>
  <input type="hidden" name="form-name" value={nomeForm} />
  <input type="hidden" name="origine" value="sito" />
  <input type="hidden" name="avvio" value="" class="campo-avvio" />
  <p class="hidden" aria-hidden="true">
    <label>
      Non compilare questo campo: <input name="indirizzo-web" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <!-- Avanzamento -->
  <ol
    class="avanzamento mb-8 grid grid-cols-4 gap-2 text-xs font-semibold uppercase tracking-wide"
    aria-label="Avanzamento della prenotazione"
  >
    {['Il tuo animale', 'Il motivo', 'Quando', 'Come richiamarti'].map((t, i) => (
      <li class="avanzamento-passo" data-passo={i + 1}>
        <span class="block h-1.5 rounded-full bg-bordo transition-colors"></span>
        <span class="mt-2 block text-testo-secondario">
          {i + 1}. {t}
        </span>
      </li>
    ))}
  </ol>

  <!-- PASSO 1 -->
  <fieldset class="passo" data-passo="1">
    <legend class="text-2xl md:text-3xl">Di chi ci occupiamo?</legend>
    <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4" role="radiogroup" aria-required="true">
      {specie.map((s) => (
        <label class="scelta flex min-h-24 cursor-pointer flex-col items-center justify-center gap-2 rounded-card border-2 border-bordo bg-sfondo-rialzato p-3 text-center font-semibold has-checked:border-primario has-checked:bg-primario-tenue">
          <input type="radio" name="specie" value={s.valore} class="sr-only" required />
          <Icona nome={s.icona} class="size-7 text-primario-link" />
          <span>{s.etichetta}</span>
        </label>
      ))}
    </div>
    <p class="errore mt-2 hidden text-sm text-errore" data-per="specie" role="alert">
      Scegli il tipo di animale per continuare.
    </p>

    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <div>
        <label for="nome-animale" class="block font-semibold">
          Come si chiama?
        </label>
        <input
          id="nome-animale"
          name="nome-animale"
          type="text"
          autocomplete="off"
          required
          maxlength="60"
          class="campo mt-1"
          placeholder="Es. Luna"
        />
        <p class="errore mt-1 hidden text-sm text-errore" data-per="nome-animale" role="alert">
          Scrivi il nome del tuo animale.
        </p>
      </div>
      <div>
        <label for="eta-animale" class="block font-semibold">
          Quanti anni ha?
        </label>
        <select id="eta-animale" name="eta-animale" required class="campo mt-1">
          <option value="">Scegli…</option>
          <option value="cucciolo">Meno di 1 anno</option>
          <option value="1-3">Da 1 a 3 anni</option>
          <option value="4-7">Da 4 a 7 anni</option>
          <option value="8-12">Da 8 a 12 anni</option>
          <option value="oltre-12">Più di 12 anni</option>
          <option value="non-so">Non lo so</option>
        </select>
        <p class="errore mt-1 hidden text-sm text-errore" data-per="eta-animale" role="alert">
          Indica l'età, anche approssimativa.
        </p>
      </div>
    </div>
  </fieldset>

  <!-- PASSO 2 -->
  <fieldset class="passo" data-passo="2">
    <legend class="text-2xl md:text-3xl">Di cosa hai bisogno?</legend>
    <div class="mt-5 grid gap-2 sm:grid-cols-2" role="radiogroup" aria-required="true">
      {motivi.map((m) => (
        <label
          class:list={[
            'scelta flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border-2 border-bordo bg-sfondo-rialzato px-4 py-2 font-medium has-checked:border-primario has-checked:bg-primario-tenue',
            'urgenza' in m &&
              m.urgenza &&
              'border-urgenza/50 text-urgenza-testo-su-chiaro has-checked:border-urgenza has-checked:bg-urgenza-tenue sm:col-span-2',
          ]}
        >
          <input
            type="radio"
            name="motivo"
            value={m.valore}
            class="size-4 accent-[var(--primario)]"
            required
          />
          {'urgenza' in m && m.urgenza && <Icona nome="ambulanza" class="size-5" />}
          <span>{m.etichetta}</span>
        </label>
      ))}
    </div>
    <p class="errore mt-2 hidden text-sm text-errore" data-per="motivo" role="alert">
      Scegli il motivo della visita.
    </p>

    <div
      class="pannello-urgenza mt-6 hidden rounded-card border-2 border-urgenza bg-urgenza-tenue p-5"
      role="alert"
    >
      <h3 class="flex items-center gap-2 font-sans text-xl font-bold text-urgenza-testo-su-chiaro">
        <Icona nome="ambulanza" class="size-6" /> Non compilare il form: chiama adesso.
      </h3>
      <p class="mt-2">
        Per le urgenze non serve prenotare. Il pronto soccorso è attivo 24 ore su 24 con medici in
        struttura: chiamaci mentre arrivi, così prepariamo tutto.
      </p>
      <Bottone
        href={telHref}
        variante="urgenza"
        dimensione="lg"
        icona="telefono"
        pieno
        class="mt-4"
        evento="click_chiama"
        eventoPosizione="form-urgenza"
      >
        Chiama ora · {clinica.contatti.telefono.visualizzato}
      </Bottone>
      <a
        href="/pronto-soccorso"
        class="mt-3 block text-sm font-semibold text-urgenza-testo-su-chiaro"
      >
        Cosa fare mentre arrivi →
      </a>
    </div>

    <div class="mt-6">
      <label for="dettagli" class="block font-semibold">
        Vuoi aggiungere qualcosa?{' '}
        <span class="font-normal text-testo-secondario">(facoltativo)</span>
      </label>
      <textarea
        id="dettagli"
        name="dettagli"
        rows="3"
        maxlength="600"
        class="campo mt-1"
        placeholder="Es. zoppica da due giorni sulla zampa posteriore destra"
      ></textarea>
    </div>
  </fieldset>

  <!-- PASSO 3 -->
  <fieldset class="passo" data-passo="3">
    <legend class="text-2xl md:text-3xl">Quando preferisci?</legend>
    <p class="mt-2 text-testo-secondario">
      Indica una preferenza: ti richiamiamo per confermare l'orario esatto.
    </p>
    <div class="mt-5 grid grid-cols-3 gap-3" role="radiogroup" aria-required="true">
      {[
        ['mattina', 'Mattina'],
        ['pomeriggio', 'Pomeriggio'],
        ['sera', 'Sera'],
      ].map(([v, t]) => (
        <label class="scelta flex min-h-14 cursor-pointer items-center justify-center rounded-card border-2 border-bordo bg-sfondo-rialzato p-3 text-center font-semibold has-checked:border-primario has-checked:bg-primario-tenue">
          <input type="radio" name="fascia" value={v} class="sr-only" required />
          <span>{t}</span>
        </label>
      ))}
    </div>
    <p class="errore mt-2 hidden text-sm text-errore" data-per="fascia" role="alert">
      Scegli una fascia oraria.
    </p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <div>
        <label for="data-1" class="block font-semibold">
          Prima data preferita
        </label>
        <input id="data-1" name="data-1" type="date" min={oggi} required class="campo mt-1" />
        <p class="errore mt-1 hidden text-sm text-errore" data-per="data-1" role="alert">
          Indica una data a partire da oggi.
        </p>
      </div>
      <div>
        <label for="data-2" class="block font-semibold">
          Seconda data <span class="font-normal text-testo-secondario">(facoltativa)</span>
        </label>
        <input id="data-2" name="data-2" type="date" min={oggi} class="campo mt-1" />
      </div>
    </div>
  </fieldset>

  <!-- PASSO 4 -->
  <fieldset class="passo" data-passo="4">
    <legend class="text-2xl md:text-3xl">Come ti richiamiamo?</legend>
    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <label for="nome" class="block font-semibold">
          Nome e cognome
        </label>
        <input
          id="nome"
          name="nome"
          type="text"
          autocomplete="name"
          required
          maxlength="80"
          class="campo mt-1"
        />
        <p class="errore mt-1 hidden text-sm text-errore" data-per="nome" role="alert">
          Scrivi il tuo nome.
        </p>
      </div>
      <div>
        <label for="telefono" class="block font-semibold">
          Telefono
        </label>
        <input
          id="telefono"
          name="telefono"
          type="tel"
          inputmode="tel"
          autocomplete="tel"
          required
          pattern="^[+0-9 ().-]{6,20}$"
          class="campo mt-1"
          placeholder="Es. 333 1234567"
        />
        <p class="errore mt-1 hidden text-sm text-errore" data-per="telefono" role="alert">
          Inserisci un numero di telefono valido: è il modo in cui ti richiamiamo.
        </p>
      </div>
      <div>
        <label for="email" class="block font-semibold">
          Email <span class="font-normal text-testo-secondario">(facoltativa)</span>
        </label>
        <input
          id="email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          maxlength="120"
          class="campo mt-1"
        />
        <p class="errore mt-1 hidden text-sm text-errore" data-per="email" role="alert">
          Controlla l'indirizzo email.
        </p>
      </div>
      <div class="sm:col-span-2">
        <label for="note" class="block font-semibold">
          Note per la reception <span class="font-normal text-testo-secondario">(facoltative)</span>
        </label>
        <textarea id="note" name="note" rows="2" maxlength="400" class="campo mt-1"></textarea>
      </div>
    </div>

    <div class="mt-6 space-y-3 rounded-card border border-bordo bg-sfondo-rialzato p-4 text-sm">
      <p>
        <strong>Informativa privacy.</strong> I dati inseriti sono trattati da{' '}
        {clinica.ragioneSociale} ({clinica.nome}) solo per gestire la tua richiesta di appuntamento
        (base giuridica: misure precontrattuali su tua richiesta, art. 6.1.b GDPR) e conservati per
        il tempo necessario. Non vengono ceduti a terzi. Puoi esercitare i tuoi diritti scrivendo ai
        recapiti indicati nella <a href="/privacy-policy">privacy policy</a>.
      </p>
      <label class="flex items-start gap-3">
        <input
          type="checkbox"
          name="consenso-gestione"
          value="si"
          required
          class="mt-1 size-5 shrink-0 accent-[var(--primario)]"
        />
        <span>
          Ho letto l'informativa e chiedo di essere ricontattato per l'appuntamento.{' '}
          <span class="text-testo-secondario">(necessario)</span>
        </span>
      </label>
      <p class="errore hidden text-sm text-errore" data-per="consenso-gestione" role="alert">
        Per poterti richiamare abbiamo bisogno di questo consenso.
      </p>
      <label class="flex items-start gap-3">
        <input
          type="checkbox"
          name="consenso-marketing"
          value="si"
          class="mt-1 size-5 shrink-0 accent-[var(--primario)]"
        />
        <span>
          Acconsento a ricevere promemoria di prevenzione (vaccini, antiparassitari, campagne
          stagionali) via email o WhatsApp.{' '}
          <span class="text-testo-secondario">(facoltativo, revocabile in qualsiasi momento)</span>
        </span>
      </label>
    </div>
  </fieldset>

  <!-- NAVIGAZIONE -->
  <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between">
    <button
      type="button"
      class="indietro inline-flex min-h-11 items-center gap-2 self-start rounded-pill px-4 font-semibold text-testo-secondario hover:bg-sfondo-tinta"
      hidden
    >
      <Icona nome="freccia-destra" class="size-4 rotate-180" /> Indietro
    </button>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <button
        type="button"
        class="avanti btn inline-flex min-h-14 items-center justify-center gap-2 rounded-pill bg-primario px-6 text-lg font-semibold text-primario-testo hover:bg-primario-forte"
        hidden
      >
        Continua <Icona nome="freccia-destra" class="size-5" />
      </button>
      <Bottone
        type="submit"
        variante="primario"
        dimensione="lg"
        icona="check"
        class="invia"
        evento="form_inviato"
        eventoPosizione="prenota"
      >
        Invia la richiesta
      </Bottone>
    </div>
  </div>
  <p class="stato mt-3 text-sm" aria-live="polite"></p>
  <Rassicurazioni class="mt-4" voci={['richiamo', 'pagamento', 'preventivo']} />

  {whatsappDisponibile && wa && (
    <p class="mt-6 text-sm text-testo-secondario">
      Preferisci WhatsApp?{' '}
      <a
        href={wa}
        class="fallback-whatsapp font-semibold text-primario-link"
        target="_blank"
        rel="noopener"
        data-base={wa}
        data-evento="click_whatsapp"
        data-evento-posizione="form"
      >
        Scrivici su WhatsApp
      </a>{' '}
      con i dati che hai già inserito.
    </p>
  )}
</form>

<style>
  .campo {
    display: block;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.6rem 0.9rem;
    border: 2px solid var(--bordo-forte);
    border-radius: 0.75rem;
    background: var(--sfondo-rialzato);
    color: var(--testo);
    font: inherit;
  }
  .campo:focus {
    border-color: var(--primario);
    outline: none;
    box-shadow: 0 0 0 3px var(--primario-tenue);
  }
  .campo[aria-invalid='true'] {
    border-color: var(--errore);
  }
  /* Con JS attivo mostriamo un passo alla volta */
  :global(html.js) .passo:not(.attivo) {
    display: none;
  }
  .avanzamento-passo.completato > span:first-child,
  .avanzamento-passo.corrente > span:first-child {
    background: var(--primario);
  }
  .avanzamento-passo.corrente > span:last-child {
    color: var(--testo);
  }
</style>

<script>
  import { traccia, type EventoSito } from '@lib/analytics';

  const CHIAVE = 'prenotazione-bozza-v1';

  function inizializza() {
    const form = document.querySelector<HTMLFormElement>('.form-prenotazione');
    if (!form || form.dataset['pronto']) return;
    form.dataset['pronto'] = '1';

    const passi = [...form.querySelectorAll<HTMLFieldSetElement>('.passo')];
    const indicatori = [...form.querySelectorAll<HTMLElement>('.avanzamento-passo')];
    const indietro = form.querySelector<HTMLButtonElement>('.indietro')!;
    const avanti = form.querySelector<HTMLButtonElement>('.avanti')!;
    const invia = form.querySelector<HTMLButtonElement>('.invia')!;
    const stato = form.querySelector<HTMLElement>('.stato')!;
    const pannelloUrgenza = form.querySelector<HTMLElement>('.pannello-urgenza')!;
    const avvio = form.querySelector<HTMLInputElement>('.campo-avvio');
    if (avvio) avvio.value = String(Date.now());
    let corrente = 1;

    // Precompilazione da query string (?motivo=…&specie=…&piano=…)
    const params = new URLSearchParams(location.search);
    const motivoParam = params.get('motivo');
    const mappaMotivi: Record<string, string> = {
      'pronto-soccorso-h24': 'urgenza',
      chirurgia: 'chirurgia',
      'tac-diagnostica-avanzata': 'tac-diagnostica',
      'diagnostica-per-immagini': 'tac-diagnostica',
      'laboratorio-analisi': 'check-up',
      'medicina-preventiva-vaccinazioni': 'vaccino',
      ortopedia: 'ortopedia',
      oncologia: 'oncologia',
      dermatologia: 'dermatologia',
      odontostomatologia: 'odontostomatologia',
      'animali-esotici-e-conigli': 'esotici',
      'gatto-cat-friendly': 'visita',
      'piano-salute': 'piano-salute',
      'prevenzione-parassiti': 'vaccino',
      'check-up-estivo': 'check-up',
      'controllo-dentale': 'odontostomatologia',
      'check-up-senior': 'check-up',
    };
    if (motivoParam) {
      const valore =
        mappaMotivi[motivoParam] ??
        (form.querySelector(`input[name="motivo"][value="${CSS.escape(motivoParam)}"]`)
          ? motivoParam
          : 'altro');
      const radio = form.querySelector<HTMLInputElement>(
        `input[name="motivo"][value="${CSS.escape(valore)}"]`,
      );
      if (radio) radio.checked = true;
      const dettagli = form.querySelector<HTMLTextAreaElement>('#dettagli');
      if (dettagli && params.get('piano'))
        dettagli.value = `Vorrei attivare il Piano Salute ${params.get('piano')}.`;
    }
    const specieParam = params.get('specie');
    if (specieParam) {
      const r = form.querySelector<HTMLInputElement>(
        `input[name="specie"][value="${CSS.escape(specieParam)}"]`,
      );
      if (r) r.checked = true;
    }

    // Ripristino bozza
    try {
      const bozza = JSON.parse(sessionStorage.getItem(CHIAVE) ?? '{}') as Record<string, string>;
      for (const [k, v] of Object.entries(bozza)) {
        const el = form.elements.namedItem(k);
        if (!el) continue;
        if (el instanceof RadioNodeList) el.value = v;
        else if (el instanceof HTMLInputElement && el.type === 'checkbox') el.checked = v === 'si';
        else if (
          el instanceof HTMLInputElement ||
          el instanceof HTMLSelectElement ||
          el instanceof HTMLTextAreaElement
        )
          el.value = v;
      }
    } catch {
      /* nessuna bozza */
    }

    const salva = () => {
      try {
        const dati: Record<string, string> = {};
        new FormData(form).forEach((v, k) => {
          if (typeof v === 'string' && !['form-name', 'indirizzo-web', 'avvio'].includes(k))
            dati[k] = v;
        });
        sessionStorage.setItem(CHIAVE, JSON.stringify(dati));
      } catch {
        /* storage pieno o negato */
      }
      aggiornaWhatsapp();
    };

    const aggiornaWhatsapp = () => {
      const link = form.querySelector<HTMLAnchorElement>('.fallback-whatsapp');
      if (!link) return;
      const d = new FormData(form);
      const parti = [
        'Buongiorno, vorrei prenotare una visita.',
        d.get('nome-animale')
          ? `Animale: ${d.get('specie') ?? ''} ${d.get('nome-animale')} (${d.get('eta-animale') ?? ''})`
          : '',
        d.get('motivo') ? `Motivo: ${d.get('motivo')}` : '',
        d.get('fascia') || d.get('data-1')
          ? `Preferenza: ${d.get('fascia') ?? ''} ${d.get('data-1') ?? ''}`
          : '',
        d.get('nome') ? `Mi chiamo ${d.get('nome')}` : '',
      ].filter(Boolean);
      link.href = `${link.dataset['base']}?text=${encodeURIComponent(parti.join('\n'))}`;
    };

    const mostraErrore = (nome: string, visibile: boolean) => {
      const msg = form.querySelector<HTMLElement>(`.errore[data-per="${nome}"]`);
      if (msg) msg.classList.toggle('hidden', !visibile);
      const campo = form.querySelector<HTMLElement>(`[name="${nome}"]`);
      if (campo && !(campo instanceof HTMLInputElement && campo.type === 'radio'))
        campo.setAttribute('aria-invalid', String(visibile));
    };

    const validaPasso = (n: number): boolean => {
      const passo = passi[n - 1]!;
      let ok = true;
      let primoErrore: HTMLElement | null = null;
      const nomi = new Set(
        [...passo.querySelectorAll<HTMLInputElement>('[name]')].map((e) => e.name),
      );
      for (const nome of nomi) {
        const el = form.elements.namedItem(nome);
        let valido = true;
        if (el instanceof RadioNodeList)
          valido = Boolean(el.value) || !(el[0] as HTMLInputElement).required;
        else if (
          el instanceof HTMLInputElement ||
          el instanceof HTMLSelectElement ||
          el instanceof HTMLTextAreaElement
        )
          valido = el.checkValidity();
        mostraErrore(nome, !valido);
        if (!valido) {
          ok = false;
          primoErrore ??=
            el instanceof RadioNodeList ? (el[0] as HTMLElement) : (el as HTMLElement);
        }
      }
      if (!ok) {
        stato.textContent = 'Controlla i campi evidenziati.';
        primoErrore?.focus();
      } else stato.textContent = '';
      return ok;
    };

    const urgenzaSelezionata = () =>
      (form.elements.namedItem('motivo') as RadioNodeList | null)?.value === 'urgenza';

    const mostra = (n: number, scorri = true) => {
      corrente = n;
      passi.forEach((p, i) => p.classList.toggle('attivo', i + 1 === n));
      indicatori.forEach((ind, i) => {
        ind.classList.toggle('completato', i + 1 < n);
        ind.classList.toggle('corrente', i + 1 === n);
        ind.setAttribute('aria-current', i + 1 === n ? 'step' : 'false');
      });
      const urgenza = n === 2 && urgenzaSelezionata();
      pannelloUrgenza.classList.toggle('hidden', !urgenza);
      indietro.hidden = n === 1;
      avanti.hidden = n === passi.length || urgenza;
      invia.hidden = n !== passi.length;
      passi[n - 1]?.querySelector('legend')?.setAttribute('tabindex', '-1');
      (passi[n - 1]?.querySelector('legend') as HTMLElement | undefined)?.focus();
      if (scorri)
        window.scrollTo({
          top: form.getBoundingClientRect().top + window.scrollY - 96,
          behavior: 'smooth',
        });
    };

    avanti.addEventListener('click', () => {
      if (!validaPasso(corrente)) return;
      traccia(`form_step_${corrente}` as EventoSito);
      salva();
      mostra(corrente + 1);
    });
    indietro.addEventListener('click', () => mostra(Math.max(1, corrente - 1)));
    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name) mostraErrore(t.name, false);
      if (t.name === 'motivo') {
        const urgenza = urgenzaSelezionata();
        pannelloUrgenza.classList.toggle('hidden', !urgenza);
        avanti.hidden = urgenza;
        if (urgenza) traccia('click_chiama', { posizione: 'form-urgenza-mostrata' });
      }
      salva();
    });
    form.addEventListener('submit', (e) => {
      for (let i = 1; i <= passi.length; i++) {
        if (!validaPasso(i)) {
          e.preventDefault();
          mostra(i);
          return;
        }
      }
      traccia('form_step_4');
      invia.setAttribute('disabled', 'true');
      stato.textContent = 'Invio in corso…';
      try {
        sessionStorage.removeItem(CHIAVE);
      } catch {
        /* ignora */
      }
    });

    invia.hidden = true;
    mostra(1, false);
    aggiornaWhatsapp();
  }
  inizializza();
  document.addEventListener('astro:page-load', inizializza);
</script>
