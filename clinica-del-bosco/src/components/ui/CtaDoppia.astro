---
/**
 * Chiusura di pagina: "Prenota una visita" in evidenza, telefono della clinica come seconda via.
 * Usato in fondo alle pagine servizio e agli articoli.
 */
import Bottone from '@ui/Bottone.astro';
import { clinica, telHref } from '@lib/clinica';

interface Props {
  motivo?: string;
  titolo?: string;
  testo?: string;
  posizione?: string;
  class?: string;
}
const {
  motivo,
  titolo = 'Hai bisogno di noi?',
  testo = 'Prenota una visita online oppure chiama la clinica: ti aiutiamo a scegliere il percorso giusto per il tuo animale.',
  posizione = 'cta-doppia',
  class: classe = '',
} = Astro.props;
const hrefPrenota = motivo ? `/prenota?motivo=${encodeURIComponent(motivo)}` : '/prenota';
---

<section
  class:list={['rounded-card bg-sfondo-inverso p-6 text-testo-inverso md:p-10', classe]}
  aria-labelledby="cta-doppia-titolo"
>
  <div class="grid gap-6 md:grid-cols-12 md:items-center">
    <div class="md:col-span-6">
      <h2 id="cta-doppia-titolo" class="text-3xl text-testo-inverso">
        {titolo}
      </h2>
      <p class="mt-3 text-testo-inverso/85">{testo}</p>
    </div>
    <div class="flex flex-col gap-3 md:col-span-6">
      <Bottone href={hrefPrenota} variante="inverso" dimensione="lg" icona="calendario" pieno>
        Prenota una visita
      </Bottone>
      <Bottone
        href={telHref}
        variante="secondario-inverso"
        dimensione="lg"
        icona="telefono"
        pieno
        evento="click_chiama"
        eventoPosizione={posizione}
      >
        Chiama · {clinica.contatti.telefono.visualizzato}
      </Bottone>
    </div>
  </div>
</section>
