---
/**
 * Slot fotografico con art direction: ratio fisso, object-fit, didascalia opzionale.
 * Finché non arrivano le foto reali (vedi BRIEF-FOTO.md) mostra un riquadro neutro con il
 * marchio: il numero di scatto del brief resta solo nell'attributo data-scatto, non nel testo visibile.
 *
 * Quando la foto è disponibile, passare `src` (ImageMetadata da src/assets/img) e `alt`.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icona from '@ui/Icona.astro';
import { altScatto, scatto } from '@lib/scatti';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  ratio?: '1/1' | '4/3' | '3/2' | '16/9' | '21/9' | '3/4' | '4/5';
  scattoBrief?: string | undefined;
  descrizioneSegnaposto?: string;
  didascalia?: string;
  /** Carica subito l'immagine (senza però rubare priorità ai font, che reggono l'LCP testuale). */
  priorita?: boolean;
  larghezze?: number[];
  sizes?: string;
  class?: string;
  posizione?: string;
  /** Nelle sezioni a tutta altezza l'immagine riempie la colonna invece di fermarsi al suo rapporto. */
  riempi?: boolean;
  /** Iniziali da mostrare nel segnaposto (ritratti non ancora disponibili). */
  monogramma?: string;
}
const {
  src,
  alt = '',
  ratio = '3/2',
  scattoBrief,
  descrizioneSegnaposto = 'Fotografia della clinica',
  didascalia,
  priorita = false,
  larghezze = [480, 768, 1024, 1440],
  sizes = '(min-width: 1280px) 60vw, 100vw',
  class: classe = '',
  posizione = 'center',
  riempi = false,
  monogramma,
} = Astro.props;
/**
 * Quando la pagina indica solo il numero di scatto, l'immagine e il suo testo alternativo
 * vengono risolti dal registro in @lib/scatti: appena il file esiste il segnaposto sparisce.
 */
const immagine = src ?? scatto(scattoBrief);
const testoAlternativo = alt || altScatto(scattoBrief) || descrizioneSegnaposto;
const ratioClasse: Record<NonNullable<Props['ratio']>, string> = {
  '1/1': 'aspect-square',
  '4/3': 'aspect-[4/3]',
  '3/2': 'aspect-[3/2]',
  '16/9': 'aspect-video',
  '21/9': 'aspect-[21/9]',
  '3/4': 'aspect-[3/4]',
  '4/5': 'aspect-[4/5]',
};
const posizioni: Record<string, string> = {
  center: 'object-center',
  top: 'object-top',
  bottom: 'object-bottom',
};
---

<figure class:list={['relative m-0 overflow-hidden rounded-card bg-sfondo-tinta', classe]}>
  <div class:list={[ratioClasse[ratio], 'relative w-full', riempi && 'lg:aspect-auto lg:h-full']}>
    {immagine ? (
      <Picture
        src={immagine}
        alt={testoAlternativo}
        widths={larghezze}
        sizes={sizes}
        formats={['avif']}
        fallbackFormat="webp"
        loading={priorita ? 'eager' : 'lazy'}
        decoding={priorita ? 'sync' : 'async'}
        pictureAttributes={{ class: 'absolute inset-0 block size-full' }}
        class:list={['size-full object-cover', posizioni[posizione]]}
      />
    ) : (
      <div
        class="segnaposto-foto absolute inset-0 flex items-center justify-center text-primario-link"
        role="img"
        aria-label={descrizioneSegnaposto}
        data-scatto={scattoBrief}
      >
        {monogramma ? (
          <span
            class="font-display text-5xl tracking-tight opacity-80 md:text-6xl"
            aria-hidden="true"
          >
            {monogramma}
          </span>
        ) : (
          <Icona nome="foglia" duo class="size-12 opacity-50" />
        )}
      </div>
    )}
  </div>
  {didascalia && (
    <figcaption class="px-4 py-2 text-sm text-testo-secondario">{didascalia}</figcaption>
  )}
</figure>

<style>
  /* Segnaposto: gradiente del bosco con trama leggera, finché non arriva la foto reale. */
  .segnaposto-foto {
    background:
      radial-gradient(
        90% 70% at 20% 0%,
        color-mix(in oklab, var(--primario) 22%, transparent),
        transparent 70%
      ),
      radial-gradient(
        80% 60% at 100% 100%,
        color-mix(in oklab, var(--oro) 26%, transparent),
        transparent 70%
      ),
      var(--sfondo-tinta);
  }
  /*
   * Gli stili delle immagini responsive di Astro (@layer astro.images) impongono
   * height:auto, e una regola dentro un layer batte le utility di Tailwind a
   * prescindere dalla specificità: l'immagine restava alta quanto il suo rapporto
   * naturale e "object-cover" non ritagliava mai. Finché i segnaposto avevano lo
   * stesso rapporto dello slot non si vedeva; con una fotografia di forma diversa
   * resta una fascia vuota sotto. Questa regola non sta in nessun layer, quindi
   * vince, e fa sì che la foto riempia davvero il riquadro.
   */
  figure > div > picture,
  figure > div > picture > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
