---
/**
 * Marchio della clinica.
 *
 * Disegno ufficiale dal kit di identità visiva: i tracciati vivono una volta
 * sola per pagina in Marchio.astro, qui si richiamano con <use> (nessuna
 * richiesta di rete, nessun font da caricare, colori dai token del brand).
 *
 * - default: lockup orizzontale (marchio + filetto sabbia + nome). Il kit lo
 *   indica come logo di default e non sotto i 140 px di larghezza: alle altezze
 *   usate qui (40/44 px) il lockup misura 149/164 px.
 * - `soloSimbolo`: la sola Radura, dove il nome è già presente.
 * - `inverso`: versione reverse (monocromatica off-white) per i fondi scuri.
 *
 * Il testo accessibile sta sull'elemento che avvolge il logo (aria-label del
 * link): qui il disegno è decorativo.
 */
interface Props {
  class?: string;
  inverso?: boolean;
  soloSimbolo?: boolean;
}
const { class: classe = '', inverso = false, soloSimbolo = false } = Astro.props;
---

{soloSimbolo ? (
  <svg
    viewBox="0 0 1624 1737"
    class:list={['block h-10 w-auto', inverso && 'marchio--inverso', classe]}
    aria-hidden="true"
    focusable="false"
  >
    <use href="#marchio-radura" />
  </svg>
) : (
  <svg
    viewBox="0 0 448 120"
    class:list={['block h-10 w-auto sm:h-11', inverso && 'marchio--inverso', classe]}
    aria-hidden="true"
    focusable="false"
  >
    <use href="#marchio-lockup" />
  </svg>
)}
