---
/**
 * Eyebrow: piccola etichetta maiuscola sopra un titolo, preceduta dal rombo oro
 * ripreso dal sigillo del marchio.
 */
interface Props {
  class?: string;
  tono?: 'primario' | 'urgenza' | 'neutro' | 'inverso';
}
const { class: classe = '', tono = 'primario' } = Astro.props;
const toni = {
  primario: 'text-primario-link',
  urgenza: 'text-urgenza-testo-su-chiaro',
  neutro: 'text-testo-secondario',
  inverso: 'text-accento-inverso',
};
---

<p class:list={['eyebrow flex items-center gap-2', toni[tono], classe]}>
  <span class="rombo-marchio" aria-hidden="true"></span>
  <slot />
</p>

<style>
  /* Rombo del sigillo: 5 px, oro, allineato alla x-height dell'etichetta. */
  .rombo-marchio {
    width: 5px;
    height: 5px;
    flex: none;
    background: var(--oro);
    transform: rotate(45deg);
  }
</style>
