---
/**
 * Tabella HTML vera (th/caption) da un oggetto `tabella` del frontmatter: i modelli AI la estraggono bene.
 * Sul telefono ogni riga diventa una scheda (global.css): i ruoli ARIA espliciti tengono la
 * semantica di tabella anche quando le celle passano a display:block.
 */
interface Props {
  tabella: { titolo: string; intestazioni: string[]; righe: string[][]; nota?: string | undefined };
  class?: string;
}
const { tabella, class: classe = '' } = Astro.props;
---

<div
  class:list={['tabella-dati', classe]}
  tabindex="0"
  role="region"
  aria-label={tabella.titolo}
>
  <table role="table">
    <caption>{tabella.titolo}</caption>
    <thead role="rowgroup">
      <tr role="row">
        {tabella.intestazioni.map((h) => (
          <th scope="col" role="columnheader">{h}</th>
        ))}
      </tr>
    </thead>
    <tbody role="rowgroup">
      {tabella.righe.map((r) => (
        <tr role="row">
          {r.map((c, i) =>
            i === 0 ? (
              <th scope="row" role="rowheader">{c}</th>
            ) : (
              <td role="cell" data-etichetta={tabella.intestazioni[i]}>{c}</td>
            ),
          )}
        </tr>
      ))}
    </tbody>
  </table>
  {tabella.nota && <p class="px-4 pb-4 text-sm text-testo-secondario">{tabella.nota}</p>}
</div>
