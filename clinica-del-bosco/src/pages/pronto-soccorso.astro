---
/**
 * /pronto-soccorso — la pagina a più alto valore del sito.
 * Above the fold su iPhone SE: stato "aperto adesso", CHIAMA ORA a piena larghezza (56 px),
 * INDICAZIONI, indirizzo, tempo di percorrenza. Nessun elemento di distrazione.
 * Contenuto clinico interamente nell'HTML statico (citabile dai sistemi AI).
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Bottone from '@ui/Bottone.astro';
import Icona from '@ui/Icona.astro';
import Etichetta from '@ui/Etichetta.astro';
import Sezione from '@ui/Sezione.astro';
import Rassicurazioni from '@ui/Rassicurazioni.astro';
import BadgeApertoOra from '@sezioni/BadgeApertoOra.astro';
import TriageRapido from '@sezioni/TriageRapido.astro';
import { getEntries, getEntry } from 'astro:content';
import Referenti from '@ui/Referenti.astro';
import Fonti from '@ui/Fonti.astro';
import {
  clinica,
  daConfermare,
  indicazioniAppleHref,
  indicazioniHref,
  indirizzoRiga,
  telHref,
} from '@lib/clinica';
import { faqPage, medicalWebPage } from '@lib/schema';

const servizio = await getEntry('servizi', 'pronto-soccorso-h24');
if (!servizio) throw new Error('Contenuto servizi/pronto-soccorso-h24 mancante');
/** Medici del turno di notte: prima stavano nella pagina servizio, ora accorpata qui. */
const turnoNotte = (await getEntries(servizio.data.referenti)).filter(Boolean);

const titolo = 'Pronto soccorso veterinario 24h, Portici';
const descrizione =
  'Pronto soccorso veterinario a Portici aperto 24 ore su 24, festivi inclusi, con un medico in clinica anche di notte. Chiama mentre arrivi: 081 7763859.';

const istruzioni = [
  {
    titolo: 'Chiama mentre parti',
    testo: `Al ${clinica.contatti.telefono.visualizzato} descrivi cosa vedi. Intanto prepariamo l'ossigeno e la sala.`,
    icona: 'telefono',
  },
  {
    titolo: 'Trasportalo in sicurezza',
    testo:
      'Gatti e conigli vanno nel trasportino. Un cane che ha subito un trauma va spostato su una superficie rigida o su una coperta tenuta tesa da due persone.',
    icona: 'auto',
  },
  {
    titolo: 'Non dargli niente',
    testo:
      'Niente cibo, acqua o farmaci per persone: paracetamolo e ibuprofene sono tossici per cani e gatti. Non provare a farlo vomitare.',
    icona: 'allerta',
  },
  {
    titolo: 'Porta quello che trovi',
    testo:
      'Libretto, referti recenti, farmaci che prende. Se ha mangiato una sostanza, la confezione o una foto. Se non li trovi subito, parti lo stesso.',
    icona: 'calendario',
  },
  {
    titolo: 'Tienilo calmo e al fresco',
    testo:
      'Aria condizionata in auto, luci basse, voce tranquilla. Se respira male, lascialo nella posizione che sceglie lui.',
    icona: 'cuore-pulsante',
  },
] as const;

const triage = [
  {
    id: 'dispnea',
    titolo: 'Difficoltà a respirare',
    testo:
      "Respira con fatica anche da fermo, il gatto respira a bocca aperta, le gengive sono bluastre o grigie, tiene il collo teso. È sempre un'urgenza.",
  },
  {
    id: 'convulsioni',
    titolo: 'Convulsioni',
    testo:
      "La crisi dura più di 3 minuti, le crisi si ripetono o l'animale non si riprende tra una e l'altra. Guarda quanto dura e allontana gli oggetti vicini.",
  },
  {
    id: 'torsione-gastrica',
    titolo: 'Torsione dello stomaco',
    testo:
      'Un cane di taglia grande ha la pancia gonfia e tesa, prova a vomitare senza riuscirci, è agitato. Ogni minuto conta: parti subito.',
  },
  {
    id: 'avvelenamento',
    titolo: 'Avvelenamento',
    testo:
      'Ha mangiato veleno per topi o lumache, cioccolato, uva, xilitolo, farmaci per persone, piante tossiche o antigelo. Porta la confezione.',
  },
  {
    id: 'trauma',
    titolo: 'Trauma',
    testo:
      "Investimento, caduta dall'alto, morso profondo, ferita che continua a sanguinare. Le lesioni interne possono non vedersi.",
  },
  {
    id: 'parto-distocico',
    titolo: 'Parto che non va avanti',
    testo:
      "Spinge forte da più di 30 minuti e non nasce nessun cucciolo, oppure passano più di 2 ore tra un cucciolo e l'altro. Anche perdite verdastre senza nascite o una madre sfinita sono un'urgenza.",
  },
  {
    id: 'blocco-urinario',
    titolo: 'Gatto maschio che non urina',
    testo:
      'Va e viene dalla lettiera senza urinare, si lamenta, si lecca la parte bassa della pancia, vomita. Il blocco urinario può essere mortale in 24-48 ore.',
  },
  {
    id: 'colpo-di-calore',
    titolo: 'Colpo di calore',
    testo:
      "Dopo uno sforzo o in un'auto al sole: ansima forte, gengive rosso scuro, barcolla, crolla. Bagnalo con acqua fresca, non gelata, e parti.",
  },
  {
    id: 'collasso',
    titolo: 'Crolla o non riesce ad alzarsi',
    testo:
      "Debolezza improvvisa, gengive pallide, pancia gonfia: può essere un'emorragia interna o un problema al cuore.",
  },
  {
    id: 'occhio',
    titolo: 'Occhio chiuso, gonfio o sporgente',
    testo:
      "Dolore forte all'occhio, una pupilla diversa dall'altra, occhio uscito dall'orbita: la vista si può perdere in poche ore.",
  },
];

const briciole = [{ nome: 'Pronto soccorso', href: '/pronto-soccorso' }];
const faqJson = servizio.data.faq;
---

<BaseLayout
  titolo={titolo}
  descrizione={descrizione}
  percorso="/pronto-soccorso"
  jsonLd={[
    medicalWebPage({
      url: '/pronto-soccorso',
      titolo,
      descrizione,
      briciole,
      specialita: 'Emergency',
    }),
    faqPage(faqJson),
  ]}
>
  <!-- ABOVE THE FOLD -->
  <section class="bg-sfondo-inverso text-testo-inverso" aria-labelledby="ps-titolo">
    <div class="contenitore py-6 md:py-14">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <BadgeApertoOra inverso class="mb-4" />
          <h1 id="ps-titolo" class="text-4xl text-testo-inverso sm:text-5xl md:text-6xl">
            Pronto soccorso veterinario a Portici,{' '}
            <em class="not-italic text-accento-inverso">aperto 24 ore su 24.</em>
          </h1>
          <p class="mt-3 text-lg text-testo-inverso/85 md:text-xl">
            Siamo aperti adesso. Il pronto soccorso della {clinica.nome} è aperto tutti i giorni
            dell'anno, festivi compresi. Di notte c'è sempre un medico veterinario in clinica. Non
            serve l'appuntamento: chiama mentre parti.
          </p>

          <div class="mt-6 space-y-3">
            <Bottone
              href={telHref}
              variante="urgenza"
              dimensione="lg"
              icona="telefono"
              pieno
              evento="click_chiama"
              eventoPosizione="ps-hero"
              class="text-xl"
              aria-label={`Chiama ora il pronto soccorso: ${clinica.contatti.telefono.visualizzato}`}
            >
              Chiama ora · {clinica.contatti.telefono.visualizzato}
            </Bottone>
            <Bottone
              href={indicazioniHref}
              variante="inverso"
              dimensione="lg"
              icona="mappa"
              pieno
              target="_blank"
              rel="noopener"
              evento="click_indicazioni"
              eventoPosizione="ps-hero"
            >
              Indicazioni stradali
            </Bottone>
          </div>

          <ul
            class="mt-5 grid gap-2 text-sm text-testo-inverso/90 sm:grid-cols-2"
            aria-label="Come funziona l'accesso"
          >
            {clinica.orari.prontoSoccorso.accessoDiretto && (
              <li class="flex items-start gap-2">
                <Icona nome="check" class="mt-0.5 size-4 shrink-0 text-accento-inverso" />
                <span>
                  <strong>Non serve appuntamento.</strong> Vieni direttamente, a qualsiasi ora.
                </span>
              </li>
            )}
            {clinica.orari.prontoSoccorso.rispondeUnMedico && (
              <li class="flex items-start gap-2">
                <Icona nome="check" class="mt-0.5 size-4 shrink-0 text-accento-inverso" />
                <span>
                  <strong>Al telefono risponde un medico</strong>, non una segreteria.
                </span>
              </li>
            )}
            <li class="flex items-start gap-2">
              <Icona nome="check" class="mt-0.5 size-4 shrink-0 text-accento-inverso" />
              <span>
                <strong>Chi è in pericolo di vita passa per primo</strong>, anche se arriva dopo. Lo
                valutiamo all'arrivo, prima della registrazione.
              </span>
            </li>
            {clinica.orari.prontoSoccorso.aiutoAllArrivo && (
              <li class="flex items-start gap-2">
                <Icona nome="check" class="mt-0.5 size-4 shrink-0 text-accento-inverso" />
                <span>
                  <strong>Ti veniamo incontro in auto</strong> se ci avvisi che non riesci a
                  portarlo dentro.
                </span>
              </li>
            )}
            {clinica.orari.prontoSoccorso.proprietarioAccanto && (
              <li class="flex items-start gap-2">
                <Icona nome="check" class="mt-0.5 size-4 shrink-0 text-accento-inverso" />
                <span>
                  <strong>Puoi restare accanto a lui</strong> durante la visita, salvo manovre di
                  rianimazione.
                </span>
              </li>
            )}
          </ul>

          <address class="mt-5 not-italic">
            <p class="flex items-start gap-2 text-testo-inverso">
              <Icona nome="mappa" class="mt-1 size-4 shrink-0 text-accento-inverso" />
              <span>
                <strong>{indirizzoRiga}</strong>
                {!daConfermare(clinica.indirizzo.riferimenti) && (
                  <span class="block text-sm text-testo-inverso/80">
                    {clinica.indirizzo.riferimenti}
                  </span>
                )}
                <a
                  href={indicazioniAppleHref}
                  class="block text-sm text-testo-inverso/80 underline"
                  target="_blank"
                  rel="noopener"
                >
                  Apri in Apple Maps
                </a>
              </span>
            </p>
          </address>
        </div>

        <div class="hidden lg:col-span-5 lg:block">
          <div class="rounded-card bg-sfondo/8 p-6 ring-1 ring-sfondo/15">
            <h2 class="font-sans text-base font-bold uppercase tracking-wider text-accento-inverso">
              Cosa trovi quando arrivi
            </h2>
            <ul class="mt-4 space-y-3 text-testo-inverso/90">
              <li class="flex gap-3">
                <Icona nome="check" class="mt-1 size-5 shrink-0 text-accento-inverso" /> Medico
                veterinario e tecnico in clinica anche di notte, non solo reperibilità
              </li>
              <li class="flex gap-3">
                <Icona nome="check" class="mt-1 size-5 shrink-0 text-accento-inverso" /> Terapia
                intensiva con ossigeno e monitoraggio continuo dei parametri vitali
              </li>
              <li class="flex gap-3">
                <Icona nome="check" class="mt-1 size-5 shrink-0 text-accento-inverso" />{' '}
                Laboratorio, radiologia, ecografia e TC nella stessa sede
              </li>
              <li class="flex gap-3">
                <Icona nome="check" class="mt-1 size-5 shrink-0 text-accento-inverso" /> Due sale
                chirurgiche pronte per l'urgenza
              </li>
              <li class="flex gap-3">
                <Icona nome="check" class="mt-1 size-5 shrink-0 text-accento-inverso" /> Cani, gatti
                e animali esotici
              </li>
            </ul>
            <Rassicurazioni inverso voci={['h24']} class="mt-5" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COSA FARE MENTRE ARRIVI -->
  <Sezione id="mentre-arrivi" tono="base" etichettaAria="Cosa fare mentre arrivi in clinica">
    <div class="grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <Etichetta class="mb-3">Primo intervento</Etichetta>
        <h2 class="text-3xl md:text-4xl">Cosa fare mentre arrivi</h2>
        <p class="mt-4 text-testo-secondario">
          Cinque cose che aiutano davvero il tuo animale nei minuti del tragitto. Nessuna
          sostituisce la visita: servono ad arrivare nelle condizioni migliori.
        </p>
      </div>
      <ol class="grid gap-4 sm:grid-cols-2 lg:col-span-8">
        {istruzioni.map((i, n) => (
          <li class="flex gap-4 rounded-card border border-bordo bg-sfondo-rialzato p-5">
            <span
              class="flex size-10 shrink-0 items-center justify-center rounded-full bg-primario-tenue font-display text-lg font-bold text-primario-link"
              aria-hidden="true"
            >
              {n + 1}
            </span>
            <div>
              <h3 class="font-sans text-lg font-bold">{i.titolo}</h3>
              <p class="mt-1 text-testo-secondario">{i.testo}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Sezione>

  <!-- TRIAGE -->
  <Sezione
    id="quando-venire-subito"
    tono="tinta"
    etichettaAria="Segni che richiedono di venire subito"
  >
    <div class="prosa">
      <Etichetta class="mb-3">Segni di urgenza</Etichetta>
      <h2 class="text-3xl md:text-4xl">Quando venire subito, senza aspettare il mattino</h2>
      <p class="mt-4 text-lg text-testo-secondario">
        Se riconosci uno di questi segni, chiama e parti. Se non sei sicuro, chiama comunque.
      </p>
    </div>
    <ul class="mt-8 grid gap-3 md:grid-cols-2">
      {triage.map((t) => (
        <li
          id={t.id}
          class="scroll-mt-24 rounded-card border-l-4 border-urgenza bg-sfondo-rialzato p-5"
        >
          <h3 class="font-sans text-lg font-bold">
            <a href={`#${t.id}`} class="text-testo no-underline hover:underline">
              {t.titolo}
            </a>
          </h3>
          <p class="mt-1 text-testo-secondario">{t.testo}</p>
        </li>
      ))}
    </ul>
    <div
      class="mt-8 overflow-x-auto rounded-card border border-bordo bg-sfondo-rialzato"
      tabindex="0"
      role="region"
      aria-label="Tabella dei segni di urgenza (scorrevole)"
    >
      <table class="min-w-[40rem] text-sm">
        <caption class="p-4 text-left font-sans text-base font-bold">
          {servizio.data.tabella?.titolo}
        </caption>
        <thead class="bg-sfondo-tinta">
          <tr>
            {servizio.data.tabella?.intestazioni.map((h) => (
              <th scope="col" class="px-4 py-3">
                {h}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {servizio.data.tabella?.righe.map((r) => (
            <tr class="border-t border-bordo align-top">
              {r.map((c, i) =>
                i === 0 ? (
                  <th scope="row" class="px-4 py-3 font-semibold">
                    {c}
                  </th>
                ) : (
                  <td class="px-4 py-3">{c}</td>
                ),
              )}
            </tr>
          ))}
        </tbody>
      </table>
      {servizio.data.tabella?.nota && (
        <p class="px-4 pb-4 text-sm text-testo-secondario">{servizio.data.tabella.nota}</p>
      )}
    </div>
    <div class="mt-8">
      <Bottone
        href={telHref}
        variante="urgenza"
        dimensione="lg"
        icona="telefono"
        evento="click_chiama"
        eventoPosizione="ps-triage"
      >
        Chiama ora · {clinica.contatti.telefono.visualizzato}
      </Bottone>
    </div>
  </Sezione>

  <!-- COME FUNZIONA + FAQ -->
  <Sezione tono="base">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="prosa lg:col-span-7">
        <Etichetta class="mb-3">Come funziona</Etichetta>
        <h2 class="text-3xl md:text-4xl">Cosa succede quando arrivi</h2>
        <p class="mt-4 text-lg">{servizio.data.risposta}</p>
        <ol class="mt-6 space-y-4">
          <li>
            <strong>Valutazione all'arrivo.</strong> Entro pochi minuti un membro dell'équipe valuta
            quanto è grave. Si chiama triage: chi è in pericolo di vita passa per primo.
          </li>
          <li>
            <strong>Stabilizzazione.</strong> Prima degli esami diamo ossigeno, mettiamo una flebo e
            controlliamo il dolore e le emorragie.
          </li>
          <li>
            <strong>Esami.</strong> Esami del sangue con il laboratorio interno, radiografie,
            ecografia e, se serve, TC, senza spostare l'animale.
          </li>
          <li>
            <strong>Decisione insieme a te.</strong> Ti spieghiamo cosa abbiamo trovato, le
            possibilità di cura e i costi. Gli interventi non urgenti partono solo con il tuo
            consenso scritto.
          </li>
          <li>
            <strong>Cura, ricovero o rientro a casa.</strong> Intervento d'urgenza, terapia
            intensiva, oppure dimissione con istruzioni scritte e un controllo fissato.
          </li>
        </ol>
        <h2 class="mt-10 text-2xl md:text-3xl">Chi c'è di notte</h2>
        <p class="mt-3">
          Di notte, dalle 20 alle 9, in clinica ci sono un medico veterinario e un tecnico, oppure
          due medici.
        </p>
        <Referenti medici={turnoNotte} titolo="Il turno di notte" class="mt-6" />
      </div>
      <aside class="lg:col-span-5">
        <h2 class="font-sans text-xl font-bold">Domande frequenti sulle urgenze</h2>
        <dl class="mt-4 divide-y divide-bordo">
          {faqJson.map((f) => (
            <div class="py-4">
              <dt class="font-semibold">{f.domanda}</dt>
              <dd class="mt-1 text-testo-secondario">{f.risposta}</dd>
            </div>
          ))}
        </dl>
      </aside>
    </div>
    <div class="mt-12 grid gap-4 md:grid-cols-2">
      <section
        class="rounded-card border border-bordo bg-sfondo-rialzato p-6"
        aria-labelledby="ps-costi"
      >
        <h2 id="ps-costi" class="flex items-center gap-2 font-sans text-xl font-bold">
          <Icona nome="euro" class="size-5 text-primario-link" /> Costi e pagamento in urgenza
        </h2>
        <ul class="mt-3 space-y-2 text-testo-secondario">
          <li>
            La visita di pronto soccorso ha un onorario indicativo, più alto di notte e nei festivi,
            che ti confermiamo al telefono.
          </li>
          <li>
            Per esami, ricovero e interventi ricevi un{' '}
            <strong class="text-testo">preventivo scritto</strong> prima di procedere. Quando ogni
            minuto conta, ti chiediamo l'autorizzazione a stabilizzare subito e il preventivo arriva
            appena possibile.
          </li>
          <li>
            Paghi alla fine, con carta o contanti. Per i ricoveri lunghi concordiamo con te un
            acconto.
          </li>
        </ul>
      </section>
      <section
        class="rounded-card border border-bordo bg-sfondo-rialzato p-6"
        aria-labelledby="ps-dopo"
      >
        <h2 id="ps-dopo" class="flex items-center gap-2 font-sans text-xl font-bold">
          <Icona nome="stetoscopio" class="size-5 text-primario-link" /> Dopo l'urgenza torni dal
          tuo veterinario
        </h2>
        <p class="mt-3 text-testo-secondario">
          Se il tuo animale è seguito da un altro veterinario, alla dimissione inviamo al collega
          referto, esami e terapie: la continuità delle cure è parte del servizio. Se non hai un
          veterinario di fiducia, ti proponiamo il controllo con noi e un calendario di prevenzione,
          per non arrivare più in urgenza per problemi evitabili.
        </p>
        <a
          href="/per-i-colleghi"
          class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-primario-link"
        >
          Sei un collega? Area referral <Icona nome="freccia-destra" class="size-4" />
        </a>
      </section>
    </div>
    <Fonti fonti={servizio.data.fonti} class="mt-10" />
    <p class="mt-6 text-sm text-testo-secondario">
      Questa pagina ha finalità informative e non sostituisce la visita veterinaria.
    </p>
  </Sezione>

  <Sezione tono="tinta" compatta>
    <TriageRapido compatto />
  </Sezione>
</BaseLayout>
