---
/** "La prima visita": cosa portare, quanto dura, come funziona, costi, parcheggio. Riduce l'attrito del primo contatto. */
import PaginaLayout from '@layouts/PaginaLayout.astro';
import Bottone from '@ui/Bottone.astro';
import CtaDoppia from '@ui/CtaDoppia.astro';
import Dato from '@ui/Dato.astro';
import Faq from '@ui/Faq.astro';
import Icona from '@ui/Icona.astro';
import Sezione from '@ui/Sezione.astro';
import TabellaDati from '@ui/TabellaDati.astro';
import { clinica, daConfermare, indicazioniHref, indirizzoRiga, telHref } from '@lib/clinica';
import { faqPage, medicalWebPage } from '@lib/schema';
import tariffe from '@dati/tariffe.json';

/** Onorario della visita da tariffe.json (mai un numero scritto a mano). */
const voce = (nome: string) =>
  tariffe.sezioni.flatMap((x) => x.voci).find((v) => v.prestazione === nome);
const visita = voce('Visita clinica generale');
const visitaEsotici = voce('Visita animali esotici');
const avvisoTariffe = tariffe.confermato ? '' : ' (importi in fase di aggiornamento)';
const costoVisita = visita
  ? `Una visita clinica costa indicativamente tra ${visita.da} e ${visita.a} euro${visitaEsotici ? `; per gli animali esotici, conigli compresi, tra ${visitaEsotici.da} e ${visitaEsotici.a} euro` : ''}${avvisoTariffe}.`
  : 'La visita ha un onorario indicativo che ti comunichiamo al momento della prenotazione.';

const descrizione =
  'Come funziona la prima visita alla Clinica Veterinaria del bosco di Portici: cosa portare, quanto dura (30-40 minuti), quanto costa e come prenotare.';
const passi = [
  [
    'Prenoti',
    'Online, in un minuto, o al telefono. Ti contattiamo per confermare giorno e ora e per dirti se deve essere a digiuno.',
  ],
  [
    'Arrivi',
    "Presentati in reception 5 minuti prima. Il gatto nel trasportino coperto, il cane al guinzaglio corto, il coniglio nel trasportino con un po' di fieno.",
  ],
  [
    'La visita',
    "Il medico ascolta la storia e visita l'animale. Se servono esami, prima ti dà un preventivo scritto: nessun esame parte senza il tuo consenso.",
  ],
  [
    'Esci con un piano',
    'Ricevi un referto scritto, le terapie, la data del prossimo controllo e i recapiti per i dubbi. Se ti interessa, ti spieghiamo anche i Piani Salute.',
  ],
];
const faq = [
  {
    domanda: 'Quanto dura la prima visita?',
    risposta:
      'Di solito 30-40 minuti, più di un controllo normale, perché raccogliamo tutta la storia del tuo animale. Se servono esami del sangue o radiografie, il tempo si allunga e te lo diciamo prima.',
  },
  {
    domanda: 'Devo portare il libretto e i referti precedenti?',
    risposta:
      'Sì, se li hai: libretto sanitario, vaccinazioni, esami e referti di altre strutture, elenco dei farmaci e degli antiparassitari in uso, e il tipo di alimento. Se non li trovi, vieni comunque: ricostruiamo insieme.',
  },
  {
    domanda: 'Il mio animale deve essere a digiuno?',
    risposta:
      "Per una visita semplice no. Se sono previsti esami del sangue, ecografia dell'addome o sedazione, sì: te lo diciamo quando confermiamo l'appuntamento, con le ore esatte. L'acqua resta sempre a disposizione.",
  },
  {
    domanda: 'Quanto costa e come si paga?',
    risposta: `${costoVisita} Per ogni esame o intervento in più ricevi prima un preventivo scritto. Paghi alla fine, con carta o contanti.`,
  },
  {
    domanda: 'Posso venire senza appuntamento?',
    risposta:
      'Per le urgenze sì, a qualsiasi ora. Per le visite programmate ti chiediamo di prenotare: così non aspetti e il medico ha il tempo giusto per te.',
  },
  {
    domanda: 'Visitate anche conigli, rettili e uccelli?',
    risposta:
      "Sì. Gli animali esotici sono seguiti dalla Dott.ssa Isabella Rosapane. Dillo quando prenoti, così scegliamo l'orario giusto.",
  },
];
---

<PaginaLayout
  titolo="Prima visita dal veterinario a Portici"
  descrizione={descrizione}
  percorso="/prima-visita"
  h1="La prima visita: come funziona"
  sottotitolo={`La prima visita alla ${clinica.nome} dura di solito 30-40 minuti. Il medico raccoglie la storia del tuo animale, lo visita dalla testa alla coda e ti spiega cosa ha trovato. ${visita ? `Costa indicativamente tra ${visita.da} e ${visita.a} euro.` : ''} Prenoti online o al ${clinica.contatti.telefono.visualizzato}.`}
  etichetta="Nuovi pazienti"
  briciole={[{ nome: 'La prima visita', href: '/prima-visita' }]}
  jsonLd={[
    medicalWebPage({
      url: '/prima-visita',
      titolo: 'La prima visita',
      descrizione,
      briciole: [{ nome: 'La prima visita', href: '/prima-visita' }],
    }),
    faqPage(faq),
  ]}
>
  <Sezione>
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <ol class="grid gap-4 sm:grid-cols-2">
          {passi.map(([t, d], i) => (
            <li class="flex gap-4 rounded-card border border-bordo bg-sfondo-rialzato p-5">
              <span
                class="flex size-10 shrink-0 items-center justify-center rounded-full bg-primario-tenue font-display text-lg font-bold text-primario-link"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <div>
                <h2 class="font-sans text-lg font-bold">{t}</h2>
                <p class="mt-1 text-testo-secondario">{d}</p>
              </div>
            </li>
          ))}
        </ol>
        <TabellaDati
          class="mt-10"
          tabella={{
            titolo: 'Cosa portare alla prima visita',
            intestazioni: ['Cosa', 'Perché', "Se non ce l'hai"],
            righe: [
              [
                'Libretto sanitario o vaccinazioni',
                'Sapere cosa è già stato fatto ed evitare doppioni',
                'Ricostruiamo la storia insieme',
              ],
              [
                'Referti ed esami precedenti',
                'Confrontare i valori nel tempo',
                'Possiamo richiederli alla struttura precedente',
              ],
              [
                'Farmaci e antiparassitari in uso',
                'Evitare interazioni e capire la protezione attuale',
                'Una foto delle confezioni basta',
              ],
              [
                'Nome e quantità del cibo',
                'Valutare peso e nutrizione',
                'Descrivi cosa mangia e quanto',
              ],
              [
                'Campione di feci fresche (cuccioli)',
                'Serve a cercare i parassiti',
                'Lo porti alla visita dopo',
              ],
              [
                'Trasportino coperto (gatto, coniglio)',
                'Meno stress in attesa e in sala',
                'Ne abbiamo alcuni a disposizione: chiedi in reception',
              ],
            ],
            nota: 'Se hai dubbi su cosa portare, chiama: la reception ti guida.',
          }}
        />
        <Faq voci={faq} titolo="Domande frequenti sulla prima visita" class="mt-12" />
        <p class="mt-8 text-sm text-testo-secondario">
          Questa pagina ha finalità informative e non sostituisce la visita veterinaria.
        </p>
      </div>
      <aside class="space-y-5 lg:col-span-4">
        <div class="rounded-card bg-sfondo-inverso p-5 text-testo-inverso">
          <p class="font-sans text-lg font-bold">Prenota la prima visita</p>
          <p class="mt-1 text-sm text-testo-inverso/80">Quattro domande, un minuto.</p>
          <Bottone href="/prenota" variante="inverso" pieno class="mt-4" icona="calendario">
            Prenota online
          </Bottone>
          <p class="mt-3 text-sm text-testo-inverso/80">
            Oppure chiama il{' '}
            <a href={telHref} class="font-semibold text-testo-inverso">
              {clinica.contatti.telefono.visualizzato}
            </a>
            .
          </p>
        </div>
        <div class="rounded-card border border-bordo bg-sfondo-rialzato p-5 text-sm">
          <h2 class="flex items-center gap-2 font-sans text-base font-bold">
            <Icona nome="mappa" class="size-5 text-primario-link" /> Dove siamo
          </h2>
          <p class="mt-2">{indirizzoRiga}</p>
          {!daConfermare(clinica.indirizzo.riferimenti) && (
            <p class="text-testo-secondario">{clinica.indirizzo.riferimenti}</p>
          )}
          <p class="mt-2">
            <strong>Parcheggio:</strong> <Dato valore={clinica.indirizzo.parcheggio} />
          </p>
          <a
            href={indicazioniHref}
            target="_blank"
            rel="noopener"
            class="mt-3 inline-flex items-center gap-1 font-semibold text-primario-link"
            data-evento="click_indicazioni"
            data-evento-posizione="prima-visita"
          >
            Indicazioni stradali <Icona nome="esterno" class="size-4" />
          </a>
        </div>
        <div class="rounded-card border border-bordo bg-sfondo-rialzato p-5 text-sm">
          <h2 class="flex items-center gap-2 font-sans text-base font-bold">
            <Icona nome="gatto" class="size-5 text-primario-link" /> Gatti: percorso a basso stress
          </h2>
          <p class="mt-2 text-testo-secondario">
            Trasportino coperto, attese brevi, manipolazione gentile.{' '}
            <a href="/servizi/gatto-cat-friendly" class="font-semibold text-primario-link">
              Come funziona →
            </a>
          </p>
        </div>
      </aside>
    </div>
  </Sezione>
  <Sezione compatta>
    <CtaDoppia posizione="prima-visita" />
  </Sezione>
</PaginaLayout>
