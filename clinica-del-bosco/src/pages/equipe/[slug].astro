---
import { getCollection, render } from 'astro:content';
import PaginaLayout from '@layouts/PaginaLayout.astro';
import Badge from '@ui/Badge.astro';
import CtaDoppia from '@ui/CtaDoppia.astro';
import Dato from '@ui/Dato.astro';
import Foto from '@ui/Foto.astro';
import Sezione from '@ui/Sezione.astro';
import { physician, webPage } from '@lib/schema';
import { daConfermare } from '@lib/clinica';

export async function getStaticPaths() {
  const medici = await getCollection('equipe');
  return medici.map((m) => ({ params: { slug: m.id }, props: { medico: m } }));
}
const { medico } = Astro.props;
const { Content } = await render(medico);
const servizi = await getCollection('servizi');
const aree = servizi.filter((s) => medico.data.aree.includes(s.id));
const nome = `${medico.data.titolo} ${medico.data.nome}`;
const url = `/equipe/${medico.id}`;
const descrizione = `${nome}, ${medico.data.ruolo} della Clinica Veterinaria del Bosco di Portici. Aree di attività, formazione e numero di iscrizione all'Ordine dei Medici Veterinari.`;
---

<PaginaLayout
  titolo={`${nome} — medico veterinario a Portici`}
  descrizione={descrizione}
  percorso={url}
  h1={nome}
  sottotitolo={medico.data.ruolo}
  etichetta="Équipe"
  briciole={[
    { nome: 'Équipe', href: '/equipe' },
    { nome: nome, href: url },
  ]}
  jsonLd={[
    webPage({ url, titolo: nome, descrizione, tipo: 'AboutPage' }),
    physician({
      slug: medico.id,
      nome: medico.data.nome,
      titolo: medico.data.titolo,
      ruolo: medico.data.ruolo,
      specializzazioni: medico.data.specializzazioni,
      numeroOrdine: medico.data.numeroOrdine,
      provinciaOrdine: medico.data.provinciaOrdine,
    }),
  ]}
>
  <Sezione>
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <Foto
          ratio="4/5"
          scattoBrief={medico.data.scattoBrief}
          descrizioneSegnaposto={`Ritratto di ${nome}`}
        />
        <dl class="mt-6 space-y-3 text-sm">
          <div>
            <dt class="font-bold uppercase tracking-wider text-testo-secondario">
              Iscrizione all'Ordine
            </dt>
            <dd>
              Ordine dei Medici Veterinari di <Dato valore={medico.data.provinciaOrdine} /> n.{' '}
              <Dato valore={medico.data.numeroOrdine} />
            </dd>
          </div>
          {medico.data.direttoreSanitario && (
            <div>
              <dt class="sr-only">Incarico</dt>
              <dd>
                <Badge tono="primario">Direttore sanitario</Badge>
              </dd>
            </div>
          )}
          {medico.data.socio && (
            <div>
              <dt class="sr-only">Qualifica</dt>
              <dd>
                <Badge tono="neutro">Socio fondatore</Badge>
              </dd>
            </div>
          )}
          <div>
            <dt class="font-bold uppercase tracking-wider text-testo-secondario">Lingue</dt>
            <dd>{medico.data.lingue.join(', ')}</dd>
          </div>
        </dl>
      </div>
      <div class="lg:col-span-8">
        {medico.data.daValidare && (
          <p class="mb-6 rounded-card bg-avviso-tenue p-4 text-sm text-avviso">
            Scheda in attesa di validazione da parte del medico: biografia, specializzazioni e
            numero di iscrizione verranno completati prima della pubblicazione.
          </p>
        )}
        <h2 class="text-2xl">Aree di attività</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {medico.data.specializzazioni.map((s) => (
            <li>{daConfermare(s) ? <Dato valore={s} /> : <Badge tono="primario">{s}</Badge>}</li>
          ))}
        </ul>
        {medico.data.formazione.length > 0 && (
          <>
            <h2 class="mt-8 text-2xl">Formazione</h2>
            <ul class="mt-3 list-disc space-y-1 pl-5">
              {medico.data.formazione.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          </>
        )}
        <div class="prosa-md mt-8">
          <Content />
        </div>
        {aree.length > 0 && (
          <>
            <h2 class="mt-10 text-2xl">Servizi seguiti</h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {aree.map((s) => (
                <li>
                  <a
                    href={`/servizi/${s.id}`}
                    class="inline-flex min-h-10 items-center rounded-pill border border-bordo px-4 text-sm font-semibold no-underline hover:border-primario hover:text-primario-link"
                  >
                    {s.data.titoloBreve}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </div>
  </Sezione>
  <Sezione compatta>
    <CtaDoppia posizione="equipe-scheda" />
  </Sezione>
</PaginaLayout>
