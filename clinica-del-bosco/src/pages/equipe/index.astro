---
/** Équipe: soci, medici della clinica e specialisti in collaborazione, con aree seguite e giorni di presenza. */
import { getCollection } from 'astro:content';
import PaginaLayout from '@layouts/PaginaLayout.astro';
import Badge from '@ui/Badge.astro';
import Dato from '@ui/Dato.astro';
import Foto from '@ui/Foto.astro';
import Icona from '@ui/Icona.astro';
import Sezione from '@ui/Sezione.astro';
import CtaDoppia from '@ui/CtaDoppia.astro';
import { clinica, direttoreSanitarioRiga } from '@lib/clinica';
import { webPage } from '@lib/schema';

const medici = (await getCollection('equipe')).sort((a, b) => a.data.ordine - b.data.ordine);
const servizi = await getCollection('servizi');
const titoloServizio = (id: string) => servizi.find((s) => s.id === id)?.data.titoloBreve ?? id;

const gruppi: Array<{ tipo: 'socio' | 'interno' | 'freelance'; titolo: string; testo: string }> = [
  {
    tipo: 'socio',
    titolo: 'I soci fondatori',
    testo:
      'Quattro medici veterinari che hanno fondato la clinica e la dirigono, ciascuno con la propria area clinica.',
  },
  {
    tipo: 'interno',
    titolo: 'I medici della clinica',
    testo:
      "L'équipe interna che copre i turni diurni, la sala operatoria, la degenza e il pronto soccorso notturno.",
  },
  {
    tipo: 'freelance',
    titolo: 'Gli specialisti in collaborazione',
    testo:
      'Specialisti che lavorano in clinica con giornate di presenza programmate: la reception fissa la visita nel giorno giusto.',
  },
];
const descrizione =
  'I medici veterinari della Clinica Veterinaria del Bosco di Portici: soci fondatori, équipe interna e specialisti in collaborazione con giorni di presenza fissi. Aree seguite e iscrizione all’Ordine.';
---

<PaginaLayout
  titolo="Équipe medica"
  descrizione={descrizione}
  percorso="/equipe"
  h1="L'équipe"
  sottotitolo="Medici veterinari presenti in struttura giorno e notte, più gli specialisti che ricevono in giornate programmate. Ogni scheda riporta ruolo, aree seguite e numero di iscrizione all'Ordine."
  etichetta="Chi si prende cura del tuo animale"
  briciole={[{ nome: 'Équipe', href: '/equipe' }]}
  jsonLd={[webPage({ url: '/equipe', titolo: 'Équipe medica', descrizione, tipo: 'AboutPage' })]}
>
  <Sezione>
    <p class="mb-8 rounded-card border border-bordo bg-sfondo-rialzato p-4 text-sm">
      <strong>Direttore sanitario:</strong> <Dato valore={direttoreSanitarioRiga} />
    </p>
    {gruppi.map((g) => {
      const lista = medici.filter((m) => m.data.tipo === g.tipo);
      if (!lista.length) return null;
      return (
        <section class="mb-14 last:mb-0" aria-labelledby={`equipe-${g.tipo}`}>
          <h2 id={`equipe-${g.tipo}`} class="text-2xl md:text-3xl">
            {g.titolo}
          </h2>
          <p class="mt-2 max-w-prose text-testo-secondario">{g.testo}</p>
          <ul
            class:list={[
              'mt-6 grid gap-6 sm:grid-cols-2',
              g.tipo === 'socio' ? 'lg:grid-cols-4' : 'lg:grid-cols-3',
            ]}
          >
            {lista.map((m) => (
              <li>
                <a
                  href={`/equipe/${m.id}`}
                  class="group flex h-full flex-col rounded-card border border-bordo bg-sfondo-rialzato p-4 no-underline shadow-card transition hover:-translate-y-0.5 hover:border-primario"
                >
                  {g.tipo === 'socio' && (
                    <Foto
                      ratio="4/5"
                      scattoBrief={m.data.scattoBrief}
                      descrizioneSegnaposto={`Ritratto di ${m.data.titolo} ${m.data.nome}`}
                    />
                  )}
                  <h3 class="mt-4 font-sans text-lg font-bold text-testo">
                    {m.data.titolo} {m.data.nome}
                  </h3>
                  <p class="text-sm text-testo-secondario">{m.data.ruolo}</p>
                  {m.data.direttoreSanitario && (
                    <p class="mt-2">
                      <Badge tono="primario">Direttore sanitario</Badge>
                    </p>
                  )}
                  {m.data.aree.length > 0 && (
                    <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Servizi seguiti">
                      {m.data.aree.map((a) => (
                        <li class="rounded-pill bg-sfondo px-2.5 py-0.5 text-xs font-semibold text-testo">
                          {titoloServizio(a)}
                        </li>
                      ))}
                    </ul>
                  )}
                  {m.data.presenza && (
                    <p class="mt-3 flex items-center gap-1.5 text-sm">
                      <Icona nome="calendario" class="size-4 shrink-0 text-primario-link" />
                      {m.data.presenza}
                    </p>
                  )}
                  {m.data.numeroOrdine && m.data.provinciaOrdine && (
                    <p class="mt-3 text-sm">
                      <span class="text-testo-secondario">Ordine di</span> {m.data.provinciaOrdine}{' '}
                      <span class="text-testo-secondario">n.</span> {m.data.numeroOrdine}
                    </p>
                  )}
                  <span class="mt-auto inline-flex items-center gap-1 pt-3 text-sm font-semibold text-primario-link">
                    Scheda{' '}
                    <Icona
                      nome="freccia-destra"
                      class="size-4 transition group-hover:translate-x-0.5"
                    />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })}
    <p class="mt-10 max-w-prose text-testo-secondario">
      L'équipe della {clinica.nome} comprende anche personale di assistenza tecnica e reception. Le
      schede vengono aggiornate a ogni nuovo ingresso e validate dai singoli medici.
    </p>
  </Sezione>
  <Sezione compatta>
    <CtaDoppia posizione="equipe" />
  </Sezione>
</PaginaLayout>
