---
/** Équipe: medici, ruoli, specializzazioni e numero di iscrizione all'Ordine. */
import { getCollection } from 'astro:content';
import PaginaLayout from '@layouts/PaginaLayout.astro';
import Dato from '@ui/Dato.astro';
import Foto from '@ui/Foto.astro';
import Icona from '@ui/Icona.astro';
import Sezione from '@ui/Sezione.astro';
import CtaDoppia from '@ui/CtaDoppia.astro';
import { clinica, direttoreSanitarioRiga } from '@lib/clinica';
import { webPage } from '@lib/schema';

const medici = (await getCollection('equipe')).sort((a, b) => a.data.ordine - b.data.ordine);
const descrizione =
  "I medici veterinari della Clinica Veterinaria del Bosco di Portici: soci fondatori, specializzazioni, numeri di iscrizione all'Ordine. Un'équipe presente in struttura 24 ore su 24.";
---

<PaginaLayout
  titolo="Équipe medica"
  descrizione={descrizione}
  percorso="/equipe"
  h1="L'équipe"
  sottotitolo="Medici veterinari presenti in struttura giorno e notte. Ogni scheda riporta ruolo, aree di attività e numero di iscrizione all'Ordine."
  etichetta="Chi si prende cura del tuo animale"
  briciole={[{ nome: 'Équipe', href: '/equipe' }]}
  jsonLd={[webPage({ url: '/equipe', titolo: 'Équipe medica', descrizione, tipo: 'AboutPage' })]}
>
  <Sezione>
    <p class="mb-8 rounded-card border border-bordo bg-sfondo-rialzato p-4 text-sm">
      <strong>Direttore sanitario:</strong> <Dato valore={direttoreSanitarioRiga} />
    </p>
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {medici.map((m) => (
        <li>
          <a
            href={`/equipe/${m.id}`}
            class="group block h-full rounded-card border border-bordo bg-sfondo-rialzato p-4 no-underline shadow-card transition hover:-translate-y-0.5 hover:border-primario"
          >
            <Foto
              ratio="4/5"
              scattoBrief={m.data.scattoBrief}
              descrizioneSegnaposto={`Ritratto di ${m.data.titolo} ${m.data.nome}`}
            />
            <h2 class="mt-4 font-sans text-lg font-bold text-testo">
              {m.data.titolo} {m.data.nome}
            </h2>
            <p class="text-sm text-testo-secondario">{m.data.ruolo}</p>
            <p class="mt-2 text-sm">
              <span class="text-testo-secondario">Ordine di</span>{' '}
              <Dato valore={m.data.provinciaOrdine} /> <span class="text-testo-secondario">n.</span>{' '}
              <Dato valore={m.data.numeroOrdine} />
            </p>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-primario-link">
              Scheda{' '}
              <Icona nome="freccia-destra" class="size-4 transition group-hover:translate-x-0.5" />
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-8 max-w-prose text-testo-secondario">
      L'équipe della {clinica.nome} comprende medici veterinari, personale di assistenza e
      reception. Le schede vengono aggiornate a ogni nuovo ingresso.
    </p>
  </Sezione>
  <Sezione compatta>
    <CtaDoppia posizione="equipe" />
  </Sezione>
</PaginaLayout>
