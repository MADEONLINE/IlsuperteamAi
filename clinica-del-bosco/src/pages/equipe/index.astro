---
/** Équipe: soci, medici della clinica e veterinari che collaborano in giorni fissi, con aree seguite e giorni di presenza. */
import { getCollection } from 'astro:content';
import PaginaLayout from '@layouts/PaginaLayout.astro';
import Badge from '@ui/Badge.astro';
import Dato from '@ui/Dato.astro';
import Foto from '@ui/Foto.astro';
import Icona from '@ui/Icona.astro';
import Sezione from '@ui/Sezione.astro';
import CtaDoppia from '@ui/CtaDoppia.astro';
import Faq from '@ui/Faq.astro';
import { clinica, direttoreSanitarioRiga } from '@lib/clinica';
import { faqPage, webPage } from '@lib/schema';

const medici = (await getCollection('equipe')).sort((a, b) => a.data.ordine - b.data.ordine);
const servizi = await getCollection('servizi');
const titoloServizio = (id: string) => servizi.find((s) => s.id === id)?.data.titoloBreve ?? id;

const gruppi: Array<{ tipo: 'socio' | 'interno' | 'freelance'; titolo: string; testo: string }> = [
  {
    tipo: 'socio',
    titolo: 'I soci fondatori',
    testo:
      'Hanno aperto la clinica nel 2010 e la dirigono ancora oggi. Visitano e operano ogni giorno.',
  },
  {
    tipo: 'interno',
    titolo: 'I medici della clinica',
    testo:
      'Coprono le visite di giorno, la sala operatoria, il ricovero e il pronto soccorso di notte.',
  },
  {
    tipo: 'freelance',
    titolo: 'I veterinari che collaborano con la clinica',
    testo:
      'Vengono in clinica in giorni fissi. Quando prenoti, la reception ti fissa la visita nel giorno in cui sono presenti.',
  },
];
const nInterni = medici.filter((m) => m.data.tipo !== 'freelance').length;
const nCollaboratori = medici.filter((m) => m.data.tipo === 'freelance').length;
const descrizione = `I ${nInterni} medici veterinari della Clinica Veterinaria del Bosco di Portici e gli ${nCollaboratori} colleghi che collaborano in giorni fissi: chi sono e di cosa si occupano.`;
const faq = [
  {
    domanda: 'Chi è il direttore sanitario della clinica?',
    risposta: `Il direttore sanitario della ${clinica.nome} è il ${clinica.direttoreSanitario.titolo} ${clinica.direttoreSanitario.nome}, iscritto all'Ordine dei Medici Veterinari di ${clinica.direttoreSanitario.provinciaOrdine} con il n. ${clinica.direttoreSanitario.numeroOrdine}.`,
  },
  {
    domanda: 'Come prenoto una visita con un veterinario che collabora con la clinica?',
    risposta:
      "Prenota online o al telefono e indica di quale visita hai bisogno, per esempio dermatologia o neurologia. La reception ti fissa l'appuntamento nel giorno in cui il collega è in clinica.",
  },
  {
    domanda: 'Di notte c’è un medico in clinica?',
    risposta:
      'Sì. Dalle 20 alle 9 in clinica ci sono un medico veterinario e un tecnico, oppure due medici.',
  },
];
---

<PaginaLayout
  titolo="L'équipe: i veterinari della Clinica del Bosco, Portici"
  descrizione={descrizione}
  percorso="/equipe"
  h1={`L'équipe della ${clinica.nome}`}
  sottotitolo={`Nella clinica lavorano ${nInterni} medici veterinari, presenti anche di notte. Altri ${nCollaboratori} veterinari collaborano con la clinica in giorni fissi per dermatologia, oculistica, neurologia, ortopedia, endoscopia, ecografia e chirurgia. Per ogni medico trovi di cosa si occupa e, dove disponibile, il numero di iscrizione all'Ordine.`}
  etichetta="Chi si prende cura del tuo animale"
  briciole={[{ nome: 'Équipe', href: '/equipe' }]}
  jsonLd={[
    webPage({ url: '/equipe', titolo: 'Équipe medica', descrizione, tipo: 'AboutPage' }),
    faqPage(faq),
  ]}
>
  <Sezione>
    <p class="mb-8 rounded-card border border-bordo bg-sfondo-rialzato p-4 text-sm">
      <strong>Direttore sanitario:</strong> <Dato valore={direttoreSanitarioRiga} />
    </p>
    {gruppi.map((g) => {
      const lista = medici.filter((m) => m.data.tipo === g.tipo);
      if (!lista.length) return null;
      return (
        <section class="mb-14 last:mb-0" aria-labelledby={`equipe-${g.tipo}`}>
          <h2 id={`equipe-${g.tipo}`} class="text-2xl md:text-3xl">
            {g.titolo}
          </h2>
          <p class="mt-2 max-w-prose text-testo-secondario">{g.testo}</p>
          <ul
            class:list={[
              'mt-6 grid gap-6 sm:grid-cols-2',
              g.tipo === 'socio' ? 'lg:grid-cols-4' : 'lg:grid-cols-3',
            ]}
          >
            {lista.map((m) => (
              <li>
                <a
                  href={`/equipe/${m.id}`}
                  class="group flex h-full flex-col rounded-card border border-bordo bg-sfondo-rialzato p-4 no-underline shadow-card transition hover:-translate-y-0.5 hover:border-primario"
                >
                  {g.tipo === 'socio' && (
                    <Foto
                      ratio="4/5"
                      scattoBrief={m.data.scattoBrief}
                      descrizioneSegnaposto={`Ritratto di ${m.data.titolo} ${m.data.nome}`}
                    />
                  )}
                  <h3 class="mt-4 font-sans text-lg font-bold text-testo">
                    {m.data.titolo} {m.data.nome}
                  </h3>
                  <p class="text-sm text-testo-secondario">{m.data.ruolo}</p>
                  {m.data.direttoreSanitario && (
                    <p class="mt-2">
                      <Badge tono="primario">Direttore sanitario</Badge>
                    </p>
                  )}
                  {m.data.aree.length > 0 && (
                    <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Servizi seguiti">
                      {m.data.aree.map((a) => (
                        <li class="rounded-pill bg-sfondo px-2.5 py-0.5 text-xs font-semibold text-testo">
                          {titoloServizio(a)}
                        </li>
                      ))}
                    </ul>
                  )}
                  {m.data.presenza && (
                    <p class="mt-3 flex items-center gap-1.5 text-sm">
                      <Icona nome="calendario" class="size-4 shrink-0 text-primario-link" />
                      {m.data.presenza}
                    </p>
                  )}
                  {m.data.numeroOrdine && m.data.provinciaOrdine && (
                    <p class="mt-3 text-sm">
                      <span class="text-testo-secondario">Ordine di</span> {m.data.provinciaOrdine}{' '}
                      <span class="text-testo-secondario">n.</span> {m.data.numeroOrdine}
                    </p>
                  )}
                  <span class="mt-auto inline-flex items-center gap-1 pt-3 text-sm font-semibold text-primario-link">
                    Scheda{' '}
                    <Icona
                      nome="freccia-destra"
                      class="size-4 transition group-hover:translate-x-0.5"
                    />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })}
    <p class="mt-10 max-w-prose text-testo-secondario">
      Oltre ai medici, in clinica lavorano tecnici veterinari e personale di reception.
    </p>
    <Faq voci={faq} class="mt-12" />
  </Sezione>
  <Sezione compatta>
    <CtaDoppia posizione="equipe" />
  </Sezione>
</PaginaLayout>
