---
import { getCollection } from 'astro:content';
import ServizioLayout from '@layouts/ServizioLayout.astro';

export async function getStaticPaths() {
  const servizi = await getCollection('servizi');
  return servizi.map((s) => ({ params: { slug: s.id }, props: { servizio: s } }));
}
const { servizio } = Astro.props;
---

<ServizioLayout servizio={servizio} />
