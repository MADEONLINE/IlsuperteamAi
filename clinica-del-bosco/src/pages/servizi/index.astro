---
/** Hub servizi: tutti i servizi raggruppati per area, con i quattro pilastri in evidenza. */
import { getCollection } from 'astro:content';
import PaginaLayout from '@layouts/PaginaLayout.astro';
import CardServizio from '@ui/CardServizio.astro';
import CtaDoppia from '@ui/CtaDoppia.astro';
import Sezione from '@ui/Sezione.astro';
import { webPage } from '@lib/schema';

const servizi = (await getCollection('servizi')).sort((a, b) => a.data.ordine - b.data.ordine);
const gruppi: Array<{ chiave: string; titolo: string; testo: string }> = [
  {
    chiave: 'diagnostica',
    titolo: 'Diagnostica',
    testo:
      'TC, radiologia, ecografia specialistica, endoscopia, laboratorio e citologia nella stessa sede.',
  },
  {
    chiave: 'prevenzione',
    titolo: 'Prevenzione',
    testo:
      'Vaccinazioni, profilassi antiparassitaria e controlli programmati per cane, gatto, coniglio e altri animali non convenzionali.',
  },
  {
    chiave: 'chirurgia',
    titolo: 'Chirurgia',
    testo: "Due sale operatorie per chirurgia di base, specialistica e d'urgenza.",
  },
  {
    chiave: 'esotici',
    titolo: 'Animali esotici',
    testo:
      'Competenza dedicata a tutte le specie esotiche: conigli, cavie, cincillà, criceti, furetti e altri piccoli mammiferi, rettili, uccelli e pesci ornamentali.',
  },
  {
    chiave: 'specialistica',
    titolo: 'Medicina specialistica',
    testo:
      'Cardiologia, medicina interna ed endocrinologia, ortopedia, neurologia, dermatologia, oftalmologia, oncologia, nutrizione, odontostomatologia, terapia del dolore.',
  },
  {
    chiave: 'urgenza',
    titolo: 'Degenza e pronto soccorso',
    testo: 'Ricovero e terapia intensiva nella stessa sede, e un servizio di pronto soccorso.',
  },
];
const descrizione =
  'I servizi della Clinica Veterinaria del bosco a Portici: visite specialistiche, TC, chirurgia, laboratorio, animali esotici, degenza e pronto soccorso.';
---

<PaginaLayout
  titolo="Servizi veterinari a Portici: diagnostica, chirurgia, specialistiche"
  descrizione={descrizione}
  percorso="/servizi"
  h1="Tutti i servizi, in un'unica sede"
  sottotitolo="Dalla visita di routine alla TC, dalla chirurgia alla terapia intensiva: il tuo animale non deve cambiare struttura per essere curato."
  etichetta="Servizi"
  briciole={[{ nome: 'Servizi', href: '/servizi' }]}
  jsonLd={[
    webPage({
      url: '/servizi',
      titolo: 'Servizi veterinari a Portici',
      descrizione,
      tipo: 'CollectionPage',
    }),
  ]}
>
  {gruppi.map((g) => {
    const lista = servizi.filter((s) => s.data.categoria === g.chiave);
    if (!lista.length) return null;
    return (
      <Sezione compatta id={g.chiave}>
        <div class="grid gap-6 lg:grid-cols-12">
          <div class="lg:col-span-3">
            <h2 class="text-2xl md:text-3xl">{g.titolo}</h2>
            <p class="mt-2 text-testo-secondario">{g.testo}</p>
          </div>
          <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-9 lg:grid-cols-3">
            {lista.map((s) => (
              <li>
                <CardServizio servizio={s} />
              </li>
            ))}
          </ul>
        </div>
      </Sezione>
    );
  })}
  <Sezione compatta>
    <CtaDoppia posizione="servizi-hub" />
  </Sezione>
</PaginaLayout>
