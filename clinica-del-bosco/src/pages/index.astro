---
/**
 * Home — sequenza: hero con nome della clinica e tagline sui valori → 4 pilastri → griglia servizi →
 * la struttura (foto grande) → Piani Salute (blocco di conversione) → équipe → recensioni reali
 * (solo se importate) → campagna stagionale in corso + magazine → mappa e contatti.
 */
import { hrefServizio } from '@lib/servizi';
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Bottone from '@ui/Bottone.astro';
import CardServizio from '@ui/CardServizio.astro';
import Icona from '@ui/Icona.astro';
import Etichetta from '@ui/Etichetta.astro';
import Foto from '@ui/Foto.astro';
import Sezione from '@ui/Sezione.astro';
import Dato from '@ui/Dato.astro';
import BarraFiducia from '@sezioni/BarraFiducia.astro';
import {
  clinica,
  daConfermare,
  indicazioniHref,
  indirizzoRiga,
  telHref,
  emailPrincipale,
} from '@lib/clinica';
import { webPage } from '@lib/schema';
import piani from '@dati/piani-salute.json';
import recensioni from '@dati/recensioni.json';

const servizi = (await getCollection('servizi')).sort((a, b) => a.data.ordine - b.data.ordine);
const inEvidenza = servizi.filter((s) => s.data.inEvidenza);
const altri = servizi.filter((s) => !s.data.inEvidenza);
const tuttiIMedici = await getCollection('equipe');
const medici = tuttiIMedici
  .filter((m) => m.data.socio)
  .sort((a, b) => a.data.ordine - b.data.ordine);
const nSpecialisti = tuttiIMedici.filter((m) => m.data.tipo === 'freelance').length;
const nInterni = tuttiIMedici.filter((m) => m.data.tipo !== 'freelance').length;
const articoli = (await getCollection('articoli'))
  .sort((a, b) => b.data.dataPubblicazione.getTime() - a.data.dataPubblicazione.getTime())
  .slice(0, 3);
const mese = new Date().getMonth() + 1;
const campagne = await getCollection('campagne');
const campagnaInCorso =
  campagne.find((c) =>
    c.data.meseInizio <= c.data.meseFine
      ? mese >= c.data.meseInizio && mese <= c.data.meseFine
      : mese >= c.data.meseInizio || mese <= c.data.meseFine,
  ) ?? campagne[0];

/** Tagline della home: i valori della clinica, prima di qualsiasi servizio. */
const tagline = 'Cura, attenzione e rispetto per ogni animale.';

const pilastri = [
  {
    icona: 'scansione',
    titolo: 'TC in sede',
    testo: "L'esame si fa senza spostare l'animale in un'altra struttura.",
    href: '/servizi/tc-diagnostica-avanzata',
  },
  {
    icona: 'bisturi',
    titolo: 'Due sale chirurgiche',
    testo: "Interventi programmati, con ricovero e terapia intensiva dopo l'operazione.",
    href: '/servizi/chirurgia',
  },
  {
    icona: 'provetta',
    titolo: 'Laboratorio interno',
    testo: 'Gli esami del sangue hanno la risposta in giornata.',
    href: '/servizi/laboratorio-analisi',
  },
  {
    icona: 'coniglio',
    titolo: 'Animali esotici',
    testo: 'Un servizio dedicato a conigli, piccoli mammiferi, rettili e uccelli.',
    href: '/servizi/animali-esotici',
  },
] as const;

/** Le tre porte d'ingresso: il visitatore si riconosce prima di cercare il servizio. */
const porte = [
  {
    titolo: 'Cane e gatto',
    testo: 'Visite, vaccini, chirurgia e visite specialistiche',
    href: '/servizi',
    icona: 'cane' as const,
  },
  {
    titolo: 'Animali esotici',
    testo: 'Conigli, piccoli mammiferi, rettili, uccelli',
    href: '/servizi/animali-esotici',
    icona: 'coniglio' as const,
  },
  {
    titolo: 'Sei un veterinario?',
    testo: 'TC, endoscopia, chirurgia e ricovero per i tuoi pazienti',
    href: '/per-i-colleghi',
    icona: 'stetoscopio' as const,
  },
];
const numeri = clinica.numeri.confermato
  ? [
      {
        valore: `${clinica.numeri.clientiAttivi.toLocaleString('it-IT')}+`,
        etichetta: 'famiglie che ci affidano i loro animali',
      },
      {
        valore: `${clinica.numeri.animaliSeguiti.toLocaleString('it-IT')}+`,
        etichetta: 'animali seguiti negli anni',
      },
    ]
  : [];
const recensioniVisibili = recensioni.recensioni.slice(0, 3) as Array<{
  autore: string;
  testo: string;
  stelle: number;
  data: string;
}>;
const euro = (n: number) =>
  n.toLocaleString('it-IT', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
const euroMese = (n: number) =>
  n.toLocaleString('it-IT', {
    style: 'currency',
    currency: 'EUR',
    minimumFractionDigits: Number.isInteger(n) ? 0 : 2,
    maximumFractionDigits: 2,
  });
---

<BaseLayout
  titolo="Clinica Veterinaria del bosco, Portici · Cura per ogni animale"
  descrizione="Clinica veterinaria a Portici (NA) per cani, gatti e animali esotici: visite specialistiche, TC, due sale chirurgiche, laboratorio e degenza. Tel. 081 7763859."
  percorso="/"
  senzaBrand
  jsonLd={[webPage({ url: '/', titolo: clinica.nome, descrizione: clinica.descrizioneBreve })]}
>
  <!-- HERO: il nome della clinica e i suoi valori -->
  <section
    class="relative overflow-hidden bg-sfondo-inverso text-testo-inverso"
    aria-labelledby="hero-titolo"
  >
    <div class="contenitore grid items-center gap-10 py-10 md:py-20 lg:grid-cols-12 lg:py-24">
      <div class="lg:col-span-7">
        <Etichetta tono="inverso" class="mb-3">
          Clinica veterinaria a Portici
        </Etichetta>
        <h1 id="hero-titolo" class="text-4xl text-testo-inverso sm:text-5xl md:text-6xl">
          {clinica.nome}
        </h1>
        <p class="mt-4 font-display text-2xl text-accento-inverso md:text-3xl">{tagline}</p>
        <p class="prosa mt-5 text-lg text-testo-inverso/85 md:text-xl">
          Accogliamo cani, gatti e animali esotici con lo stesso impegno: ascoltiamo chi li ama,
          capiamo di cosa hanno bisogno e li curiamo con competenza e dedizione.
        </p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <Bottone href="/prenota" variante="inverso" dimensione="lg" icona="calendario">
            Prenota una visita
          </Bottone>
          <Bottone
            href="/servizi"
            variante="secondario-inverso"
            dimensione="lg"
            iconaDopo="freccia-destra"
          >
            Scopri i servizi
          </Bottone>
        </div>
        <p class="mt-4 text-sm text-testo-inverso/80">
          È la prima volta da noi?{' '}
          <a href="/prima-visita" class="text-testo-inverso">
            Ecco come funziona la prima visita
          </a>
        </p>
      </div>
      <div class="lg:col-span-5">
        <Foto
          ratio="4/5"
          scattoBrief="44"
          descrizioneSegnaposto="Facciata della clinica di giorno, ingresso e insegna"
          larghezze={[320, 480, 640, 900]}
          sizes="(min-width: 1024px) 34vw, 88vw"
          priorita
          class="ring-1 ring-sfondo/15"
        />
      </div>
    </div>
  </section>

  <BarraFiducia />

  <!-- PILASTRI -->
  <Sezione tono="base" etichettaAria="Ciò che rende la clinica un punto di riferimento">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4">
        <Etichetta class="mb-3">Perché sceglierci</Etichetta>
        <h2 class="text-3xl md:text-4xl">Cosa trovi nella stessa sede</h2>
        <p class="mt-4 text-testo-secondario">
          Alla {clinica.nome} visite, esami, chirurgia e ricovero sono nello stesso edificio. Se il
          tuo animale ha bisogno di una TC o di un intervento, non lo devi portare in un'altra
          struttura.
        </p>
        {numeri.length > 0 && (
          <dl class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3 lg:grid-cols-1">
            {numeri.map((n) => (
              <div class="border-l-4 border-primario pl-4">
                <dd class="font-display text-3xl font-bold tabular-nums">{n.valore}</dd>
                <dt class="text-sm text-testo-secondario">{n.etichetta}</dt>
              </div>
            ))}
          </dl>
        )}
      </div>
      <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-8">
        {pilastri.map((p) => (
          <li class="rivela">
            <a
              href={p.href}
              class="group flex h-full flex-col gap-3 rounded-card border border-bordo bg-sfondo-rialzato p-6 no-underline shadow-card transition hover:-translate-y-0.5 hover:border-primario"
            >
              <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-primario-tenue text-primario-link">
                <Icona nome={p.icona} class="size-6" />
              </span>
              <h3 class="font-sans text-xl font-bold">{p.titolo}</h3>
              <p class="text-testo-secondario">{p.testo}</p>
              <span class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-primario-link">
                Leggi: {p.titolo.toLowerCase()}{' '}
                <Icona
                  nome="freccia-destra"
                  class="size-4 transition group-hover:translate-x-0.5"
                />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Sezione>

  <!-- PORTE D'INGRESSO: da chi sei, a dove vuoi andare -->
  <Sezione tono="base" compatta etichettaAria="Da dove vuoi cominciare">
    <ul class="grid gap-4 md:grid-cols-3">
      {porte.map((p) => (
        <li class="rivela">
          <a
            href={p.href}
            class="group flex h-full items-center gap-4 rounded-card border border-bordo bg-sfondo-rialzato p-5 no-underline shadow-card transition hover:-translate-y-0.5 hover:border-primario"
          >
            <span class="inline-flex size-14 shrink-0 items-center justify-center rounded-2xl bg-primario-tenue text-primario-link">
              <Icona nome={p.icona} class="size-7" />
            </span>
            <span class="min-w-0">
              <span class="block font-sans text-lg font-bold text-testo group-hover:text-primario-link">
                {p.titolo}
              </span>
              <span class="block text-sm text-testo-secondario">{p.testo}</span>
            </span>
            <Icona
              nome="freccia-destra"
              class="ml-auto size-5 shrink-0 text-primario-link transition group-hover:translate-x-0.5"
            />
          </a>
        </li>
      ))}
    </ul>
  </Sezione>

  <!-- SERVIZI -->
  <Sezione tono="tinta" id="servizi" etichettaAria="I servizi della clinica">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <Etichetta class="mb-3">Servizi</Etichetta>
        <h2 class="text-3xl md:text-4xl">Dalla visita di routine alla terapia intensiva</h2>
      </div>
      <a href="/servizi" class="inline-flex items-center gap-1 font-semibold text-primario-link">
        Tutti i servizi <Icona nome="freccia-destra" class="size-4" />
      </a>
    </div>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {inEvidenza.map((s) => (
        <li class="rivela">
          <CardServizio servizio={s} />
        </li>
      ))}
    </ul>
    {altri.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2" aria-label="Altri servizi">
        {altri.map((s) => (
          <li>
            <a
              href={hrefServizio(s.id)}
              class="inline-flex min-h-10 items-center gap-1.5 rounded-pill border border-bordo bg-sfondo-rialzato px-4 text-sm font-semibold no-underline hover:border-primario hover:text-primario-link"
            >
              {s.data.titoloBreve}
            </a>
          </li>
        ))}
      </ul>
    )}
  </Sezione>

  <!-- LA STRUTTURA -->
  <section class="bg-sfondo" aria-labelledby="struttura-titolo">
    <div class="grid lg:grid-cols-12">
      <div class="lg:col-span-7">
        <Foto
          ratio="3/2"
          scattoBrief="31"
          descrizioneSegnaposto="Sala chirurgica con équipe al lavoro"
          sizes="(min-width: 1024px) 58vw, 100vw"
          riempi
          class="rounded-none lg:min-h-full"
        />
      </div>
      <div class="flex flex-col justify-center px-gutter py-12 lg:col-span-5 lg:pl-12 lg:pr-gutter">
        <Etichetta class="mb-3">La struttura</Etichetta>
        <h2 id="struttura-titolo" class="text-3xl md:text-4xl">
          Due sale chirurgiche, terapia intensiva e TC, nella stessa sede.
        </h2>
        <ul class="mt-6 space-y-3">
          {[
            'Terapia intensiva con ossigeno e controllo continuo di cuore e respiro',
            'TC, endoscopia, radiografie ed ecografia nella stessa sede',
            'Laboratorio analisi interno con risposta in giornata',
            'Zona separata per gli animali esotici',
          ].map((t) => (
            <li class="flex items-start gap-3">
              <Icona nome="check" class="mt-1 size-5 shrink-0 text-successo" />
              <span>{t}</span>
            </li>
          ))}
        </ul>
        <div class="mt-8">
          <Bottone href="/la-struttura" variante="secondario" iconaDopo="freccia-destra">
            Com'è fatta la clinica
          </Bottone>
        </div>
      </div>
    </div>
  </section>

  <!-- PIANI SALUTE -->
  <Sezione tono="inverso" id="piani-salute" etichettaAria="Piani Salute in abbonamento">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <Etichetta tono="inverso" class="mb-3">
          Piani Salute
        </Etichetta>
        <h2 class="text-3xl text-testo-inverso md:text-4xl">
          Piani Salute: la prevenzione di un anno, a rata fissa.
        </h2>
        <p class="mt-4 text-testo-inverso/85">
          Visite, vaccini, antiparassitari ed esami del sangue in un calendario di 12 mesi, con una
          rata mensile fissa. Ci sono tre piani: Cucciolo &amp; Gattino, Adulto, Senior. La clinica
          ti ricorda ogni appuntamento.
        </p>
        <div class="mt-6">
          <Bottone
            href="/piani-salute"
            variante="inverso"
            dimensione="lg"
            iconaDopo="freccia-destra"
          >
            Confronta i piani
          </Bottone>
        </div>
      </div>
      <ul class="grid gap-4 sm:grid-cols-3 lg:col-span-7">
        {piani.piani.map((p) => (
          <li
            class:list={[
              'rounded-card p-5',
              p.evidenziato
                ? 'bg-sfondo text-testo'
                : 'bg-sfondo/10 text-testo-inverso ring-1 ring-sfondo/20',
            ]}
          >
            <p class="font-sans text-lg font-bold">{p.nome}</p>
            <p
              class:list={[
                'text-sm',
                p.evidenziato ? 'text-testo-secondario' : 'text-testo-inverso/75',
              ]}
            >
              {p.sottotitolo}
            </p>
            <p class="mt-4 font-display text-3xl font-bold tabular-nums">
              {euroMese(p.prezzoAnnuo / piani.rateMensili)}
              <span class="text-base font-normal">/mese</span>
            </p>
            <p
              class:list={[
                'text-sm',
                p.evidenziato ? 'text-testo-secondario' : 'text-testo-inverso/75',
              ]}
            >
              oppure {euro(p.prezzoAnnuo)} l'anno
            </p>
            <a
              href={`/piani-salute#${p.id}`}
              class:list={[
                'mt-4 inline-flex items-center gap-1 text-sm font-semibold',
                p.evidenziato ? 'text-primario-link' : 'text-accento-inverso',
              ]}
            >
              Cosa include <Icona nome="freccia-destra" class="size-4" />
            </a>
          </li>
        ))}
      </ul>
    </div>
    {!piani.prezziConfermati && (
      <p class="mt-6 text-sm text-testo-inverso/70">Importi indicativi in fase di conferma.</p>
    )}
  </Sezione>

  <!-- ÉQUIPE -->
  <Sezione etichettaAria="L'équipe medica">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <Etichetta class="mb-3">Équipe</Etichetta>
        <h2 class="text-3xl md:text-4xl">Chi ti visita</h2>
        <p class="mt-3 max-w-prose text-testo-secondario">
          Nella clinica lavorano {nInterni} medici veterinari: 4 sono i soci fondatori. Altri{' '}
          {nSpecialisti} veterinari collaborano con la clinica in giorni fissi per dermatologia,
          oculistica, neurologia, ortopedia, endoscopia, ecografia e chirurgia.
        </p>
      </div>
      <a href="/equipe" class="inline-flex items-center gap-1 font-semibold text-primario-link">
        Tutta l'équipe <Icona nome="freccia-destra" class="size-4" />
      </a>
    </div>
    <ul class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {medici.map((m) => (
        <li class="rivela">
          <a href={`/equipe/${m.id}`} class="group block no-underline">
            <Foto
              ratio="4/5"
              scattoBrief={m.data.scattoBrief}
              descrizioneSegnaposto={`Ritratto di ${m.data.titolo} ${m.data.nome}`}
            />
            <p class="mt-3 font-sans font-bold text-testo group-hover:text-primario-link">
              {m.data.titolo} {m.data.nome}
            </p>
            <p class="text-sm text-testo-secondario">{m.data.ruolo}</p>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-sm text-testo-secondario">
      Direttore sanitario:{' '}
      <Dato valore={`${clinica.direttoreSanitario.titolo} ${clinica.direttoreSanitario.nome}`} />
    </p>
  </Sezione>

  <!-- PERCORSO GATTO -->
  <section class="bg-sfondo-tinta" aria-labelledby="gatto-titolo">
    <div class="grid lg:grid-cols-12">
      <div class="flex flex-col justify-center px-gutter py-12 lg:col-span-5 lg:pl-gutter lg:pr-12">
        <Etichetta class="mb-3">Percorso gatto</Etichetta>
        <h2 id="gatto-titolo" class="text-3xl md:text-4xl">
          Per il gatto, una visita pensata su misura.
        </h2>
        <p class="mt-4 text-testo-secondario">
          Teniamo il trasportino coperto e l'attesa breve. Visitiamo il gatto in un ambulatorio
          tranquillo, con movimenti lenti e senza forzarlo. Anche il ricovero dei gatti è separato
          da quello dei cani.
        </p>
        <ul class="mt-6 space-y-3">
          {[
            'Attesa separata e trasportino tenuto coperto',
            'Contenimento gentile, senza forzature',
            'Degenza dei gatti lontana dai cani',
          ].map((t) => (
            <li class="flex items-start gap-3">
              <Icona nome="check" class="mt-1 size-5 shrink-0 text-successo" />
              <span>{t}</span>
            </li>
          ))}
        </ul>
        <div class="mt-8">
          <Bottone
            href="/servizi/gatto-cat-friendly"
            variante="secondario"
            iconaDopo="freccia-destra"
          >
            Come accogliamo i gatti
          </Bottone>
        </div>
      </div>
      <div class="lg:col-span-7">
        <Foto
          ratio="3/2"
          scattoBrief="20"
          sizes="(min-width: 1024px) 58vw, 100vw"
          riempi
          class="rounded-none lg:min-h-full"
        />
      </div>
    </div>
  </section>

  <!-- RECENSIONI (solo reali) -->
  {recensioniVisibili.length > 0 && (
    <Sezione tono="tinta" etichettaAria="Recensioni dei clienti">
      <Etichetta class="mb-3">Dicono di noi</Etichetta>
      <h2 class="text-3xl md:text-4xl">Recensioni pubblicate su Google</h2>
      <ul class="mt-8 grid gap-4 md:grid-cols-3">
        {recensioniVisibili.map((r) => (
          <li class="rounded-card border border-bordo bg-sfondo-rialzato p-5">
            <p class="flex gap-0.5 text-avviso" aria-label={`${r.stelle} stelle su 5`}>
              {Array.from({ length: r.stelle }).map(() => (
                <Icona nome="stella" class="size-4 fill-current" />
              ))}
            </p>
            <blockquote class="mt-3">{r.testo}</blockquote>
            <p class="mt-3 text-sm text-testo-secondario">
              {r.autore} · {r.data}
            </p>
          </li>
        ))}
      </ul>
      {!daConfermare(recensioni.fonteUrl) && (
        <a
          href={recensioni.fonteUrl}
          target="_blank"
          rel="noopener"
          class="mt-4 inline-block text-sm font-semibold text-primario-link"
        >
          Tutte le recensioni su Google
        </a>
      )}
    </Sezione>
  )}

  <!-- CAMPAGNA + MAGAZINE -->
  <Sezione etichettaAria="Campagna stagionale e magazine">
    <div class="grid gap-8 lg:grid-cols-12">
      {campagnaInCorso && (
        <a
          href={`/campagne/${campagnaInCorso.id}`}
          class="group flex flex-col justify-between rounded-card bg-primario-tenue p-6 no-underline lg:col-span-5 md:p-8"
        >
          <div>
            <Etichetta class="mb-3">In questo periodo · {campagnaInCorso.data.periodo}</Etichetta>
            <h2 class="text-2xl text-testo md:text-3xl">{campagnaInCorso.data.titolo}</h2>
            <p class="mt-3 text-testo-secondario">{campagnaInCorso.data.sottotitolo}</p>
          </div>
          <span class="mt-6 inline-flex items-center gap-1 font-semibold text-primario-link">
            {campagnaInCorso.data.ctaTesto}{' '}
            <Icona nome="freccia-destra" class="size-4 transition group-hover:translate-x-0.5" />
          </span>
        </a>
      )}
      <div class="lg:col-span-7">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <Etichetta class="mb-3">Magazine</Etichetta>
            <h2 class="text-2xl md:text-3xl">Guide scritte dai nostri medici</h2>
          </div>
          <a
            href="/magazine"
            class="inline-flex items-center gap-1 font-semibold text-primario-link"
          >
            Tutti gli articoli <Icona nome="freccia-destra" class="size-4" />
          </a>
        </div>
        <ul class="mt-6 divide-y divide-bordo">
          {articoli.map((a) => (
            <li class="py-4">
              <a href={`/magazine/${a.id}`} class="group block no-underline">
                <p class="text-xs font-bold uppercase tracking-wider text-testo-secondario">
                  {a.data.tag.slice(0, 2).join(' · ')} · {a.data.tempoLettura} min
                </p>
                <h3 class="mt-1 font-sans text-lg font-bold text-testo group-hover:text-primario-link">
                  {a.data.titolo}
                </h3>
                <p class="mt-1 text-sm text-testo-secondario">{a.data.descrizioneMeta}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Sezione>

  <!-- MAPPA E CONTATTI -->
  <Sezione tono="tinta" id="contatti" etichettaAria="Dove siamo e contatti">
    <div class="grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <Etichetta class="mb-3">Dove siamo</Etichetta>
        <h2 class="text-3xl md:text-4xl">{indirizzoRiga}</h2>
        <p class="mt-4 text-testo-secondario">
          Sei a pochi minuti dall'uscita Portici-Ercolano dell'autostrada A3 e dalle stazioni di
          Portici.
        </p>
        <ul class="mt-6 space-y-3">
          <li class="flex items-center gap-3">
            <Icona nome="telefono" class="size-5 text-primario-link" />
            <a
              href={telHref}
              class="font-semibold"
              data-evento="click_chiama"
              data-evento-posizione="home-contatti"
            >
              {clinica.contatti.telefono.visualizzato}
            </a>
          </li>
          <li class="flex items-center gap-3">
            <Icona nome="mail" class="size-5 text-primario-link" />
            <a href={`mailto:${emailPrincipale}`}>{emailPrincipale}</a>
          </li>
          <li class="flex items-center gap-3">
            <Icona nome="orologio" class="size-5 text-primario-link" />
            <span>Visite su appuntamento</span>
          </li>
        </ul>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <Bottone
            href={indicazioniHref}
            variante="primario"
            icona="mappa"
            target="_blank"
            rel="noopener"
            evento="click_indicazioni"
            eventoPosizione="home-contatti"
          >
            Indicazioni stradali
          </Bottone>
          <Bottone href="/contatti" variante="secondario" iconaDopo="freccia-destra">
            Come arrivare e parcheggio
          </Bottone>
        </div>
      </div>
      <div class="lg:col-span-7">
        <a
          href={indicazioniHref}
          target="_blank"
          rel="noopener"
          class="block"
          aria-label="Apri la mappa con le indicazioni stradali (si apre in una nuova scheda)"
        >
          <Foto
            ratio="16/9"
            scattoBrief="32"
            descrizioneSegnaposto="Mappa statica dell'area con la posizione della clinica (immagine, nessun JavaScript di terze parti)"
          />
        </a>
      </div>
    </div>
  </Sezione>
</BaseLayout>
