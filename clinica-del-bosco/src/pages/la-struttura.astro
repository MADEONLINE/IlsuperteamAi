---
/** La struttura: chi siamo e com'è organizzata la clinica. I dati societari e il
 * direttore sanitario non si ripetono qui: stanno nel piede pagina di ogni pagina
 * e in /note-legali. */
import { getCollection } from 'astro:content';
import PaginaLayout from '@layouts/PaginaLayout.astro';
import CtaDoppia from '@ui/CtaDoppia.astro';
import Faq from '@ui/Faq.astro';
import Foto from '@ui/Foto.astro';
import Etichetta from '@ui/Etichetta.astro';
import Sezione from '@ui/Sezione.astro';
import { clinica, daConfermare } from '@lib/clinica';
import { faqPage, webPage } from '@lib/schema';

const soci = (await getCollection('equipe'))
  .filter((m) => m.data.socio)
  .sort((a, b) => a.data.ordine - b.data.ordine);
const faqStruttura = (await getCollection('faq'))
  .filter((f) => f.data.categoria === 'struttura')
  .sort((a, b) => a.data.ordine - b.data.ordine)
  .map((f) => ({ domanda: f.data.domanda, risposta: (f.body ?? '').replace(/\s+/g, ' ').trim() }));
const anno = clinica.annoFondazione;
const descrizione =
  'Clinica veterinaria a Portici dal 2010: TC, due sale chirurgiche, terapia intensiva e laboratorio in 500 m² su un piano, per cani, gatti e animali esotici.';
const aree: Array<{ titolo: string; testo: string; scatto?: string }> = [
  {
    titolo: "Sala d'attesa",
    testo: 'Accoglienza e valutazione del caso.',
    scatto: '34',
  },
  {
    titolo: 'Ricovero e terapia intensiva',
    testo:
      'Gabbie con ossigeno e monitoraggio continuo dei parametri vitali. Sono presenti ricoveri separati per le diverse specie: cani, gatti e animali esotici.',
    scatto: '35',
  },
  {
    titolo: 'Due sale chirurgiche',
    testo: 'Due sale chirurgiche con attrezzature avanzate e monitoraggio anestesiologico.',
    scatto: '36',
  },
  {
    titolo: 'Diagnostica per immagini e TC',
    testo:
      "TC Cone Beam con ricostruzioni in 3D, radiografie digitali, ecografia dell'addome e del cuore, endoscopia.",
    scatto: '37',
  },
  {
    titolo: 'Laboratorio analisi',
    testo:
      'Emocromo, esami biochimici, coagulazione, emogasanalisi, test rapidi ormonali, citologia.',
    scatto: '38',
  },
  {
    titolo: 'Sale visite',
    testo: 'Tre sale visite a disposizione dei nostri pazienti.',
    scatto: '39',
  },
  {
    titolo: 'Sala terapie',
    testo:
      'Una sala terapie in cui il proprietario può restare con il proprio animale durante le terapie brevi.',
  },
];
---

<PaginaLayout
  titolo="Chi siamo: la Clinica Veterinaria del bosco a Portici"
  descrizione={descrizione}
  percorso="/la-struttura"
  h1={`La ${clinica.nome} a ${clinica.indirizzo.comune}`}
  sottotitolo={`La ${clinica.nome} è una clinica veterinaria a ${clinica.indirizzo.comune} (Napoli)${daConfermare(anno) ? '' : `, aperta nel ${anno}`}. Cura cani, gatti e animali esotici. Visite, esami, chirurgia e ricovero sono nella stessa sede, su un unico piano di ${clinica.struttura.metriQuadri} m².`}
  etichetta="Chi siamo"
  briciole={[{ nome: 'La struttura', href: '/la-struttura' }]}
  jsonLd={[
    webPage({ url: '/la-struttura', titolo: 'La struttura', descrizione, tipo: 'AboutPage' }),
    faqPage(faqStruttura),
  ]}
>
  <Sezione>
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="prosa lg:col-span-7">
        <h2 class="text-3xl">Chi siamo</h2>
        <p class="mt-4 text-lg">
          Quattro medici veterinari hanno fondato la clinica e la dirigono ancora oggi:{' '}
          {soci.map((m) => `${m.data.titolo} ${m.data.nome}`).join(', ')}. Visitano e operano ogni
          giorno.
        </p>
        <p class="mt-3">
          Oggi in clinica lavorano numerosi medici veterinari: una parte sono collaboratori fissi,
          altri sono collaboratori esterni su appuntamento. Così possiamo garantire ai nostri
          pazienti un servizio che copre tutte le specializzazioni e le migliori cure, dalla
          dermatologia all'oculistica, dalla neurologia all'ortopedia. Li trovi tutti nella pagina
          dei <a href="/equipe">nostri medici</a>.
        </p>
        <p class="mt-3">
          Molti <a href="/per-i-colleghi">veterinari della zona</a> ci mandano i loro pazienti per
          una TC, un intervento o un ricovero. Finita la prestazione, l'animale torna dal suo
          veterinario con il referto completo.
        </p>
      </div>
      <div class="lg:col-span-5">
        <Foto
          ratio="4/5"
          scattoBrief="44"
          descrizioneSegnaposto="Facciata della clinica di giorno, ingresso e insegna"
          riempi
          class="h-full"
        />
      </div>
    </div>
  </Sezione>
  <Sezione tono="tinta">
    <Etichetta class="mb-3">Tour della struttura</Etichetta>
    <h2 class="text-3xl md:text-4xl">Com'è organizzata la clinica</h2>
    <ul class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {aree.map((a) => (
        <li class="rounded-card border border-bordo bg-sfondo-rialzato p-4">
          <Foto ratio="4/3" scattoBrief={a.scatto} descrizioneSegnaposto={a.titolo} />
          <h3 class="mt-4 font-sans text-lg font-bold">{a.titolo}</h3>
          <p class="mt-1 text-sm text-testo-secondario">{a.testo}</p>
        </li>
      ))}
    </ul>
  </Sezione>
  <Sezione>
    <Faq voci={faqStruttura} titolo="Domande frequenti sulla struttura" />
    <p class="mt-6 text-sm text-testo-secondario">
      Indirizzo, mezzi pubblici e parcheggio sono nella pagina <a href="/contatti">contatti</a>.
      Tutte le altre risposte sono nelle <a href="/domande-frequenti">domande frequenti</a>.
    </p>
  </Sezione>
  <Sezione compatta>
    <CtaDoppia posizione="struttura" />
  </Sezione>
</PaginaLayout>
