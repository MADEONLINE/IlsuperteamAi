---
/** La struttura: numeri, aree, attrezzature e specialisti. I dati societari e il
 * direttore sanitario non si ripetono qui: stanno nel piede pagina di ogni pagina
 * e in /note-legali. */
import { getCollection } from 'astro:content';
import PaginaLayout from '@layouts/PaginaLayout.astro';
import CtaDoppia from '@ui/CtaDoppia.astro';
import Faq from '@ui/Faq.astro';
import Foto from '@ui/Foto.astro';
import Etichetta from '@ui/Etichetta.astro';
import Icona from '@ui/Icona.astro';
import Sezione from '@ui/Sezione.astro';
import TabellaDati from '@ui/TabellaDati.astro';
import { clinica, daConfermare } from '@lib/clinica';
import { faqPage, webPage } from '@lib/schema';

const equipe = (await getCollection('equipe')).sort((a, b) => a.data.ordine - b.data.ordine);
const soci = equipe.filter((m) => m.data.socio);
const interni = equipe.filter((m) => m.data.tipo !== 'freelance');
const specialisti = equipe.filter((m) => m.data.tipo === 'freelance');
const servizi = await getCollection('servizi');
const titoloServizio = (id: string) => servizi.find((x) => x.id === id)?.data.titoloBreve ?? id;
const faqStruttura = (await getCollection('faq'))
  .filter((f) => f.data.categoria === 'struttura')
  .sort((a, b) => a.data.ordine - b.data.ordine)
  .map((f) => ({ domanda: f.data.domanda, risposta: (f.body ?? '').replace(/\s+/g, ' ').trim() }));
const anno = clinica.annoFondazione;
const numeri = [
  { valore: daConfermare(anno) ? anno : `dal ${anno}`, etichetta: 'A Portici' },
  { valore: `${clinica.struttura.metriQuadri} m²`, etichetta: 'su un unico piano' },
  { valore: String(clinica.struttura.saleChirurgiche), etichetta: 'sale chirurgiche' },
  { valore: String(clinica.struttura.postiDegenza), etichetta: 'posti di degenza' },
  {
    valore: `${interni.length} + ${specialisti.length}`,
    etichetta: 'medici in clinica e collaboratori',
  },
];
const esamiTac = [
  'Testa, orecchie e naso',
  'Torace',
  'Addome, con e senza mezzo di contrasto',
  'Colonna vertebrale',
  'Reni, ureteri e vescica (uro-TAC)',
  'Tutto il corpo, per capire quanto è esteso un tumore o dopo un grave trauma',
  'Ricostruzioni in 3D',
  'Animali piccoli, conigli ed esotici',
];
const descrizione =
  'Clinica veterinaria a Portici dal 2010: pronto soccorso 24 ore su 24, TAC, due sale chirurgiche, terapia intensiva e laboratorio in 500 m² su un piano.';
const aree = [
  {
    titolo: 'Pronto soccorso e accettazione',
    testo:
      "Si entra direttamente, a qualsiasi ora. All'arrivo valutiamo subito quanto è urgente il caso. C'è una zona con ossigeno per stabilizzare l'animale.",
    scatto: '34',
  },
  {
    titolo: 'Ricovero e terapia intensiva',
    testo:
      'Gabbie con ossigeno e controllo continuo di cuore, respiro e pressione. Cani e gatti stanno in zone separate. Conigli ed esotici hanno una zona silenziosa.',
    scatto: '35',
  },
  {
    titolo: 'Due sale chirurgiche',
    testo:
      "Una sala è per gli interventi sui tessuti molli, l'altra per l'ortopedia. In entrambe controlliamo l'anestesia in modo continuo. Abbiamo il laser chirurgico e gli strumenti per la laparoscopia, cioè gli interventi con piccoli fori.",
    scatto: '36',
  },
  {
    titolo: 'Diagnostica per immagini e TAC',
    testo:
      "TAC con ricostruzioni in 3D, radiografie digitali, ecografia dell'addome e del cuore, endoscopia.",
    scatto: '37',
  },
  {
    titolo: 'Laboratorio analisi',
    testo:
      "Emocromo, esami biochimici, coagulazione, sali minerali e gas nel sangue. Poi test rapidi per le malattie infettive e citologia, cioè l'esame delle cellule al microscopio. La risposta arriva in giornata, anche di notte.",
    scatto: '38',
  },
  {
    titolo: "Ambulatori e sala d'attesa",
    testo: 'Ambulatori per le visite. Per i gatti teniamo i trasportini coperti e l’attesa breve.',
    scatto: '39',
  },
];
---

<PaginaLayout
  titolo="Chi siamo: la Clinica Veterinaria del Bosco a Portici"
  descrizione={descrizione}
  percorso="/la-struttura"
  h1={`La ${clinica.nome} a ${clinica.indirizzo.comune}`}
  sottotitolo={`La ${clinica.nome} è una clinica veterinaria di ${clinica.indirizzo.comune} (Napoli)${daConfermare(anno) ? '' : `, aperta nel ${anno}`}. Cura cani, gatti, conigli e animali esotici, con un pronto soccorso aperto 24 ore su 24. Urgenza, esami, chirurgia e ricovero sono nello stesso edificio, su un unico piano di ${clinica.struttura.metriQuadri} m².`}
  etichetta="Chi siamo"
  briciole={[{ nome: 'La struttura', href: '/la-struttura' }]}
  jsonLd={[
    webPage({ url: '/la-struttura', titolo: 'La struttura', descrizione, tipo: 'AboutPage' }),
    faqPage(faqStruttura),
  ]}
>
  <Sezione>
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="prosa lg:col-span-7">
        <h2 class="text-3xl">Chi siamo</h2>
        <p class="mt-4 text-lg">
          Quattro medici veterinari hanno fondato la clinica e la dirigono ancora oggi:{' '}
          {soci.map((m) => `${m.data.titolo} ${m.data.nome}`).join(', ')}. Visitano e operano ogni
          giorno. La clinica è gestita da {clinica.ragioneSociale}.
        </p>
        <p class="mt-3">
          Oggi in clinica lavorano {interni.length} medici veterinari. Altri {specialisti.length}{' '}
          veterinari collaborano con la clinica in giorni fissi per dermatologia, oculistica,
          neurologia, ortopedia, endoscopia, ecografia e chirurgia. Li trovi tutti nella pagina
          dell'<a href="/equipe">équipe</a>.
        </p>
        <p class="mt-3">
          Molti <a href="/per-i-colleghi">veterinari della zona</a> ci mandano i loro pazienti per
          una TAC, un intervento o un ricovero. Finita la prestazione, l'animale torna dal suo
          veterinario con il referto completo.
        </p>
        <ul
          class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5"
          aria-label="La clinica in numeri"
        >
          {numeri.map((n) => (
            <li class="rounded-card border border-bordo bg-sfondo-rialzato p-3 text-center">
              <span class="block font-display text-2xl font-bold text-primario-link">
                {n.valore}
              </span>
              <span class="block text-xs text-testo-secondario">{n.etichetta}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-5">
        <Foto
          ratio="4/5"
          scattoBrief="44"
          descrizioneSegnaposto="Facciata della clinica di giorno, ingresso e insegna"
          riempi
          class="h-full"
        />
      </div>
    </div>
  </Sezione>
  <Sezione tono="tinta">
    <Etichetta class="mb-3">Tour della struttura</Etichetta>
    <h2 class="text-3xl md:text-4xl">Com'è organizzata la clinica</h2>
    <ul class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {aree.map((a) => (
        <li class="rounded-card border border-bordo bg-sfondo-rialzato p-4">
          <Foto ratio="4/3" scattoBrief={a.scatto} descrizioneSegnaposto={a.titolo} />
          <h3 class="mt-4 font-sans text-lg font-bold">{a.titolo}</h3>
          <p class="mt-1 text-sm text-testo-secondario">{a.testo}</p>
        </li>
      ))}
    </ul>
  </Sezione>
  <Sezione>
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <Etichetta class="mb-3">Come lavoriamo</Etichetta>
        <h2 class="text-3xl md:text-4xl">Chi c'è in clinica, di giorno e di notte</h2>
        <ul class="mt-6 space-y-4">
          {[
            [
              'Di giorno',
              'Dalle 9 alle 20, anche nei festivi: almeno due medici veterinari, più tecnici e reception.',
            ],
            ['Di notte', 'Dalle 20 alle 9: un medico veterinario e un tecnico, oppure due medici.'],
            [
              'I veterinari che collaborano',
              'Dermatologia, oculistica, neurologia, ortopedia, endoscopia, ecografia e chirurgia hanno giorni di presenza fissi: la reception ti fissa la visita nel giorno giusto.',
            ],
            [
              'Ogni mattina',
              'Il turno di notte passa le consegne a quello di giorno: terapie e parametri di ogni animale ricoverato. Se il tuo animale è ricoverato, il medico ti telefona almeno una volta al giorno.',
            ],
          ].map(([t, d]) => (
            <li class="flex items-start gap-3">
              <Icona nome="check" class="mt-1 size-5 shrink-0 text-successo" />
              <span>
                <strong>{t}.</strong> {d}
              </span>
            </li>
          ))}
        </ul>
        <h3 class="mt-10 font-sans text-xl font-bold">
          I veterinari che collaborano e i loro giorni
        </h3>
        <ul class="mt-4 divide-y divide-bordo rounded-card border border-bordo bg-sfondo-rialzato text-sm">
          {specialisti.map((m) => (
            <li class="grid gap-1 px-4 py-3 sm:grid-cols-[1fr_auto] sm:items-center">
              <span>
                <a href={`/equipe/${m.id}`} class="font-semibold">
                  {m.data.titolo} {m.data.nome}
                </a>
                <span class="block text-testo-secondario">
                  {m.data.aree.map(titoloServizio).join(' · ')}
                </span>
              </span>
              <span class="text-testo-secondario sm:text-right">
                {m.data.presenza ?? 'Su appuntamento'}
              </span>
            </li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-5">
        <div class="rounded-card border border-bordo bg-sfondo-rialzato p-6">
          <h2 class="font-sans text-xl font-bold">Cosa facciamo con la TAC</h2>
          <ul class="mt-3 space-y-1.5 text-sm">
            {esamiTac.map((e) => (
              <li class="flex items-start gap-2">
                <Icona nome="check" class="mt-0.5 size-4 shrink-0 text-successo" />
                <span>{e}</span>
              </li>
            ))}
          </ul>
          <a
            href="/servizi/tac-diagnostica-avanzata"
            class="mt-4 inline-flex items-center gap-1 font-semibold text-primario-link"
          >
            La TAC spiegata al proprietario <Icona nome="freccia-destra" class="size-4" />
          </a>
        </div>
        <div class="mt-6 rounded-card border border-bordo bg-sfondo-rialzato p-6">
          <h2 class="font-sans text-xl font-bold">Cosa non abbiamo</h2>
          <p class="mt-2 text-sm text-testo-secondario">
            In clinica non c'è la risonanza magnetica. Se il tuo animale ne ha bisogno, te lo
            diciamo subito e ti indirizziamo a un centro che la fa. Il medico che segue il caso
            resta in contatto con quel centro.
          </p>
        </div>
      </div>
    </div>
  </Sezione>
  <Sezione tono="tinta">
    <TabellaDati
      tabella={{
        titolo: 'Dotazione della struttura',
        intestazioni: ['Area', 'Dotazione', 'Disponibilità'],
        righe: [
          [
            'Pronto soccorso',
            'Medico e tecnico in clinica, zona di stabilizzazione con ossigeno',
            '24 ore su 24, festivi inclusi',
          ],
          [
            'Terapia intensiva',
            'Gabbie a ossigeno, monitoraggio continuo, infusione controllata',
            '24 ore su 24',
          ],
          [
            'Chirurgia',
            'Due sale operatorie, laser, laparoscopia, monitoraggio anestesiologico',
            'Programmata e in urgenza',
          ],
          [
            'TAC',
            'Tomografia computerizzata con ricostruzioni 3D e mezzo di contrasto',
            'Su prenotazione, urgenze concordate',
          ],
          [
            'Imaging',
            'Radiologia digitale, ecografia addominale e cardiologica, endoscopia',
            'Programmata e in urgenza',
          ],
          [
            'Laboratorio',
            'Ematologia, biochimica, coagulazione, elettroliti, emogas, test infettivi, citologia',
            '24 ore su 24',
          ],
          [
            'Esotici',
            'Area degenza dedicata, strumentario per piccoli mammiferi, rettili e uccelli',
            'Programmata e in urgenza',
          ],
        ],
        nota: 'Marche e modelli disponibili su richiesta per i colleghi veterinari.',
      }}
    />
  </Sezione>
  <Sezione>
    <Faq voci={faqStruttura} titolo="Domande frequenti sulla struttura" />
    <p class="mt-6 text-sm text-testo-secondario">
      Indirizzo, mezzi pubblici e parcheggio sono nella pagina <a href="/contatti">contatti</a>.
      Tutte le altre risposte sono nelle <a href="/domande-frequenti">domande frequenti</a>.
    </p>
  </Sezione>
  <Sezione compatta>
    <CtaDoppia posizione="struttura" />
  </Sezione>
</PaginaLayout>
