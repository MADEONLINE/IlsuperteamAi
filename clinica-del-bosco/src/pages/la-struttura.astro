---
/** "Scheda anagrafica" leggibile da macchina: chi siamo, dove, cosa facciamo, da quando, con quali attrezzature, chi è il direttore sanitario. */
import { getCollection } from 'astro:content';
import PaginaLayout from '@layouts/PaginaLayout.astro';
import CtaDoppia from '@ui/CtaDoppia.astro';
import Dato from '@ui/Dato.astro';
import Faq from '@ui/Faq.astro';
import Foto from '@ui/Foto.astro';
import Etichetta from '@ui/Etichetta.astro';
import Icona from '@ui/Icona.astro';
import Sezione from '@ui/Sezione.astro';
import TabellaDati from '@ui/TabellaDati.astro';
import {
  clinica,
  daConfermare,
  direttoreSanitarioRiga,
  emailPrincipale,
  indirizzoRiga,
} from '@lib/clinica';
import { faqPage, webPage } from '@lib/schema';

const equipe = (await getCollection('equipe')).sort((a, b) => a.data.ordine - b.data.ordine);
const soci = equipe.filter((m) => m.data.socio);
const interni = equipe.filter((m) => m.data.tipo !== 'freelance');
const specialisti = equipe.filter((m) => m.data.tipo === 'freelance');
const servizi = await getCollection('servizi');
const titoloServizio = (id: string) => servizi.find((x) => x.id === id)?.data.titoloBreve ?? id;
const faqStruttura = (await getCollection('faq'))
  .filter((f) => f.data.categoria === 'struttura')
  .sort((a, b) => a.data.ordine - b.data.ordine)
  .map((f) => ({ domanda: f.data.domanda, risposta: (f.body ?? '').replace(/\s+/g, ' ').trim() }));
const anno = clinica.annoFondazione;
const anniAttivita = daConfermare(anno) ? null : new Date().getFullYear() - Number(anno);
const numeri = [
  { valore: daConfermare(anno) ? anno : `dal ${anno}`, etichetta: 'A Portici' },
  { valore: `${clinica.struttura.metriQuadri} m²`, etichetta: 'su un unico piano' },
  { valore: String(clinica.struttura.saleChirurgiche), etichetta: 'sale chirurgiche' },
  { valore: String(clinica.struttura.postiDegenza), etichetta: 'posti di degenza' },
  { valore: String(equipe.length), etichetta: 'medici veterinari' },
];
const esamiTac = [
  'Cranio, orecchio e cavità nasali',
  'Torace',
  'Addome, con e senza mezzo di contrasto',
  'Colonna vertebrale',
  'Uro-TAC (reni, ureteri, vescica)',
  'Total body, per stadiazione oncologica e politraumi',
  'Studi con mezzo di contrasto e ricostruzioni 3D',
  'Pazienti di piccola taglia, conigli ed esotici',
];
const descrizione =
  'La Clinica Veterinaria del Bosco di Portici: pronto soccorso h24, terapia intensiva, due sale chirurgiche, TAC, endoscopia, laboratorio interno. Sede, attrezzature, direttore sanitario, équipe.';
const aree = [
  {
    titolo: 'Pronto soccorso e accettazione h24',
    testo:
      "Accesso diretto 24 ore su 24 con medico e assistente in struttura. Triage all'arrivo, area di stabilizzazione con ossigeno.",
    scatto: '34',
  },
  {
    titolo: 'Degenza e terapia intensiva',
    testo:
      'Gabbie a ossigeno, monitoraggio multiparametrico continuo, degenze separate per cani e gatti, area silenziosa per conigli ed esotici.',
    scatto: '35',
  },
  {
    titolo: 'Due sale chirurgiche',
    testo:
      'Sala per chirurgia dei tessuti molli e sala ortopedica, con monitoraggio anestesiologico, laser e strumentario laparoscopico.',
    scatto: '36',
  },
  {
    titolo: 'Diagnostica per immagini e TAC',
    testo:
      'TAC multistrato con ricostruzioni 3D, radiologia digitale diretta, ecografia addominale e cardiologica, endoscopia.',
    scatto: '37',
  },
  {
    titolo: 'Laboratorio analisi',
    testo:
      'Ematologia, biochimica, coagulazione, elettroliti, emogasanalisi, test rapidi per malattie infettive, citologia. Risposta in giornata, anche di notte.',
    scatto: '38',
  },
  {
    titolo: "Ambulatori e sala d'attesa",
    testo:
      'Ambulatori per le visite specialistiche e accorgimenti a basso stress per i gatti (trasportini coperti, tempi di attesa ridotti).',
    scatto: '39',
  },
];
---

<PaginaLayout
  titolo="La struttura: ospedale veterinario h24 a Portici"
  descrizione={descrizione}
  percorso="/la-struttura"
  h1="La struttura"
  sottotitolo="Un ospedale veterinario completo nel cuore di Portici: urgenza, diagnostica avanzata, chirurgia e degenza nello stesso edificio, con personale presente giorno e notte."
  etichetta="Chi siamo"
  briciole={[{ nome: 'La struttura', href: '/la-struttura' }]}
  jsonLd={[
    webPage({ url: '/la-struttura', titolo: 'La struttura', descrizione, tipo: 'AboutPage' }),
    faqPage(faqStruttura),
  ]}
>
  <Sezione>
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="prosa lg:col-span-7">
        <h2 class="text-3xl">Chi siamo</h2>
        <p class="mt-4 text-lg">
          La {clinica.nome} è una struttura veterinaria di {clinica.indirizzo.comune}, nell'area
          metropolitana di Napoli, gestita da {clinica.ragioneSociale}.{' '}
          {daConfermare(anno) ? 'È stata fondata' : `Aperta nel ${anno}`} dai medici veterinari{' '}
          {soci.map((m) => `${m.data.titolo} ${m.data.nome}`).join(', ')}, che la dirigono ancora
          oggi e continuano a visitare e operare. Cura cani, gatti, conigli e animali esotici, con
          un pronto soccorso attivo 24 ore su 24 e 7 giorni su 7 con personale in struttura.
        </p>
        <p class="mt-3">
          {anniAttivita !== null && `In ${anniAttivita} anni `}
          {anniAttivita === null ? "L'équipe" : "l'équipe"} è cresciuta fino a {interni.length}{' '}
          medici della clinica e {specialisti.length} specialisti in collaborazione con giornate di
          presenza fisse: dermatologia, oculistica, neurologia, ortopedia, endoscopia, ecografia e
          chirurgia. Tutte le schede sono nella pagina <a href="/equipe">équipe</a>.
        </p>
        <p class="mt-3">
          È una delle poche strutture del bacino vesuviano a riunire nella stessa sede terapia
          intensiva, due sale chirurgiche, TAC, endoscopia e laboratorio analisi: per questo riceve
          anche i pazienti inviati dai <a href="/per-i-colleghi">colleghi veterinari</a> del
          territorio per esami e interventi in service.
        </p>
        <ul
          class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5"
          aria-label="La clinica in numeri"
        >
          {numeri.map((n) => (
            <li class="rounded-card border border-bordo bg-sfondo-rialzato p-3 text-center">
              <span class="block font-display text-2xl font-bold text-primario-link">
                {n.valore}
              </span>
              <span class="block text-xs text-testo-secondario">{n.etichetta}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-5">
        <dl class="divide-y divide-bordo rounded-card border border-bordo bg-sfondo-rialzato text-sm">
          {(
            [
              ['Denominazione', clinica.nome],
              ['Ragione sociale', `${clinica.ragioneSociale} · P. IVA ${clinica.partitaIva}`],
              ['Sede', indirizzoRiga],
              ['Telefono h24', clinica.contatti.telefono.visualizzato],
              ['Email', emailPrincipale],
              ['Attiva dal', clinica.annoFondazione],
              ['Direttore sanitario', direttoreSanitarioRiga],
              [
                'Autorizzazione sanitaria',
                `${clinica.autorizzazioneSanitaria.numero} — ${clinica.autorizzazioneSanitaria.ente}`,
              ],
              [
                'Struttura',
                `${clinica.struttura.metriQuadri} m², ${clinica.struttura.saleVisita} sale visita, ${clinica.struttura.saleChirurgiche} sale chirurgiche, ${clinica.struttura.postiDegenza} posti di degenza`,
              ],
              [
                'Équipe',
                `${clinica.struttura.veterinari} medici veterinari tra soci, collaboratori e specialisti, ${clinica.struttura.tecnici} tecnici, ${clinica.struttura.reception} persone in reception`,
              ],
              ['Specie trattate', 'Cani, gatti, conigli, piccoli mammiferi, rettili, uccelli'],
              ['Area servita', clinica.areaServita.map((z) => z.nome).join(', ')],
            ] as Array<[string, string]>
          ).map(([k, v]) => (
            <div class="grid grid-cols-[9rem_1fr] gap-3 px-4 py-3">
              <dt class="font-bold text-testo-secondario">{k}</dt>
              <dd>{daConfermare(v) ? <Dato valore={v} /> : v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </Sezione>
  <Sezione tono="tinta">
    <Etichetta class="mb-3">Tour della struttura</Etichetta>
    <h2 class="text-3xl md:text-4xl">Le aree</h2>
    <ul class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {aree.map((a) => (
        <li class="rounded-card border border-bordo bg-sfondo-rialzato p-4">
          <Foto ratio="4/3" scattoBrief={a.scatto} descrizioneSegnaposto={a.titolo} />
          <h3 class="mt-4 font-sans text-lg font-bold">{a.titolo}</h3>
          <p class="mt-1 text-sm text-testo-secondario">{a.testo}</p>
        </li>
      ))}
    </ul>
  </Sezione>
  <Sezione>
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <Etichetta class="mb-3">Come lavoriamo</Etichetta>
        <h2 class="text-3xl md:text-4xl">Giorno e notte, con medici presenti</h2>
        <ul class="mt-6 space-y-4">
          {[
            [
              'Di giorno',
              'Turni dalle 9 alle 20, feriali e festivi, con almeno due medici veterinari sempre in struttura, oltre a tecnici e reception.',
            ],
            [
              'Di notte',
              'Turno di pronto soccorso dalle 20 alle 9 con un medico e un tecnico, o due medici, in struttura: le urgenze e i pazienti ricoverati non restano mai soli.',
            ],
            [
              'Gli specialisti',
              'Dermatologia, oculistica, neurologia, ortopedia, endoscopia, ecografia e chirurgia specialistica hanno giornate di presenza programmate: la reception fissa la visita nel giorno giusto.',
            ],
            [
              'Il passaggio di consegne',
              'Ogni mattina il turno notturno consegna al diurno i pazienti in degenza, con terapie e parametri aggiornati. Il proprietario riceve una telefonata al giorno.',
            ],
          ].map(([t, d]) => (
            <li class="flex items-start gap-3">
              <Icona nome="check" class="mt-1 size-5 shrink-0 text-successo" />
              <span>
                <strong>{t}.</strong> {d}
              </span>
            </li>
          ))}
        </ul>
        <h3 class="mt-10 font-sans text-xl font-bold">Gli specialisti e i loro giorni</h3>
        <ul class="mt-4 divide-y divide-bordo rounded-card border border-bordo bg-sfondo-rialzato text-sm">
          {specialisti.map((m) => (
            <li class="grid gap-1 px-4 py-3 sm:grid-cols-[1fr_auto] sm:items-center">
              <span>
                <a href={`/equipe/${m.id}`} class="font-semibold">
                  {m.data.titolo} {m.data.nome}
                </a>
                <span class="block text-testo-secondario">
                  {m.data.aree.map(titoloServizio).join(' · ')}
                </span>
              </span>
              <span class="text-testo-secondario sm:text-right">
                {m.data.presenza ?? 'Su appuntamento'}
              </span>
            </li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-5">
        <div class="rounded-card border border-bordo bg-sfondo-rialzato p-6">
          <h2 class="font-sans text-xl font-bold">TAC in sede: cosa eseguiamo</h2>
          <ul class="mt-3 space-y-1.5 text-sm">
            {esamiTac.map((e) => (
              <li class="flex items-start gap-2">
                <Icona nome="check" class="mt-0.5 size-4 shrink-0 text-successo" />
                <span>{e}</span>
              </li>
            ))}
          </ul>
          <a
            href="/servizi/tac-diagnostica-avanzata"
            class="mt-4 inline-flex items-center gap-1 font-semibold text-primario-link"
          >
            La TAC spiegata al proprietario <Icona nome="freccia-destra" class="size-4" />
          </a>
        </div>
        <div class="mt-6 rounded-card border border-bordo bg-sfondo-rialzato p-6">
          <h2 class="font-sans text-xl font-bold">Cosa non abbiamo</h2>
          <p class="mt-2 text-sm text-testo-secondario">
            Non disponiamo di risonanza magnetica: quando un caso la richiede lo diciamo subito e
            indirizziamo a un centro attrezzato, tenendo il coordinamento clinico. Preferiamo
            dichiararlo che scoprirlo insieme a te dopo una diagnosi a metà.
          </p>
        </div>
      </div>
    </div>
  </Sezione>
  <Sezione tono="tinta">
    <TabellaDati
      tabella={{
        titolo: 'Dotazione della struttura',
        intestazioni: ['Area', 'Dotazione', 'Disponibilità'],
        righe: [
          [
            'Pronto soccorso',
            'Medico e assistente in struttura, area di stabilizzazione con ossigeno',
            '24 ore su 24, festivi inclusi',
          ],
          [
            'Terapia intensiva',
            'Gabbie a ossigeno, monitoraggio continuo, infusione controllata',
            '24 ore su 24',
          ],
          [
            'Chirurgia',
            'Due sale operatorie, laser, laparoscopia, monitoraggio anestesiologico',
            'Programmata e in urgenza',
          ],
          [
            'TAC',
            'Tomografia computerizzata con ricostruzioni 3D e mezzo di contrasto',
            'Su prenotazione, urgenze concordate',
          ],
          [
            'Imaging',
            'Radiologia digitale, ecografia addominale e cardiologica, endoscopia',
            'Programmata e in urgenza',
          ],
          [
            'Laboratorio',
            'Ematologia, biochimica, coagulazione, elettroliti, emogas, test infettivi, citologia',
            '24 ore su 24',
          ],
          [
            'Esotici',
            'Area degenza dedicata, strumentario per piccoli mammiferi, rettili e uccelli',
            'Programmata e in urgenza',
          ],
        ],
        nota: 'Marche e modelli disponibili su richiesta per i colleghi veterinari.',
      }}
    />
  </Sezione>
  <Sezione>
    <Faq voci={faqStruttura} titolo="Domande frequenti sulla struttura" />
    <p class="mt-6 text-sm text-testo-secondario">
      Indirizzo, mezzi pubblici e parcheggio sono nella pagina <a href="/contatti">contatti</a>.
      Tutte le altre risposte sono nelle <a href="/domande-frequenti">domande frequenti</a>.
    </p>
  </Sezione>
  <Sezione compatta>
    <CtaDoppia posizione="struttura" />
  </Sezione>
</PaginaLayout>
