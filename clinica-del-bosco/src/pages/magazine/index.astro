---
/** Hub magazine: articoli firmati dal team + campagne stagionali. */
import { getCollection } from 'astro:content';
import PaginaLayout from '@layouts/PaginaLayout.astro';
import CtaDoppia from '@ui/CtaDoppia.astro';
import Foto from '@ui/Foto.astro';
import Icona from '@ui/Icona.astro';
import Etichetta from '@ui/Etichetta.astro';
import Sezione from '@ui/Sezione.astro';
import { webPage } from '@lib/schema';

const articoli = (await getCollection('articoli')).sort(
  (a, b) => b.data.dataPubblicazione.getTime() - a.data.dataPubblicazione.getTime(),
);
const campagne = (await getCollection('campagne')).sort(
  (a, b) => a.data.meseInizio - b.data.meseInizio,
);
/** Calendario delle campagne: ogni campagna è una barra sui suoi mesi (classi scritte per intero, così Tailwind le genera). */
const mesi = ['Gen', 'Feb', 'Mar', 'Apr', 'Mag', 'Giu', 'Lug', 'Ago', 'Set', 'Ott', 'Nov', 'Dic'];
const inizioColonna: Record<number, string> = {
  1: 'col-start-1',
  2: 'col-start-2',
  3: 'col-start-3',
  4: 'col-start-4',
  5: 'col-start-5',
  6: 'col-start-6',
  7: 'col-start-7',
  8: 'col-start-8',
  9: 'col-start-9',
  10: 'col-start-10',
  11: 'col-start-11',
  12: 'col-start-12',
};
const fineColonna: Record<number, string> = {
  2: 'col-end-2',
  3: 'col-end-3',
  4: 'col-end-4',
  5: 'col-end-5',
  6: 'col-end-6',
  7: 'col-end-7',
  8: 'col-end-8',
  9: 'col-end-9',
  10: 'col-end-10',
  11: 'col-end-11',
  12: 'col-end-12',
  13: 'col-end-13',
};
/** Tratti della barra: una campagna a cavallo d'anno (es. novembre-febbraio) ne ha due. */
const tratti = (da: number, a: number): Array<[number, number]> =>
  a >= da
    ? [[da, a]]
    : [
        [da, 12],
        [1, a],
      ];
const descrizione =
  'Guide pratiche scritte dal team della Clinica Veterinaria del bosco: urgenze, prevenzione, chirurgia, gatto anziano, parassiti in Campania. Con fonti e data di revisione.';
const data = (d: Date) =>
  d.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
---

<PaginaLayout
  titolo="Magazine: guide veterinarie scritte dal nostro team"
  descrizione={descrizione}
  percorso="/magazine"
  h1="Magazine"
  sottotitolo="Guide pratiche per chi vive con un animale, scritte e revisionate dal team della clinica. Ogni articolo cita le fonti e la data dell'ultima revisione."
  etichetta="Informazione clinica"
  briciole={[{ nome: 'Magazine', href: '/magazine' }]}
  jsonLd={[webPage({ url: '/magazine', titolo: 'Magazine', descrizione, tipo: 'CollectionPage' })]}
>
  <Sezione>
    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {articoli.map((a) => (
        <li>
          <a
            href={`/magazine/${a.id}`}
            class="group flex h-full flex-col rounded-card border border-bordo bg-sfondo-rialzato no-underline shadow-card transition hover:-translate-y-0.5 hover:border-primario"
          >
            <Foto
              ratio="16/9"
              scattoBrief={a.data.scattoBrief}
              descrizioneSegnaposto={a.data.titolo}
              class="rounded-b-none"
            />
            <div class="flex flex-1 flex-col p-5">
              <p class="text-xs font-bold uppercase tracking-wider text-testo-secondario">
                {a.data.tag.slice(0, 2).join(' · ')} · {a.data.tempoLettura} min di lettura
              </p>
              <h2 class="mt-2 font-sans text-xl font-bold text-testo group-hover:text-primario-link">
                {a.data.titolo}
              </h2>
              <p class="mt-2 text-sm text-testo-secondario">{a.data.descrizioneMeta}</p>
              <p class="mt-auto pt-4 text-xs text-testo-secondario">
                Revisione: {data(a.data.dataRevisione)}
              </p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </Sezione>
  <Sezione tono="tinta">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <Etichetta class="mb-3">Campagne stagionali</Etichetta>
        <h2 class="text-3xl md:text-4xl">Prevenzione al momento giusto</h2>
      </div>
      <p class="max-w-md text-testo-secondario">
        Ogni barra è il periodo dell'anno in cui conviene fare il controllo. Tocca una campagna per
        sapere cosa comprende e prenotare.
      </p>
    </div>
    <div class="mt-8 overflow-hidden rounded-[1.75rem] border border-bordo bg-sfondo-rialzato ombra-morbida">
      <!-- Intestazione dei mesi, allineata alle barre -->
      <div
        class="grid gap-x-8 border-b border-bordo px-5 py-3 md:px-8 lg:grid-cols-12"
        aria-hidden="true"
      >
        <div class="hidden lg:col-span-4 lg:block"></div>
        <div class="grid grid-cols-12 lg:col-span-8">
          {mesi.map((m) => (
            <span class="text-center text-[0.68rem] font-bold uppercase tracking-wider text-testo-secondario sm:text-xs">
              <span class="sm:hidden">{m.charAt(0)}</span>
              <span class="hidden sm:inline">{m}</span>
            </span>
          ))}
        </div>
      </div>
      <ul class="divide-y divide-bordo">
        {campagne.map((c) => (
          <li>
            <a
              href={`/campagne/${c.id}`}
              class="group grid items-center gap-x-8 gap-y-4 px-5 py-6 no-underline transition-colors duration-300 hover:bg-sfondo-tinta md:px-8 lg:grid-cols-12"
            >
              <div class="lg:col-span-4">
                <p class="text-xs font-bold uppercase tracking-wider text-primario-link">
                  {c.data.periodo}
                </p>
                <h3 class="mt-1.5 font-sans text-lg font-bold leading-snug text-testo group-hover:text-primario-link">
                  {c.data.titolo}
                </h3>
                <span class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-primario-link">
                  {c.data.ctaTesto}
                  <Icona
                    nome="freccia-destra"
                    class="size-4 transition-transform duration-300 group-hover:translate-x-1"
                  />
                </span>
              </div>
              <div class="calendario-traccia relative grid h-11 grid-cols-12 items-center rounded-full lg:col-span-8">
                {tratti(c.data.meseInizio, c.data.meseFine).map(([da, a]) => (
                  <span
                    class:list={[
                      'calendario-barra row-start-1 h-full rounded-full',
                      inizioColonna[da],
                      fineColonna[a + 1],
                    ]}
                  ></span>
                ))}
                <span class="sr-only">Periodo consigliato: {c.data.periodo}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Sezione>
  <Sezione compatta>
    <CtaDoppia posizione="magazine" />
  </Sezione>
</PaginaLayout>

<style>
  /* Binario dei 12 mesi: tacche leggere tra un mese e l'altro. */
  .calendario-traccia {
    background:
      repeating-linear-gradient(
        90deg,
        transparent 0 calc(100% / 12 - 1px),
        color-mix(in oklab, var(--bordo) 90%, transparent) calc(100% / 12 - 1px) calc(100% / 12)
      ),
      color-mix(in oklab, var(--sfondo-tinta) 70%, transparent);
  }
  /* La barra prende il colore del logo assegnato alla voce (--q, a rotazione) */
  .calendario-barra {
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--q, var(--q-verde)) 78%, #fff),
      var(--q, var(--q-verde))
    );
    box-shadow: 0 8px 20px -10px var(--q, var(--q-verde));
    transform-origin: left center;
    transition:
      transform 0.4s var(--ease-morbido, ease),
      filter 0.4s;
  }
  a:hover .calendario-barra,
  a:focus-visible .calendario-barra {
    filter: saturate(1.15) brightness(1.04);
    transform: scaleY(1.12);
  }
  @media (prefers-reduced-motion: reduce) {
    .calendario-barra {
      transition: none;
    }
  }
</style>
