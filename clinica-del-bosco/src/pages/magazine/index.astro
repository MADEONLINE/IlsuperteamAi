---
/** Hub magazine: articoli firmati dal team + campagne stagionali. */
import { getCollection } from 'astro:content';
import PaginaLayout from '@layouts/PaginaLayout.astro';
import CtaDoppia from '@ui/CtaDoppia.astro';
import Foto from '@ui/Foto.astro';
import Icona from '@ui/Icona.astro';
import type { NomeIcona } from '@ui/Icona.astro';
import Etichetta from '@ui/Etichetta.astro';
import Sezione from '@ui/Sezione.astro';
import { webPage } from '@lib/schema';

const articoli = (await getCollection('articoli')).sort(
  (a, b) => b.data.dataPubblicazione.getTime() - a.data.dataPubblicazione.getTime(),
);
const campagne = (await getCollection('campagne')).sort(
  (a, b) => a.data.meseInizio - b.data.meseInizio,
);
/** Campagne come cartoline: un'icona per tema e il titolo diviso in titolo breve e sottotitolo. */
const iconeCampagna: Record<string, NomeIcona> = {
  'salute-dentale': 'dente',
  'prevenzione-filariosi-e-leishmaniosi': 'scudo',
  'estate-sicura-caldo-e-viaggi': 'sole',
  'senior-controllo-dai-7-anni': 'cuore',
};
const dividiTitolo = (t: string): [string, string] => {
  const i = t.indexOf(':');
  return i > 0 ? [t.slice(0, i), t.slice(i + 1).trim()] : [t, ''];
};
const descrizione =
  'Guide pratiche scritte dal team della Clinica Veterinaria del bosco: urgenze, prevenzione, chirurgia, gatto anziano, parassiti in Campania.';
const data = (d: Date) =>
  d.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
---

<PaginaLayout
  titolo="Magazine: guide veterinarie scritte dal nostro team"
  descrizione={descrizione}
  percorso="/magazine"
  h1="Magazine"
  sottotitolo="Guide pratiche per chi vive con un animale, scritte e revisionate dal team della clinica."
  etichetta="Informazione clinica"
  briciole={[{ nome: 'Magazine', href: '/magazine' }]}
  jsonLd={[webPage({ url: '/magazine', titolo: 'Magazine', descrizione, tipo: 'CollectionPage' })]}
>
  <Sezione>
    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {articoli.map((a) => (
        <li>
          <a
            href={`/magazine/${a.id}`}
            class="group flex h-full flex-col rounded-card border border-bordo bg-sfondo-rialzato no-underline shadow-card transition hover:-translate-y-0.5 hover:border-primario"
          >
            <Foto
              ratio="16/9"
              scattoBrief={a.data.scattoBrief}
              descrizioneSegnaposto={a.data.titolo}
              class="rounded-b-none"
            />
            <div class="flex flex-1 flex-col p-5">
              <p class="text-xs font-bold uppercase tracking-wider text-testo-secondario">
                {a.data.tag.slice(0, 2).join(' · ')} · {a.data.tempoLettura} min di lettura
              </p>
              <h2 class="mt-2 font-sans text-xl font-bold text-testo group-hover:text-primario-link">
                {a.data.titolo}
              </h2>
              <p class="mt-2 text-sm text-testo-secondario">{a.data.descrizioneMeta}</p>
              <p class="mt-auto pt-4 text-xs text-testo-secondario">
                Revisione: {data(a.data.dataRevisione)}
              </p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </Sezione>
  <Sezione tono="tinta">
    <Etichetta class="mb-3">Campagne stagionali</Etichetta>
    <h2 class="text-3xl md:text-4xl">Prevenzione al momento giusto</h2>
    <ul class="cartoline -mx-4 mt-8 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 pb-4 sm:mx-0 sm:grid sm:grid-cols-2 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-4 lg:gap-5">
      {campagne.map((c) => {
        const [titolo, sottotitolo] = dividiTitolo(c.data.titolo);
        return (
          <li class="w-[78%] shrink-0 snap-start sm:w-auto">
            <a
              href={`/campagne/${c.id}`}
              class="cartolina zoom-foto group flex h-full flex-col rounded-[1.5rem] border border-bordo bg-sfondo-rialzato p-2.5 no-underline ombra-morbida transition duration-500 ease-morbido hover:-translate-y-1"
            >
              <div class="relative">
                <Foto
                  ratio="1/1"
                  scattoBrief={c.data.scattoBrief}
                  descrizioneSegnaposto={titolo}
                  larghezze={[360, 540, 720]}
                  sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 78vw"
                  class="rounded-[1.1rem]"
                />
                <span
                  class="francobollo absolute right-3 top-3 grid size-12 place-items-center rounded-xl"
                  aria-hidden="true"
                >
                  <Icona nome={iconeCampagna[c.id] ?? 'calendario'} duo class="size-6" />
                </span>
                <span class="absolute bottom-3 left-3 rounded-full bg-[rgb(5_38_43/0.72)] px-3 py-1 text-xs font-bold uppercase tracking-wider text-white backdrop-blur-sm">
                  {c.data.periodo}
                </span>
              </div>
              <span
                class="cartolina-filo mx-1 mt-3 block h-1 rounded-full"
                aria-hidden="true"
              ></span>
              <div class="flex flex-1 flex-col px-2 pb-2 pt-3">
                <h3 class="font-display text-xl leading-tight text-testo group-hover:text-primario-link">
                  {titolo}
                </h3>
                {sottotitolo && <p class="mt-1.5 text-sm text-testo-secondario">{sottotitolo}</p>}
                <span class="mt-auto inline-flex items-center gap-1 pt-4 text-sm font-semibold text-primario-link">
                  {c.data.ctaTesto}
                  <Icona
                    nome="freccia-destra"
                    class="size-4 shrink-0 transition-transform duration-300 group-hover:translate-x-1"
                  />
                </span>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </Sezione>
  <Sezione compatta>
    <CtaDoppia posizione="magazine" />
  </Sezione>
</PaginaLayout>

<style>
  /* Cartoline: francobollo e filo nel colore del logo assegnato alla voce (--q, a rotazione). */
  .francobollo {
    background: color-mix(in oklab, var(--q, var(--q-verde)) 88%, #fff);
    color: #fff;
    outline: 2px dashed rgb(255 255 255 / 0.75);
    outline-offset: -5px;
    box-shadow: 0 10px 24px -10px rgb(5 38 43 / 0.55);
    transform: rotate(4deg);
    transition: transform 0.4s;
  }
  .cartolina:hover .francobollo {
    transform: rotate(-3deg) scale(1.06);
  }
  .cartolina-filo {
    background: linear-gradient(
      90deg,
      var(--q, var(--q-verde)),
      color-mix(in oklab, var(--q, var(--q-verde)) 35%, transparent)
    );
  }
  .cartoline {
    scrollbar-width: none;
  }
  .cartoline::-webkit-scrollbar {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .francobollo {
      transition: none;
    }
  }
</style>
