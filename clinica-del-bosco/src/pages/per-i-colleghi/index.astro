---
/** /per-i-colleghi — area referral B2B, pagina leggera: posizionamento e percorso del caso. Indicizzabile per "TC veterinaria Napoli", "service diagnostico veterinario Campania". */
import PaginaLayout from '@layouts/PaginaLayout.astro';
import Bottone from '@ui/Bottone.astro';
import Icona from '@ui/Icona.astro';
import Etichetta from '@ui/Etichetta.astro';
import Sezione from '@ui/Sezione.astro';
import FormColleghi from '@/components/form/FormColleghi.astro';
import { clinica, emailPrincipale, telHref } from '@lib/clinica';
import { medicalWebPage } from '@lib/schema';

const descrizione =
  'Supporto ai veterinari in Campania, anche in urgenza: TC, endoscopia, chirurgia e degenza a Portici. Contatto diretto col referente, il paziente torna sempre al collega.';
const percorso = [
  [
    'Invio',
    'Modulo online, scheda PDF via email o telefono per le urgenze, con il quesito clinico e gli esami già fatti.',
  ],
  ['Presa in carico', 'Ti ricontattiamo con la data proposta e il nome del referente.'],
  [
    'Esecuzione',
    'Il referente esegue la prestazione richiesta. Se emerge altro, ti chiama prima di procedere.',
  ],
  ['Referto', 'Anticipazione verbale al termine, poi referto scritto.'],
  [
    'Rientro',
    'Il paziente torna da te con relazione e indicazioni. I controlli li decidi tu, in sede o da noi.',
  ],
];
const limiti = [
  'Nessuna risonanza magnetica in sede: per i casi che la richiedono indichiamo un centro attrezzato e teniamo il coordinamento con te.',
  "Le sedute di endoscopia programmata seguono un calendario: i corpi estranei e le urgenze passano dal pronto soccorso h24 e dall'équipe chirurgica.",
  'I veterinari che collaborano con la clinica sono presenti su appuntamento: per una visita specialistica non urgente conta la prima data utile.',
];
const briciole = [{ nome: 'Per i colleghi', href: '/per-i-colleghi' }];
---

<PaginaLayout
  titolo="Per i colleghi veterinari: TC, endoscopia, chirurgia e degenza in service a Portici (Napoli)"
  descrizione={descrizione}
  percorso="/per-i-colleghi"
  h1="Diagnostica avanzata e chirurgia in service per i colleghi del territorio"
  sottotitolo="TC, endoscopia, chirurgia e degenza a Portici. Siamo a disposizione del collega, anche in urgenza, con un contatto diretto con il medico referente."
  etichetta="Area colleghi veterinari"
  tonoIntestazione="inverso"
  briciole={briciole}
  jsonLd={[
    medicalWebPage({
      url: '/per-i-colleghi',
      titolo: 'Service diagnostico e chirurgico per veterinari',
      descrizione,
      briciole,
      specialita: 'Radiography',
    }),
  ]}
>
  <Sezione>
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <p class="font-display text-3xl font-semibold leading-tight md:text-5xl">
          Il paziente torna <em class="not-italic text-primario-link">sempre</em> al collega
          inviante.
        </p>
        <p class="mt-6 text-lg text-testo-secondario">
          La Clinica Veterinaria del bosco mette a disposizione degli ambulatori dell'area vesuviana
          e napoletana ciò che raramente è sostenibile in una struttura diurna: TC in sede,
          endoscopia, due sale chirurgiche, degenza con terapia intensiva. Siamo un supporto per il
          collega, anche nelle urgenze. Eroghiamo la prestazione richiesta, refertiamo e restituiamo
          il caso. Il rapporto con il proprietario resta tuo.
        </p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {[
            "Anticipazione verbale al termine dell'esame",
            'Medico referente raggiungibile direttamente',
            'Supporto anche in urgenza',
            'Accettazione in degenza h24',
          ].map((t) => (
            <li class="flex items-start gap-2">
              <Icona nome="check" class="mt-1 size-5 shrink-0 text-successo" />
              <span>{t}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-5">
        <div class="rounded-card border border-bordo bg-sfondo-rialzato p-6">
          <h2 class="font-sans text-xl font-bold">Invia un caso: tre modi</h2>
          <ol class="mt-3 list-decimal space-y-2 pl-5">
            <li>
              <strong>Online</strong>: modulo in fondo alla pagina.
            </li>
            <li>
              <strong>Email</strong>: scheda invio caso in PDF compilata.
            </li>
            <li>
              <strong>Telefono</strong>, per le urgenze: chiedi del medico di turno.
            </li>
          </ol>
          <p class="mt-2 text-sm text-testo-secondario">
            In ogni caso ti ricontattiamo con la data proposta e il nome del referente.
          </p>
          <div class="mt-5 flex flex-col gap-3">
            <Bottone href="#invia-caso" variante="primario" dimensione="lg" icona="freccia-destra">
              Vai al modulo
            </Bottone>
            <Bottone
              href="/documenti/richiesta-convenzione-clinica-del-bosco.pdf"
              variante="secondario"
              icona="download"
              download
            >
              Modulo richiesta convenzione (PDF)
            </Bottone>
          </div>
          <p class="mt-4 text-sm text-testo-secondario">
            Urgenze: chiama il{' '}
            <a href={telHref} class="font-semibold">
              {clinica.contatti.telefono.visualizzato}
            </a>{' '}
            e chiedi del medico di turno.
          </p>
        </div>
      </div>
    </div>
  </Sezione>

  <Sezione id="percorso">
    <Etichetta class="mb-3">Il percorso del caso</Etichetta>
    <h2 class="text-3xl md:text-4xl">Dall'invio al rientro, in cinque passaggi</h2>
    <ol class="mt-8 grid gap-4 md:grid-cols-5">
      {percorso.map(([t, d], i) => (
        <li class="rounded-card border border-bordo bg-sfondo-rialzato p-5">
          <span class="inline-flex size-8 items-center justify-center rounded-full bg-primario font-sans text-sm font-bold text-testo-inverso">
            {i + 1}
          </span>
          <h3 class="mt-3 font-sans text-lg font-bold">{t}</h3>
          <p class="mt-1 text-sm text-testo-secondario">{d}</p>
        </li>
      ))}
    </ol>
    <div class="mt-10 rounded-card border border-bordo bg-sfondo-rialzato p-6">
      <h3 class="font-sans text-xl font-bold">Quello che è giusto sapere prima di inviare</h3>
      <ul class="mt-3 space-y-2 text-sm">
        {limiti.map((l) => (
          <li class="flex items-start gap-2">
            <Icona nome="info" class="mt-0.5 size-4 shrink-0 text-primario-link" />
            <span>{l}</span>
          </li>
        ))}
      </ul>
    </div>
  </Sezione>

  <Sezione tono="tinta" id="invia-caso">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <Etichetta class="mb-3">Invio caso</Etichetta>
        <h2 class="text-3xl">Invia un caso</h2>
        <p class="mt-3 text-testo-secondario">
          Quesito clinico e anamnesi essenziale. Ti ricontattiamo con la data proposta e il nome del
          referente; per le urgenze chiama la clinica.
        </p>
        <p class="mt-4 text-sm text-testo-secondario">
          Contatto diretto:{' '}
          <a href={telHref} class="font-semibold">
            {clinica.contatti.telefono.visualizzato}
          </a>{' '}
          · <a href={`mailto:${emailPrincipale}`}>{emailPrincipale}</a>
        </p>
      </div>
      <div class="lg:col-span-8">
        <FormColleghi />
      </div>
    </div>
  </Sezione>
</PaginaLayout>
