---
import PaginaLayout from '@layouts/PaginaLayout.astro';
import Bottone from '@ui/Bottone.astro';
import Dato from '@ui/Dato.astro';
import Foto from '@ui/Foto.astro';
import Icona from '@ui/Icona.astro';
import Sezione from '@ui/Sezione.astro';
import BadgeApertoOra from '@sezioni/BadgeApertoOra.astro';
import {
  clinica,
  daConfermare,
  emailPrincipale,
  indicazioniAppleHref,
  indicazioniHref,
  indirizzoRiga,
  telHref,
} from '@lib/clinica';
import { orariLeggibili } from '@lib/orari';
import { faqPage, webPage } from '@lib/schema';
import Faq from '@ui/Faq.astro';

const orari = clinica.orari.ambulatorio.confermato
  ? orariLeggibili(clinica.orari.ambulatorio.settimana)
  : null;
const descrizione = `${clinica.nome}, Corso Umberto I 12, Portici (NA). Telefono ${clinica.contatti.telefono.visualizzato}. Orari delle visite, parcheggio e treni.`;
const faq = [
  {
    domanda: 'Il telefono risponde anche di notte?',
    risposta: `Sì. Il numero ${clinica.contatti.telefono.visualizzato} è attivo 24 ore su 24, tutti i giorni. È lo stesso numero per le urgenze e per prenotare.`,
  },
  {
    domanda: 'Posso prenotare una visita per email?',
    risposta: `Per prenotare usa il modulo online o il telefono: ti contattiamo per confermare giorno e ora. Per un'urgenza non scrivere un'email, chiama.`,
  },
  {
    domanda: "Dove parcheggio se arrivo per un'urgenza?",
    risposta:
      "Davanti alla clinica c'è un posto riservato alle soste brevi delle urgenze. Se è occupato, ci sono parcheggi a strisce blu e un garage privato nelle vicinanze.",
  },
];
---

<PaginaLayout
  titolo="Contatti e orari"
  descrizione={descrizione}
  percorso="/contatti"
  h1="Contatti, orari e come arrivare"
  sottotitolo={`La ${clinica.nome} è in ${indirizzoRiga}, vicino a piazza San Ciro. Telefono ${clinica.contatti.telefono.visualizzato}.`}
  etichetta="Contatti"
  briciole={[{ nome: 'Contatti', href: '/contatti' }]}
  jsonLd={[
    webPage({
      url: '/contatti',
      titolo: 'Contatti e come arrivare',
      descrizione,
      tipo: 'ContactPage',
    }),
    faqPage(faq),
  ]}
>
  <Sezione>
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <BadgeApertoOra variante="estesa" class="mb-6" />
        <address class="not-italic">
          <dl class="space-y-5">
            <div>
              <dt class="text-xs font-bold uppercase tracking-wider text-testo-secondario">
                Telefono (urgenze e prenotazioni)
              </dt>
              <dd class="mt-1">
                <a
                  href={telHref}
                  class="font-display text-3xl font-bold no-underline hover:underline"
                  data-evento="click_chiama"
                  data-evento-posizione="contatti"
                >
                  {clinica.contatti.telefono.visualizzato}
                </a>
              </dd>
            </div>
            <div>
              <dt class="text-xs font-bold uppercase tracking-wider text-testo-secondario">
                Email (non per le urgenze)
              </dt>
              <dd class="mt-1">
                <a href={`mailto:${emailPrincipale}`} class="text-lg">
                  {emailPrincipale}
                </a>
              </dd>
            </div>
            <div>
              <dt class="text-xs font-bold uppercase tracking-wider text-testo-secondario">
                Indirizzo
              </dt>
              <dd class="mt-1 text-lg">{indirizzoRiga}</dd>
              {!daConfermare(clinica.indirizzo.riferimenti) && (
                <dd class="text-testo-secondario">{clinica.indirizzo.riferimenti}</dd>
              )}
            </div>
            <div>
              <dt class="text-xs font-bold uppercase tracking-wider text-testo-secondario">
                Parcheggio
              </dt>
              <dd class="mt-1">
                <Dato valore={clinica.indirizzo.parcheggio} />
              </dd>
            </div>
          </dl>
        </address>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <Bottone
            href={indicazioniHref}
            variante="primario"
            icona="mappa"
            target="_blank"
            rel="noopener"
            evento="click_indicazioni"
            eventoPosizione="contatti"
          >
            Google Maps
          </Bottone>
          <Bottone
            href={indicazioniAppleHref}
            variante="secondario"
            icona="mappa"
            target="_blank"
            rel="noopener"
            evento="click_indicazioni"
            eventoPosizione="contatti-apple"
          >
            Apple Maps
          </Bottone>
          <Bottone href="/prenota" variante="fantasma" icona="calendario">
            Prenota online
          </Bottone>
        </div>
        <h2 class="mt-10 text-2xl">Orari</h2>
        <p class="mt-2 flex items-center gap-2 font-semibold">
          <Icona nome="ambulanza" class="size-5 text-successo" />
          {clinica.orari.prontoSoccorso.etichetta}
        </p>
        {orari ? (
          <table class="mt-3 text-sm">
            <caption class="pb-2 text-left font-semibold">Visite su appuntamento</caption>
            <tbody>
              {orari.map((r) => (
                <tr>
                  <th scope="row" class="pr-6 font-medium capitalize">
                    {r.giorno}
                  </th>
                  <td>{r.fasce}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p class="mt-2 text-testo-secondario">
            Visite programmate su appuntamento: chiama o prenota online, ti proponiamo la prima
            disponibilità nella fascia che preferisci.
          </p>
        )}
        <h2 class="mt-10 text-2xl">Come arrivare</h2>
        <h3 class="mt-4 font-sans text-lg font-bold">In auto</h3>
        <p class="mt-1">
          Autostrada A3 Napoli-Salerno, uscita Portici-Ercolano, poi indicazioni per il centro di
          Portici. La clinica è in Corso Umberto I, a pochi minuti dallo svincolo.
        </p>
        <h3 class="mt-4 font-sans text-lg font-bold">In treno</h3>
        <ul class="mt-1 list-disc pl-5">
          <li>
            Circumvesuviana, linea Napoli-Sorrento: fermate Portici Via Libertà e Portici
            Bellavista.
          </li>
          <li>Ferrovie dello Stato: stazione Portici-Ercolano.</li>
        </ul>
      </div>
      <div class="lg:col-span-6">
        <a
          href={indicazioniHref}
          target="_blank"
          rel="noopener"
          aria-label="Apri le indicazioni stradali in una nuova scheda"
        >
          <Foto
            ratio="4/3"
            scattoBrief="32"
            descrizioneSegnaposto="Mappa statica con la posizione della clinica"
          />
        </a>
        <Foto
          ratio="16/9"
          scattoBrief="33"
          descrizioneSegnaposto="Facciata e ingresso della clinica di giorno, con riferimenti visivi per riconoscerla"
          class="mt-4"
        />
      </div>
    </div>
  </Sezione>
  <Sezione compatta>
    <Faq voci={faq} />
  </Sezione>
</PaginaLayout>
