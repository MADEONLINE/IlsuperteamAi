---
/** Pagina di ringraziamento: cosa succede adesso, tempi dichiarati. noindex. */
import PaginaLayout from '@layouts/PaginaLayout.astro';
import Bottone from '@ui/Bottone.astro';
import Sezione from '@ui/Sezione.astro';
import { clinica, telHref } from '@lib/clinica';
---

<PaginaLayout
  titolo="Richiesta ricevuta"
  descrizione="Abbiamo ricevuto la tua richiesta di appuntamento: ti richiamiamo per confermare giorno e ora."
  percorso="/prenota/grazie"
  noindex
  h1="Richiesta ricevuta, grazie."
  sottotitolo="Ti contattiamo al numero che hai indicato per confermare giorno e ora."
  etichetta="Prenotazione"
  briciole={[
    { nome: 'Prenota', href: '/prenota' },
    { nome: 'Richiesta ricevuta', href: '/prenota/grazie' },
  ]}
>
  <Sezione>
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="text-2xl">Cosa succede adesso</h2>
        <ol class="mt-4 space-y-4">
          {[
            [
              'La reception legge la richiesta',
              'Nei giorni feriali di solito entro poche ore; nel fine settimana entro il primo giorno utile.',
            ],
            [
              'Ti chiamiamo per confermare',
              `Al telefono concordiamo giorno e ora nella fascia che hai scelto. Se non rispondi, riproviamo e ti lasciamo un messaggio.`,
            ],
            [
              'Ricevi le istruzioni',
              'Digiuno se sono previsti esami o anestesia, cosa portare (libretto, referti, farmaci), come arrivare.',
            ],
          ].map(([t, d], i) => (
            <li class="flex gap-4">
              <span
                class="flex size-9 shrink-0 items-center justify-center rounded-full bg-primario-tenue font-bold text-primario-link"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <div>
                <p class="font-semibold">{t}</p>
                <p class="text-testo-secondario">{d}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="mt-8 rounded-card bg-urgenza-tenue p-4 text-sm">
          <strong class="text-urgenza-testo-su-chiaro">
            Se nel frattempo la situazione peggiora
          </strong>
          , non aspettare la nostra chiamata: il pronto soccorso è attivo 24 ore su 24 al{' '}
          <a href={telHref} class="font-semibold">
            {clinica.contatti.telefono.visualizzato}
          </a>
          .
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Bottone href="/" variante="secondario" dimensione="md">
            Torna alla home
          </Bottone>
          <Bottone
            href="/prima-visita"
            variante="fantasma"
            dimensione="md"
            iconaDopo="freccia-destra"
          >
            Cosa portare alla visita
          </Bottone>
        </div>
      </div>
    </div>
  </Sezione>
</PaginaLayout>
