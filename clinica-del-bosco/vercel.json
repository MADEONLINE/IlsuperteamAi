{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.clinicaveterinariadelbosco.it" }],
      "destination": "https://clinicaveterinariadelbosco.it/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "migliorveterinarionapoli.it" }],
      "destination": "https://clinicaveterinariadelbosco.it/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.migliorveterinarionapoli.it" }],
      "destination": "https://clinicaveterinariadelbosco.it/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "clinicadelbosco.com" }],
      "destination": "https://clinicaveterinariadelbosco.it/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.clinicadelbosco.com" }],
      "destination": "https://clinicaveterinariadelbosco.it/:path*",
      "permanent": true
    },
    { "source": "/chi-siamo", "destination": "/la-struttura", "permanent": true },
    {
      "source": "/centro-tac-e-animali-esotici",
      "destination": "/servizi/tac-diagnostica-avanzata",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/index.php", "destination": "/", "permanent": true },
    {
      "source": "/pronto-soccorso-veterinario",
      "destination": "/pronto-soccorso",
      "permanent": true
    },
    { "source": "/urgenze", "destination": "/pronto-soccorso", "permanent": true },
    { "source": "/emergenze", "destination": "/pronto-soccorso", "permanent": true },
    { "source": "/prenotazione", "destination": "/prenota", "permanent": true },
    { "source": "/prenotazioni", "destination": "/prenota", "permanent": true },
    { "source": "/piani", "destination": "/piani-salute", "permanent": true },
    { "source": "/abbonamenti", "destination": "/piani-salute", "permanent": true },
    { "source": "/tac", "destination": "/servizi/tac-diagnostica-avanzata", "permanent": true },
    {
      "source": "/esotici",
      "destination": "/servizi/animali-esotici-e-conigli",
      "permanent": true
    },
    { "source": "/colleghi", "destination": "/per-i-colleghi", "permanent": true },
    { "source": "/referral", "destination": "/per-i-colleghi", "permanent": true },
    { "source": "/blog", "destination": "/magazine", "permanent": true },
    { "source": "/blog/:slug*", "destination": "/magazine/:slug*", "permanent": true },
    { "source": "/faq", "destination": "/domande-frequenti", "permanent": true },
    { "source": "/team", "destination": "/equipe", "permanent": true },
    { "source": "/staff", "destination": "/equipe", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/llms(-full)?\\.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
