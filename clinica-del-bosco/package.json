{
  "name": "clinica-veterinaria-del-bosco",
  "version": "0.1.0",
  "private": true,
  "description": "Sito web della Clinica Veterinaria del Bosco — Portici (NA). Astro 5 + Tailwind CSS 4, output statico.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-data.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check:data": "node scripts/check-data.mjs",
    "check:contrasti": "node scripts/check-contrasti.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0"
  }
}
